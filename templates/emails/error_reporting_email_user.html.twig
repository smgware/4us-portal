<!doctype html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <title>Hibabejelentés rögzítve</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,sans-serif;color:#111827;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f6f8;padding:24px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="640" cellspacing="0" cellpadding="0" style="max-width:640px;width:100%;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;">
                    <tr>
                        <td style="padding:22px 24px;border-bottom:1px solid #e5e7eb;">
                            <h1 style="margin:0;font-size:22px;color:#111827;">Hibabejelentés</h1>
                            <p style="margin:8px 0 0;color:#64748b;">A hibabejelentését az alábbi adatokkal rögzítettük.</p>
                        </td>
                        <td align="right" style="padding:16px 24px;border-bottom:1px solid #e5e7eb;">
                            <img src="cid:4us-logo-mail" width="150" alt="4US Group" style="display:block;width:150px;max-width:100%;height:auto;border:0;">
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="padding:20px 24px;">
                            <p style="margin:0 0 16px;">
                                <strong>Hibajegy kódja:</strong>
                                <span style="font-size:18px;">{{ code }}</span>
                            </p>

                            <h2 style="margin:0 0 10px;font-size:16px;">Megadott adatok</h2>
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                                {% for key, value in data %}
                                    {% if key != 'attachments' and value is not iterable %}
                                        <tr>
                                            <td style="width:220px;padding:8px;border-top:1px solid #e5e7eb;color:#475569;">{{ fieldLabels[key]|default(key) }}</td>
                                            <td style="padding:8px;border-top:1px solid #e5e7eb;">{{ value }}</td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </table>

                            {% if attachments|length > 0 %}
                                <h2 style="margin:20px 0 10px;font-size:16px;">Csatolmányok</h2>
                                <ul style="margin:0;padding-left:20px;">
                                    {% for attachment in attachments %}
                                        <li>{{ attachment.originalName }} ({{ (attachment.size / 1024)|number_format(1, '.', ' ') }} KB)</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
