<div class="table-responsive w-100 overflow-auto">
    <table class="table-default w-100">
        <thead>
            <tr class="pt-2 pb-2">
                <th class="p-2">Kép</th>
                <th class="p-2">Név</th>
                <th class="p-2">Felhasználónév</th>
                <th class="p-2">Email</th>
                <th class="p-2">Telefon</th>
                <th class="p-2">Jogosultság</th>
                <th class="p-2">Státusz</th>
                <th class="p-2">#</th>
            </tr>
        </thead>
        <tbody>
            {% for record in records %}
                <tr data-name="list_item" data-key="{{ record.id }}">
                    <td>
                        {% if record.image %}
                            <img src="{{ record.image }}" alt="" style="width:40px;height:40px;object-fit:cover;border-radius:50%;">
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td>{{ record.name }}</td>
                    <td>{{ record.username }}</td>
                    <td>{{ record.email }}</td>
                    <td>{{ record.phone|default('-') }}</td>
                    <td>
                        {% if record.permission_id %}
                            {{ record.permission_title|default('-') }} ({{ record.permission_code|default(record.permission_id) }})
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td>{{ (record.status == 1 ? '<div class="btn btn-sm btn-success">aktív</div>' : '<div class="btn btn-sm btn-danger">inaktív</div>')|raw }}</td>
                    <td>
                        <div class="btn btn-default btn-sm" data-name="list_item_btn" data-mode="edit"><i class="bi bi-pencil-square"></i></div>
                        <div class="btn btn-default btn-sm" data-name="list_item_btn" data-mode="password"><i class="bi bi-key"></i></div>
                        <!-- <div class="btn btn-default btn-sm text-danger" data-name="list_item_btn" data-mode="delete"><i class="bi bi-trash"></i></div> -->
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center py-4">Nincs megjeleníthető adat.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% include 'partials/_pagination.html.twig' with {
    currentPage: page,
    totalPages: totalPages,
    routeName: 'list_users',
    queryParams: app.request.query.all
} %}
