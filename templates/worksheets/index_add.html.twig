<script>
    //LOAD MAIN
    var data_all = null;
    var formData = new FormData();

    var saveWorksheetData = function(){ };
    var uploadWorksheetAttachments = function(){};

    formData.append('id', '{{ id ? id : ''}}');
    new Ajax({
        url: '{{ path('index_worksheet_add_main') }}',
        name: 'index_worksheet_add_main',
        type: 'POST',
        dataType: 'json',
        formData: formData,
        target: null,
        function_success: function (result) {
            if (result.success) {
                 data_all = result.data ?? {};
                 data_all.worksheet = data_all.worksheet ?? {};
                 data_all.attachments = data_all.attachments ?? [];
                 data_all.contacts = Array.isArray(data_all.contacts)
                     ? data_all.contacts
                     : (Array.isArray(data_all.worksheet?.data?.contacts) ? data_all.worksheet.data.contacts : []);


                 var html_footer = `
                            <div class="container-fluid p-0" data-box="worksheet_add">
                                <div class="row">
                                    <div class="col-12 text-end">
                                        <div class="btn btn-default btn-sm btn-success" data-name="alertify-next" style="display:none">Tovább</div>
                                        <div class="btn btn-default btn-sm btn-success" data-name="alertify-save" style="display:none"><i class="bi bi-floppy2-fill"></i> Mentés</div>
                                        <div class="btn btn-default btn-sm btn-secondary" data-name="alertify-cancel"><i class="bi bi-x-circle"></i> Bezárás</div>
                                    </div>
                                </div>
                            </div>
                    `;

                    alertify.sheet(`Munkalap <span data-name="worksheet_code"></span>`, `<div class="container-fluid p-0"><div class="row"><div class="col-12" data-name="index_worksheet_add_main"></div></div></div>`)
                        .set("movable", false)
                        .set("resizable", false)
                        .set("closable", false)
                        .set('closableByEscape', false)
                        .maximize()
                        .set({transition: 'zoom'})
                        .setFooter(html_footer);

                    if(data_all?.options?.save_enabled){
                        $("[data-box='worksheet_add'] [data-name='alertify-save']").fadeIn(100);
                    }

                    $(".ajs-header").append(`<div class="btn position-absolute" data-name="alertify-cancel" style="top:10px;right:10px;"><i class="bi bi-x-circle"></i></div>`);


                    $(`.ajs-header .btn[data-name='alertify-cancel']`).unbind("click").click(function () {
                        $(`div[data-box="worksheet_add"] .btn[data-name='alertify-cancel']`).trigger("click");
                    });


                    $(`div[data-box="worksheet_add"] .btn[data-name='alertify-cancel']`).unbind("click").click(function () {
                        alertify.confirm("Megerősítés", "Mented az adatokat?", () => {
                         alertify.sheet().close();
                        }, () => {});
                    });

                    $(`div[data-box="worksheet_add"] .btn[data-name='alertify-save']`).unbind("click").click(function () {
                        alertify.confirm("Megerősítés", "Mented az adatokat?", () => {

                            if (typeof saveWorksheetData === "function") {
                                saveWorksheetData();
                            }
                        }, () => {});
                    });

                    $("[data-name='index_worksheet_add_main']").html(result.content);



            }else{
                if(result.data?.error === "notfound"){
                    alertify.alert("Hiba", "A bejegyzés nem található!");
                }
            }

        },
        function_error: function (xhr) {
            alertify.error(xhr.responseJSON?.data?.error || 'Nem sikerült betölteni a munkalapokat.');
        }
    }).send();

    //save worksheet

</script>
