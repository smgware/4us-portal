{% set code = statusCode|default('') %}
{% set title = statusTitle|default(code ?: '-') %}

{% if code in ['CLOSED', 'RETURNED', 'REPAIRED_ISSUED'] %}
    <span class="badge text-bg-secondary">{{ title }}</span>
{% elseif code == 'UNDER_REPAIR' %}
    <span class="badge text-bg-warning">{{ title }}</span>
{% else %}
    <span class="badge text-bg-success">{{ title }}</span>
{% endif %}
