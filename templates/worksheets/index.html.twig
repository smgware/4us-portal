{% extends 'base.html.twig' %}

{% block body %}
    <div class="page-title"><i class="bi bi-clipboard-check"></i> Munkalapok</div>

    <div class="container-fluid p-0 mt-3">
        <div class="card panel-card p-3">
            <div class="row">
                {% for shortcut in worksheetTypeShortcuts %}
                    {% if not is_granted('ROLE_SERVICE') or shortcut.code == 'ERROR_REPORT' %}
                    <div class="col-xl col-lg-4 col-md-6 col-12 mb-2 mb-xl-0">
                        <button
                            type="button"
                            class="btn btn-default w-100 h-100 position-relative text-start worksheet-type-shortcut"
                            data-name="worksheet-type-shortcut"
                            data-worksheet-type-id="{{ shortcut.id }}"
                        >
                            <i class="bi {{ shortcut.icon }} me-2" aria-hidden="true"></i>{{ shortcut.title }}
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" title="Új / nyitott munkalapok">
                                {{ shortcut.count }}
                                <span class="visually-hidden">új vagy nyitott munkalap</span>
                            </span>
                        </button>
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="container-fluid p-0 mt-3">
        <div class="card panel-card p-3">
            <div class="row g-2 align-items-end">
                <div class="col-xl-5 col-md-6 col-12">
                    <label class="text-xs" for="worksheet_list_search">Keresés</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="worksheet_list_search" data-name="search_worksheets_list" placeholder="Kód, cím, partner...">
                        <button type="button" class="btn btn-default" data-name="btnSearchWorksheets" title="Keresés">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-xl-3 col-md-3 col-6">
                    <label class="text-xs" for="worksheet_list_type">Típus</label>
                    <select class="form-control" id="worksheet_list_type" data-name="filter_worksheets_type">
                        <option value="">Minden típus</option>
                        {% for worksheetType in worksheetTypes %}
                            <option value="{{ worksheetType.id }}">{{ worksheetType.title }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-xl-2 col-md-3 col-6">
                    <label class="text-xs" for="worksheet_list_status">Státusz</label>
                    <select class="form-control" id="worksheet_list_status" data-name="filter_worksheets_status">
                        <option value="">Minden státusz</option>
                        {% for worksheetStatusFilter in worksheetStatusFilters %}
                            <option value="{{ worksheetStatusFilter.code }}" data-worksheet-types="{{ worksheetStatusFilter.worksheet_type_ids|join(',') }}">
                                {{ worksheetStatusFilter.title }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-xl-2 col-12 text-end">
                    <button type="button" class="btn btn-default btn-sm" data-name="btnWorksheetsAdd">
                        <i class="bi bi-plus-circle-fill"></i> Új hozzáadása
                    </button>
                </div>
            </div>
        </div>

        <div class="card panel-card p-2 mt-2">
            <div class="row">
                <div class="col-12" data-name="ajax-content" data-key="list_worksheets_list"></div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            const listUrl = {{ path('list_worksheets_list')|json_encode|raw }};
            const listFormData = new FormData();
            listFormData.set('filters', '{}');
            listFormData.set('page', '1');

            const listRequest = new Ajax({
                url: listUrl,
                name: 'list_worksheets_list',
                type: 'POST',
                dataType: 'json',
                formData: listFormData,
                target: $('[data-key="list_worksheets_list"]'),
                function_prepare: function () {
                    this.target.html('<div class="p-3 text-xs text-muted-custom"><span class="spinner-border spinner-border-sm me-1"></span> Betöltés...</div>');
                },
                function_success: function (result) {
                    if (!result.success) {
                        alertify.error(result.data?.error || 'Nem sikerült betölteni a munkalapokat.');
                        return;
                    }

                    this.target.html(result.content);
                    bindWorksheetRows();
                },
                function_error: function (xhr) {
                    alertify.error(xhr.responseJSON?.data?.error || 'Nem sikerült betölteni a munkalapokat.');
                }
            });

            const editorRequest = new Ajax({
                url: {{ path('index_worksheets_add')|json_encode|raw }},
                name: 'index_worksheets_add',
                type: 'POST',
                dataType: 'json',
                formData: new FormData(),
                target: null,
                function_success: function (result) {
                    if (!result.success) {
                        alertify.error(result.data?.error || 'Nem sikerült betölteni a munkalapot.');
                        return;
                    }

                    $('#worksheet_add_content').remove();
                    $('<div>', {
                        id: 'worksheet_add_content',
                        html: result.content
                    }).appendTo('body');
                },
                function_error: function (xhr) {
                    const error = xhr.responseJSON?.data?.error;
                    alertify.error(error === 'notfound' ? 'A munkalap nem található.' : (error || 'Nem sikerült betölteni a munkalapot.'));
                }
            });

            function openWorksheet(id) {
                editorRequest.formData = new FormData();
                if (id) {
                    editorRequest.formData.set('worksheet_id', String(id));
                }
                editorRequest.send();
            }

            function bindWorksheetRows() {
                $('[data-key="list_worksheets_list"] [data-name="list_item_btn"]')
                    .off('click.worksheets')
                    .on('click.worksheets', function () {
                        const button = $(this);
                        const id = button.closest('[data-name="list_item"]').attr('data-key');
                        if (button.attr('data-mode') === 'print') {
                            const url = button.attr('data-url');
                            window.open(url, '_blank');
                            return;
                        }

                        openWorksheet(id);
                    });
            }

            function updateStatusFilter() {
                const typeId = String($('[data-name="filter_worksheets_type"]').val() || '');
                const status = $('[data-name="filter_worksheets_status"]');
                const selectedOption = status.find('option:selected');

                status.find('option').each(function () {
                    const optionTypeIds = String($(this).attr('data-worksheet-types') || '')
                        .split(',')
                        .filter(Boolean);
                    const visible = String($(this).val() || '') === '' || typeId === '' || optionTypeIds.includes(typeId);
                    $(this).prop('disabled', !visible).prop('hidden', !visible);
                });

                if (selectedOption.prop('disabled')) {
                    status.val('');
                }
            }

            function applyFilters() {
                const filters = {
                    search: String($('[data-name="search_worksheets_list"]').val() || '').trim(),
                    worksheet_type_id: $('[data-name="filter_worksheets_type"]').val() || '',
                    worksheet_status_type_code: $('[data-name="filter_worksheets_status"]').val() || ''
                };
                listRequest.url = listUrl;
                listRequest.formData.set('filters', JSON.stringify(filters));
                listRequest.formData.set('page', '1');
                listRequest.send();
            }

            $('[data-name="btnWorksheetsAdd"]')
                .off('click.worksheets')
                .on('click.worksheets', function () { openWorksheet(null); });
            $('[data-name="worksheet-type-shortcut"]')
                .off('click.worksheets')
                .on('click.worksheets', function () {
                    const typeId = String($(this).attr('data-worksheet-type-id') || '');
                    $('[data-name="filter_worksheets_type"]').val(typeId);
                    updateStatusFilter();
                    applyFilters();
                });
            $('[data-name="btnSearchWorksheets"]')
                .off('click.worksheets')
                .on('click.worksheets', applyFilters);
            $('[data-name="search_worksheets_list"]')
                .off('keydown.worksheets')
                .on('keydown.worksheets', function (event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        applyFilters();
                    }
                });
            $('[data-name="filter_worksheets_type"]')
                .off('change.worksheets')
                .on('change.worksheets', function () {
                    updateStatusFilter();
                    applyFilters();
                });
            $('[data-name="filter_worksheets_status"]')
                .off('change.worksheets')
                .on('change.worksheets', applyFilters);

            updateStatusFilter();
            listRequest.send();
        });
    </script>
{% endblock %}
