<!doctype html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <style>
        @page { size: A4 portrait; margin: 7mm 10mm 8mm; }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            color: #30343b;
            font-family: "DejaVu Sans", sans-serif;
            font-size: 9pt;
            line-height: 1.25;
        }
        table { width: 100%; border-collapse: collapse; }
        .topbar {
            background: #a5d34c;
            margin: -7mm -10mm 5mm;
            width: 210mm;
        }
        .topbar td { height: 22mm; vertical-align: middle; }
        .topbar-logo { width: 31%; padding-left: 13mm; }
        .topbar-logo img { width: 34mm; height: auto; }
        .topbar-title {
            width: 42%;
            color: #2d333b;
            font-size: 15pt;
            font-weight: bold;
            text-align: center;
        }
        .topbar-code { width: 27%; padding-right: 5mm; text-align: right; }
        .code-box {
            display: inline-block;
            min-width: 41mm;
            padding: 2mm 3mm;
            background: #fff;
            color: #141414;
            font-size: 10.5pt;
            text-align: center;
            white-space: nowrap;
        }
        .section { margin-top: 3.5mm; page-break-inside: avoid; }
        .section-label {
            display: inline-block;
            min-width: 43mm;
            margin-left: -10mm;
            padding: 1.3mm 5mm 1.3mm 14mm;
            color: #2d333b;
            background: #a5d34c;
            font-size: 10pt;
            font-weight: bold;
        }
        .details { margin-top: 1.5mm; }
        .details td { padding: 1.2mm 1.5mm; vertical-align: bottom; }
        .details .field-label { white-space: nowrap; }
        .field-value {
            display: inline-block;
            min-width: 35mm;
            padding: 0 1mm .6mm;
            border-bottom: 1px solid #a0a0a0;
            color: #30343b;
        }
        .machine-section { margin-top: 4mm; }
        .machine-layout td { vertical-align: bottom; }
        .machine-label-cell { width: 15%; }
        .machine-data-cell { width: 85%; }
        .machine-table th {
            padding: 1mm .8mm;
            font-size: 8.1pt;
            text-align: center;
            white-space: nowrap;
        }
        .machine-table td {
            height: 10mm;
            padding: 1.4mm 1mm;
            border: 1px solid #a5d34c;
            font-size: 7.6pt;
            text-align: center;
            vertical-align: middle;
        }
        .machine-table .type { width: 18%; }
        .machine-table .name { width: 29%; }
        .machine-table .serial { width: 25%; }
        .machine-table .hours { width: 14%; }
        .machine-table .year { width: 14%; }
        .machine-drawing {
            height: 39mm;
            padding: 4mm 0 1mm;
            text-align: center;
        }
        .machine-drawing img { max-width: 100%; max-height: 36mm; }
        .note-section { margin-top: 2mm; page-break-inside: avoid; }
        .note-box {
            min-height: 43mm;
            margin: 2mm 3mm 0;
            padding: 3mm;
            border: 1px solid #21933b;
            white-space: pre-wrap;
        }
        .signatures { margin-top: 7mm; page-break-inside: avoid; }
        .signatures td { width: 50%; padding: 0 10mm; text-align: center; vertical-align: bottom; }
        .date-row { margin-bottom: 5mm; text-align: left; }
        .signature-space { height: 16mm; }
        .signature-image { max-width: 42mm; max-height: 15mm; }
        .signature-line { padding-top: 1.2mm; border-top: 1px dotted #555; }
        .signature-name { font-size: 7.5pt; }
    </style>
</head>
<body>
{% set isReturn = worksheet.worksheetType.code == 'MACHINE_RETURN' %}
{% set documentTitle = isReturn ? 'ÁTVÉTELI JEGYZŐKÖNYV' : 'ÁTADÁSI JEGYZŐKÖNYV' %}
{% set documentCode = worksheetData.machine_rental_code|default(worksheet.code) %}
{% set partnerAddress = partner
    ? ([partner.zip, partner.city, partner.address]|filter(value => value)|join(' '))
    : '-' %}
{% set contactText = partnerContact
    ? ([partnerContact.name, partnerContact.phone]|filter(value => value)|join(' - '))
    : '-' %}
{% set projectName = partnerProject ? partnerProject.name : '-' %}
{% set projectCode = partnerProject ? partnerProject.code : '' %}
{% set note = worksheetData.note|default('') %}

<table class="topbar">
    <tr>
        <td class="topbar-logo"><img src="{{ logoDataUri }}" alt="4US"></td>
        <td class="topbar-title">{{ documentTitle }}</td>
        <td class="topbar-code"><span class="code-box">{{ documentCode }}</span></td>
    </tr>
</table>

<div class="section">
    <div class="section-label">Bérbeadó adatai:</div>
    <table class="details">
        <tr>
            <td><span class="field-label">Név:</span> <span class="field-value" style="min-width: 145mm;">4US Zrt., adószám: 24653633-2-13, székhely: 2724 Újlengyel, Petőfi Sándor utca 48.</span></td>
        </tr>
        <tr>
            <td><span class="field-label">Kapcsolattartó:</span> <span class="field-value" style="min-width: 75mm;">Cservenák Árpád</span></td>
        </tr>
    </table>
</div>

<div class="section">
    <div class="section-label">Bérlő adatai:</div>
    <table class="details">
        <tr>
            <td style="width: 50%;"><span class="field-label">Név:</span> <span class="field-value" style="min-width: 62mm;">{{ partner ? partner.name : '-' }}</span></td>
            <td style="width: 50%;"><span class="field-label">Adószám:</span> <span class="field-value" style="min-width: 50mm;">{{ partner ? partner.taxNumber|default('-') : '-' }}</span></td>
        </tr>
        <tr>
            <td><span class="field-label">Székhely:</span> <span class="field-value" style="min-width: 58mm;">{{ partnerAddress ?: '-' }}</span></td>
            <td><span class="field-label">Kapcsolattartó:</span> <span class="field-value" style="min-width: 42mm;">{{ contactText }}</span></td>
        </tr>
        <tr>
            <td colspan="2"><span class="field-label">Projekt:</span> <span class="field-value" style="min-width: 145mm;">{{ projectName }}{% if projectCode %} ({{ projectCode }}){% endif %}</span></td>
        </tr>
    </table>
</div>

<div class="machine-section">
    <table class="machine-layout">
        <tr>
            <td class="machine-label-cell"><div class="section-label" style="margin-left: -10mm; min-width: 42mm;">Gép adatai:</div></td>
            <td class="machine-data-cell">
                <table class="machine-table">
                    <thead>
                        <tr>
                            <th class="type">Típus</th>
                            <th class="name">Megnevezés</th>
                            <th class="serial">Gyári/belső szám</th>
                            <th class="hours">Üzemóra</th>
                            <th class="year">Évjárat</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="type">{{ machine and machine.machineCategory ? machine.machineCategory.title : '-' }}</td>
                            <td class="name">{{ machine ? machine.title : worksheetData.machine|default('-') }}</td>
                            <td class="serial">{{ machineData.sku|default(machine ? machine.code : worksheetData.machine_code|default('-')) }}</td>
                            <td class="hours">{{ worksheetData.operating_hours|default('-') ?: '-' }}</td>
                            <td class="year">{{ machineData.year|default('-') }}</td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
    <div class="machine-drawing"><img src="{{ machineDrawingDataUri }}" alt="Munkagépek"></div>
</div>

<div class="note-section">
    <div class="section-label">Megjegyzések {{ isReturn ? 'visszavételkor' : 'átadáskor' }}:</div>
    <div class="note-box">{{ note ?: '-' }}</div>
</div>

<table class="signatures">
    <tr>
        <td colspan="2"><div class="date-row">Dátum: <span class="field-value" style="min-width: 38mm; text-align: center;">{{ documentDate|date('Y-m-d') }}</span></div></td>
    </tr>
    <tr>
        <td>
            <div class="signature-space">
                {% if editor and editor.signature %}<img class="signature-image" src="{{ editor.signature }}" alt="Aláírás">{% endif %}
            </div>
            <div class="signature-line">{{ isReturn ? 'Átvevő' : 'Átadó' }}</div>
            {% if editor %}<div class="signature-name">{{ editor.name ?: editor.userName }}</div>{% endif %}
        </td>
        <td>
            <div class="signature-space"></div>
            <div class="signature-line">{{ isReturn ? 'Átadó' : 'Átvevő' }}</div>
            {% if partnerContact %}<div class="signature-name">{{ partnerContact.name }}</div>{% endif %}
        </td>
    </tr>
</table>
</body>
</html>
