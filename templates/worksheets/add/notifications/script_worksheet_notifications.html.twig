<script>
    (() => {

        function listNotificationsContactsListEventListener(){

            $("[data-name='contact-item']").each(function(){
                contactId = $(this).attr("data-id");

                data_all.contacts =  data_all.contacts ?? [];

                for (const [key, item] of Object.entries(data_all.contacts)) {
                    if(item.id == contactId){
                        $(this).find("input[type='checkbox']").prop("checked","true");
                    }
                }
            });

            $("[data-name='contact-item'] input[type='checkbox']").change(function(){
                contactId = $(this).closest("[data-name='contact-item']").attr("data-id");

                data_all.contacts =  data_all.contacts ?? [];

                let contactItem = data_all.contacts.find(item => item.id == contactId);

                if($(this).is(":checked")){
                    if(!contactItem) {
                        data_all.contacts.push({
                            id: contactId,
                            data: {
                                itemType: "new",
                                function: "add",
                            }
                        });
                    }
                }else{
                    if(contactItem && contactItem.data.itemType == "new" ) {

                        const index = data_all.contacts.findIndex(item => item.id == contactId);

                        if (index !== -1) {
                            data_all.contacts.splice(index, 1);
                        }

                    }else{
                        contactItem.function = "delete";
                    }
                }

                console.log(data_all.contacts);
            });
        }


        const formData = new FormData();
        formData.set('filters', JSON.stringify({
            partner_id: $("input[type='hidden'][data-name='partner_id']").val(),
            search: '',
        }));

        const contactsRequest = new Ajax({
            url: '{{ path('list_worksheet_notifications_contacts_list') }}',
            name: 'list_worksheet_notifications_contacts_list',
            type: 'POST',
            dataType: 'json',
            formData: formData,
            target: $("[data-key='list_worksheet_notifications_contacts_list']"),
            function_success: function (result) {
                if (result.success) {
                    this.target.html(result.content);

                    listNotificationsContactsListEventListener();



                }
            },
            function_error: function (xhr) {
                alertify.error(xhr.responseJSON?.data?.error || 'Nem sikerült betölteni a kapcsolattartókat.');
            }
        });

        function reloadContacts(filters) {
            contactsRequest.formData.set('filters', JSON.stringify(filters));
            contactsRequest.formData.set('page', '1');
            contactsRequest.send();
        }

        contactsRequest.send();

        $("input[type='hidden'][data-name='partner_id']")
            .off('change.worksheetContacts')
            .on('change.worksheetContacts', function () {
                reloadContacts({
                    partner_id: $(this).val(),
                    search: $("[data-name='search_list_worksheet_notifications_contacts_list']").val() || '',
                });
            });

        $("[data-name='search_list_worksheet_notifications_contacts_list']")
            .off('keyup.worksheetContacts')
            .on('keyup.worksheetContacts', function (event) {
                if (event.key !== 'Enter') {
                    return;
                }

                reloadContacts({
                    partner_id: $("input[type='hidden'][data-name='partner_id']").val(),
                    search: $(this).val() || '',
                });
            });

        $("[data-name='btn_list_worksheet_notifications_contacts_list']").off('click.worksheetContacts')
            .on('click.worksheetContacts', function (event) {
                reloadContacts({
                    partner_id: $("input[type='hidden'][data-name='partner_id']").val(),
                    search: $("input[data-name='search_list_worksheet_notifications_contacts_list']").val()
                });
        });

    })();
</script>
