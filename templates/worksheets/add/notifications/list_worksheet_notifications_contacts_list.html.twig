<div class="container-fluid">
    {% for record in records %}
        <div class="row row-select rounded-3 mb-1" data-id="{{ record.id }}" data-name="contact-item">
            <div class="col-2  pt-2 pb-2">
                <input type="checkbox" data-name="worksheet_notification_contact" value="1" style="width:20px;height:20px;" {{ record.default_contact  ? 'checked disabled' : ''}}>
            </div>
            <div class="col-10 pt-2 pb-2">
                <div class="text-xs">{{ record.name }} {{ record.default_contact  ? '<span class="text-xxs">(Alapért. kapcsolattartó)</span>' : ''}}</div>
                {% if record.title %}<div class="text-xxs">{{ record.title }}</div>{% endif %}
                {% if record.email %}<div class="text-xxs">{{ record.email }}</div>{% endif %}
            </div>
        </div>
    {% else %}
        <div class="row">
            <div class="col-12"><span class="text-xs">Nincsenek kapcsolatok</span></div>
        </div>
    {% endfor %}
</div>


