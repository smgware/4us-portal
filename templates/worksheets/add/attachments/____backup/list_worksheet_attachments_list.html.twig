{% for attachment in attachments %}
        <div class="row g-2 mt-2 bg-light" data-name="attachment_item" data-id="{{ attachment.id }}">
            <div class="col-4">
                {% if attachment.is_image %}
                    <span class="m-2 d-flex align-items-center justify-content-center text-muted text-decoration-none" style="width:80px;aspect-ratio:4/3;background:#f5f6f8;">
                        <img src="{{ attachment.url }}" alt="{{ attachment.name }}" class="rounded-3" style="display:none;width:100%;aspect-ratio:1/1;object-fit:cover;">
                    </span>
                {% else %}
                    <span class="m-2 d-flex align-items-center justify-content-center text-muted text-decoration-none" style="width:80px;aspect-ratio:4/3;background:#f5f6f8;">
                        <i class="bi bi-file-earmark" style="font-size:4rem;"></i>
                    </span>
                {% endif %}
            </div>
            <div class="col-8">
                <div class="row">
                    <div class="col-12"><div class="fw-semibold text-truncate" title="{{ attachment.name }}">{{ attachment.name }}</div></div>
                    {% if attachment.description %}
                        <div class="col-12"><div class="text-muted text-xs">{{ attachment.description }}</div></div>
                    {% endif %}
                    <div class="col-12">
                        <div class="text-muted text-xs">
                            {{ attachment.size_label }}
                            {% if attachment.datetime_add %}
                                - {{ attachment.datetime_add|date('Y-m-d H:i') }}
                            {% endif %}

                            {% if attachment.uploader_name %}
                                <div class="text-muted text-xs">
                                    Feltoltotte: {{ attachment.uploader_name }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="col-12">
                            <div class="text-end mt-2">
                                <div class="btn btn-default btn-sm" data-name="btnEditAttachment"><i class="bi bi-pencil-square"></i></div>
                                <div class="btn btn-default btn-sm" data-name="btnDownloadAttachment"><i class="bi bi-download"></i></div>
                                <div class="btn btn-danger btn-sm" data-name="btnDeleteAttachment"><i class="bi bi-trash"></i></div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    {% else %}

        <div class="row">
            <div class="col-12"><span class="text-xs">Nincsenek csatolmányok</span></div>
        </div>

    {% endfor %}

<div class="row">
    <div class="col-12">
        {% include 'partials/_pagination.html.twig' with {
            currentPage: page,
            totalPages: totalPages,
            routeName: 'list_users',
            queryParams: app.request.query.all
        } %}
    </div>
</div>

<script>

$("[data-name='attachment_item']").unbind("click").click(function () {
   /*showAttachmentViewer($(this),"attachment_item");*/
});



$("[data-name='btnEditAttachment']").off("click.attachment").on("click.attachment", function (e) {

    attachmentId = $(this).closest("[data-name='attachment-item']").attr("data-id");

    let attachmentItem = data_all.attachments.find(item => item.id == attachmentId);

    data_all.attachmentsEvents = data_all.attachmentsEvents ?? {};

    let attachmentsEvent = data_all.attachmentsEvents.find(item => item.id == attachmentId);

    var html_popup = `
                    <div class="container-fluid p-0" data-box="attachmentEdit">
                            <div class="row">
                                <div class="col-12">
                                    <div class="text-xs text-muted">Fájlnév:</div>
                                </div>
                                <div class="col-12">
                                    <div class="text-xs text-muted">${attachmentItem.name ?? ''}</div>
                                </div>
                                <div class="col-12">
                                    <div class="text-xs text-muted">Cím</div>
                                </div>
                                <div class="col-12">
                                    <input type="text" class="form-control" data-name="attachmentDescription" value="${attachmentItem.description ?? ''}">
                                </div>
                            </div>
                    </div>
                `;
    var html_footer = `
                    <div class="container-fluid p-0" data-box="attachmentEdit">
                        <div class="row">
                            <div class="col-12 text-end">
                                <div class="btn btn-defaul btn-sm btn-success" data-name="alertify-save"><i class="bi bi-floppy2-fill"></i> Mentés</div>
                                <div class="btn btn-default btn-sm btn-secondary" data-name="alertify-cancel"><i class="bi bi-x-circle"></i> Bezárás</div>
                            </div>
                        </div>
                    </div>
                `;

    alertify.popup("Csatomány szerkesztése",html_popup)
        .set("movable", false)
        .set("resizable", false)
        .set("closable", false)
        .set('closableByEscape', false)
        .resizeTo("50%","80%")
        .set({transition: 'zoom'})
        .setFooter(html_footer);

    $(`div[data-box="attachmentEdit"] .btn[data-name='alertify-cancel']`).unbind("click").click(function () {
        alertify.popup().close();
    });

    $(`div[data-box="attachmentEdit"] .btn[data-name='alertify-save']`).unbind("click").click(function () {

        attachmentsEvent.description = $("[data-box='attachmentEdit'] [data-name='attachmentDescription']").val();

        alertify.popup().close();
    });
});


$("[data-name='btnDeleteAttachment']").unbind("click.deleteAttachment").bind("click.deleteAttachment", function (e) {

    attachmentId = $(this).closest("[data-name='attachment_item']").attr("data-id");

    alertify.confirm("Megerősítés", "Törlöd a csatolmányt?", () => {

        let item = $("[data-name='attachment_item'][data-id='" + attachmentId + "']");

        item.fadeOut(100, function () {
            $(this).remove();
        });

    }, () => {});
});

//preload images
$("[data-name='attachment_item']").each(function () {
    const thumb = $(this).find("img");
    if (thumb.length === 0) {
        return;
    }

    const img = new Image();

    img.id = $(this).attr("data-id");
    img.onload = function (i) {

        const canvas = document.createElement("canvas");
        canvas.width = img.width;
        canvas.height = img.height;

        const ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0);

        const b64 = canvas.toDataURL("image/png"); // vagy image/jpeg

        $("[data-name='attachment_item'][data-id='" + this.id + "'] img").attr("src", b64);
        $("[data-name='attachment_item'][data-id='" + this.id + "'] img").fadeIn(100);
    };

    img.onerror = function () {
        console.log("Nem sikerült betölteni a képet.");
    };

    img.src = thumb.attr("src");

});


function showAttachmentViewer(el,name) {
    let parent      = $(el).parent();
    let idx_current = el.index();

    let items = parent.find("[data-name='"+name+"']");

    let html_attachment_viewer = `
        <div class="container-fluid p-0 position-fixed top-0 start-0 vh-100 w-100 bg-dark bg-opacity-75" id="attachment_viewer" style="display:none;">
            <div class="row g-0 vh-100 w-100 align-items-center position-relative">
                <div class="col-12 position-fixed text-end" style="bottom:150px;left:0px;z-index:8000;"><div class="btn btn-default" data-name="attachment_viewer_close">Bezárás <i class="bi bi-x-lg"></i></div></div>
                <div class="col-1 position-fixed vh-100 d-flex align-items-center justify-content-center text-white" data-name="attachment_viewer_navigate" data-direction="prev"><i class="bi bi-chevron-left fs-1"></i></div>
                <div class="col-12 vh-100 d-flex align-items-center justify-content-center" data-name="attachment_viewer_elements"></div>
                <div class="col-1 position-fixed vh-100 d-flex align-items-center justify-content-center text-white" data-name="attachment_viewer_navigate" data-direction="next"><i class="bi bi-chevron-right fs-1"></i></div>
            </div>
        </div>
    `;

    $("#attachment_viewer").remove();
    $("body").append(html_attachment_viewer);
    $("#attachment_viewer").fadeIn(100);

    function renderAttachmentViewerItem(index) {
        let item = items.eq(index);
        let isImage = item.attr("data-is-image") === "1";
        let url = item.attr("data-url");
        let downloadUrl = item.attr("data-download-url");
        let filename = item.attr("data-filename") || "";
        let container = $("[data-name='attachment_viewer_elements']");

        container.empty();

        if (isImage) {
            $("<img>", {
                src: url,
                alt: filename,
                class: "img-fluid rounded-3",
            }).css({
                maxHeight: "90vh",
                maxWidth: "100%",
                objectFit: "contain",
            }).appendTo(container);
            return;
        }

        let fileBox = $("<div>", {
            class: "text-center text-white p-4",
        });
        $("<div>", {
            class: "fw-semibold mb-3",
            text: filename,
        }).appendTo(fileBox);
        $("<a>", {
            class: "btn btn-light",
            href: downloadUrl,
            text: "Letoltes",
        }).prepend($("<i>", {
            class: "bi bi-download me-2",
        })).appendTo(fileBox);

        container.append(fileBox);
    }

    renderAttachmentViewerItem(idx_current);

    $("[data-name='attachment_viewer_navigate']").unbind("click").click(function () {
        let direction = $(this).attr("data-direction");

        if(direction == "prev"){
            idx_current = idx_current <= 0 ? items.length - 1 : idx_current - 1;
        }

        if(direction == "next"){
            idx_current = idx_current >= items.length - 1 ? 0 : idx_current + 1;
        }

        renderAttachmentViewerItem(idx_current);
    });

    $("[data-name='attachment_viewer_close']").unbind("click").click(function () {
        $("#attachment_viewer").fadeOut(100, function () {
            $(this).remove();
        });
    });

}

</script>
