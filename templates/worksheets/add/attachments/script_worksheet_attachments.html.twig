<script>
    (() => {
        const attachmentDownloadUrl = {{ path('getdata_attachment')|json_encode|raw }};
        const maxAttachmentFileSize = Number(data_all?.options?.max_attachment_file_size) || 268435456;

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, function (character) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                }[character];
            });
        }

        function formatFileSize(bytes) {
            const size = Number(bytes) || 0;

            if (size >= 1048576) {
                return (size / 1048576).toFixed(1) + ' MB';
            }
            if (size >= 1024) {
                return (size / 1024).toFixed(1) + ' KB';
            }

            return size + ' B';
        }

        function attachments() {
            data_all.attachments = Array.isArray(data_all.attachments) ? data_all.attachments : [];
            return data_all.attachments;
        }

        function findAttachment(attachmentId) {
            return attachments().find(item => item.id == attachmentId);
        }

        function attachmentElements(attachmentId) {
            return $("[data-name='attachment-item']").filter(function () {
                return $(this).attr('data-id') == attachmentId;
            });
        }

        function isImageFile(fileName) {
            return /\.(jpg|jpeg|png|gif|bmp|webp|svg|avif|ico|tiff?)$/i.test(fileName || '');
        }

        function showAttachmentViewer(el, name) {
            const clickedItem = $(el);
            const items = $("[data-name='" + name + "']").filter(function () {
                return $(this).is(':visible');
            });
            let currentIndex = items.index(clickedItem);

            if (currentIndex < 0 || items.length === 0) {
                return;
            }

            const viewerHtml = `
                <div class="container-fluid p-0 position-fixed top-0 start-0 vh-100 w-100 bg-dark bg-opacity-75" id="attachment_viewer" style="display:none;" role="dialog" aria-modal="true" aria-label="Csatolmány megtekintése">
                    <div class="row g-0 vh-100 w-100 align-items-center position-relative">
                        <div class="position-fixed top-0 end-0 p-3 text-end" style="z-index:8002;">
                            <button type="button" class="btn btn-light" data-name="attachment_viewer_close" aria-label="Bezárás">
                                Bezárás <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <button type="button" class="col-1 border-0 vh-100 d-flex align-items-center justify-content-center text-white" data-name="attachment_viewer_navigate" data-direction="prev" aria-label="Előző csatolmány">
                            <i class="bi bi-chevron-left fs-1"></i>
                        </button>
                        <div class="col-12 vh-100 d-flex align-items-center justify-content-center p-5" data-name="attachment_viewer_elements"></div>
                        <button type="button" class="col-1 border-0 vh-100 d-flex align-items-center justify-content-center text-white" data-name="attachment_viewer_navigate" data-direction="next" aria-label="Következő csatolmány">
                            <i class="bi bi-chevron-right fs-1"></i>
                        </button>
                    </div>
                </div>
            `;

            function closeViewer() {
                $(document).off('keydown.attachmentViewer');
                $("#attachment_viewer").fadeOut(100, function () {
                    $(this).remove();
                });
            }

            function renderAttachmentViewerItem(index) {
                const item = items.eq(index);
                const attachmentId = item.attr('data-id');
                const attachment = findAttachment(attachmentId);
                const filename = item.attr('data-filename')
                    || attachment?.name
                    || item.find("[data-name='name']").text()
                    || '';
                const description = String(
                    attachment?.description ?? item.find("[data-name='description']").text() ?? ''
                ).trim();
                const isImage = item.attr('data-is-image') === '1' || isImageFile(filename);
                let url = item.attr('data-url') || item.find('img').attr('src') || '';
                let downloadUrl = item.attr('data-download-url') || '';
                const isSavedAttachment = /^\d+$/.test(String(attachmentId ?? ''))
                    && attachment?.data?.attachmentType !== 'new';
                const container = $("#attachment_viewer [data-name='attachment_viewer_elements']");

                if (!url && isSavedAttachment) {
                    url = attachmentDownloadUrl + '?id=' + encodeURIComponent(attachmentId);
                }
                if (!downloadUrl && isSavedAttachment) {
                    downloadUrl = attachmentDownloadUrl + '?download=1&id=' + encodeURIComponent(attachmentId);
                }

                $("#attachment_viewer").attr('data-attachment-id', attachmentId ?? '');
                container.empty();

                if (isImage && url) {
                    $("<img>", {
                        src: url,
                        alt: filename,
                        class: 'img-fluid rounded-3'
                    }).css({
                        maxHeight: '90vh',
                        maxWidth: '100%',
                        objectFit: 'contain'
                    }).appendTo(container);
                } else if (isImage) {
                    $("<div>", {
                        class: 'text-center text-white p-4',
                        text: 'A kép betöltése folyamatban...'
                    }).appendTo(container);
                } else {
                    const fileBox = $("<div>", {
                        class: 'text-center text-white p-4'
                    });

                    $("<i>", {
                        class: 'bi bi-file-earmark d-block mb-3',
                        style: 'font-size:5rem;'
                    }).appendTo(fileBox);
                    $("<div>", {
                        class: 'fw-semibold mb-3',
                        text: filename
                    }).appendTo(fileBox);

                    if (downloadUrl) {
                        $("<a>", {
                            class: 'btn btn-light',
                            href: downloadUrl,
                            text: 'Letöltés'
                        }).prepend($("<i>", {
                            class: 'bi bi-download me-2'
                        })).appendTo(fileBox);
                    } else {
                        $("<div>", {
                            class: 'text-muted',
                            text: 'A fájl mentés után tölthető le.'
                        }).appendTo(fileBox);
                    }

                    container.append(fileBox);
                }

                const caption = $("<div>", {
                    class: 'position-fixed bottom-0 start-0 w-100 text-center text-white p-3'
                }).css({
                    pointerEvents: 'none',
                    background: 'linear-gradient(0deg, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0))'
                });

                $("<div>", {
                    class: 'fw-semibold text-truncate',
                    text: filename
                }).appendTo(caption);

                if (description) {
                    $("<div>", {
                        class: 'small text-white-50 mt-1',
                        text: description
                    }).appendTo(caption);
                }

                caption.appendTo(container);
            }

            $("#attachment_viewer").remove();
            $('body').append(viewerHtml);
            $("#attachment_viewer").fadeIn(100);
            $("#attachment_viewer [data-name='attachment_viewer_navigate']").toggle(items.length > 1);
            renderAttachmentViewerItem(currentIndex);

            $("#attachment_viewer")
                .off('attachmentViewerRefresh')
                .on('attachmentViewerRefresh', function () {
                    renderAttachmentViewerItem(currentIndex);
                });

            $("#attachment_viewer [data-name='attachment_viewer_navigate']").off('click').on('click', function () {
                const direction = $(this).attr('data-direction');

                if (direction === 'prev') {
                    currentIndex = currentIndex <= 0 ? items.length - 1 : currentIndex - 1;
                } else {
                    currentIndex = currentIndex >= items.length - 1 ? 0 : currentIndex + 1;
                }

                renderAttachmentViewerItem(currentIndex);
            });

            $("#attachment_viewer [data-name='attachment_viewer_close']").off('click').on('click', closeViewer);
            $(document).off('keydown.attachmentViewer').on('keydown.attachmentViewer', function (event) {
                if (event.key === 'Escape') {
                    closeViewer();
                } else if (event.key === 'ArrowLeft' && items.length > 1) {
                    currentIndex = currentIndex <= 0 ? items.length - 1 : currentIndex - 1;
                    renderAttachmentViewerItem(currentIndex);
                } else if (event.key === 'ArrowRight' && items.length > 1) {
                    currentIndex = currentIndex >= items.length - 1 ? 0 : currentIndex + 1;
                    renderAttachmentViewerItem(currentIndex);
                }
            });
        }

        function refreshConditionImages() {
            const slots = $("[data-name='condition_image_slot']");

            slots.each(function () {
                $(this).find('img').attr('src', '').addClass('d-none').hide();
                $(this).find('.condition-image-placeholder').show();
            });

            $("[data-name='attachment-item']").each(function () {
                const imageSource = $(this).find('img').attr('src');
                const description = $(this).find("[data-name='description']").text();

                if (!imageSource || !description) {
                    return;
                }

                const slot = slots.filter(function () {
                    return $(this).attr('data-description') === description;
                }).first();

                if (!slot.length) {
                    return;
                }

                slot.find('img').attr('src', imageSource).removeClass('d-none').show();
                slot.find('.condition-image-placeholder').hide();
            });
        }

        function renderNewAttachmentsList() {
            const target = $("[data-name='listAttachments'][data-section='add']");
            target.empty();

            attachments().forEach(function (item) {
                if (item?.data?.attachmentType !== 'new' || item?.data?.function === 'delete') {
                    return;
                }

                const itemIsImage = isImageFile(item.name);
                const html = `
                    <div class="row g-2 mt-2 bg-new-attachment rounded-3" data-name="attachment-item" data-id="${escapeHtml(item.id)}" data-filename="${escapeHtml(item.name)}" data-is-image="${itemIsImage ? '1' : '0'}" data-url="" data-download-url="" data-isconditionimage="${escapeHtml(item?.data?.isConditionImage ?? '')}">
                        <div class="col-4">
                            <span class="m-2 d-flex align-items-center justify-content-center text-muted text-decoration-none" style="width:60px;aspect-ratio:4/3;background:#f5f6f8;">
                                <img src="" alt="" class="rounded-3" style="width:100%;aspect-ratio:1/1;object-fit:cover;display:none;">
                            </span>
                        </div>
                        <div class="col-8">
                            <div class="row">
                                <div class="col-12">
                                    <div class="fw-semibold text-truncate" title="${escapeHtml(item.name)}">${escapeHtml(item.name)}</div>
                                </div>
                                <div class="col-12">
                                    <div class="text-xs" data-name="description">${escapeHtml(item.description)}</div>
                                </div>
                                <div class="col-12">
                                    <div class="text-muted text-xs">
                                        ${formatFileSize(item?.data?.size)}
                                    </div>
                                    <div class="text-end mt-2">
                                        <div class="btn btn-default btn-sm" data-name="btnEditAttachment"><i class="bi bi-pencil-square"></i></div>
                                        <div class="btn btn-default btn-sm text-danger" data-name="btnDeleteAttachment"><i class="bi bi-trash"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                target.append(html);

                if (itemIsImage && item.file instanceof Blob) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        attachmentElements(item.id)
                            .attr('data-is-image', '1')
                            .attr('data-url', event.target.result)
                            .find('img')
                            .attr('src', event.target.result)
                            .show();
                        refreshConditionImages();
                        $("#attachment_viewer").trigger('attachmentViewerRefresh');
                    };
                    reader.readAsDataURL(item.file);
                }
            });

            initAttachmentEvents();
            refreshConditionImages();
        }

        function openAttachmentEditor(attachmentId) {
            const attachment = findAttachment(attachmentId);

            if (!attachment) {
                alertify.error('A csatolmány nem található.');
                return;
            }

            const html = `
                <div class="container-fluid p-0" data-box="attachmentEdit">
                    <div class="row">
                        <div class="col-12"><div class="text-xs text-muted">Fájlnév:</div></div>
                        <div class="col-12"><div class="text-muted">${escapeHtml(attachment.name)}</div></div>
                        <div class="col-12 mt-3"><div class="text-xs text-muted">Leírás</div></div>
                        <div class="col-12">
                            <input type="text" class="form-control" data-name="attachmentDescription" value="${escapeHtml(attachment.description)}">
                        </div>
                    </div>
                </div>
            `;
            const footer = `
                <div class="container-fluid p-0" data-box="attachmentEdit">
                    <div class="row">
                        <div class="col-12 text-end">
                            <div class="btn btn-default btn-sm btn-success" data-name="alertify-save"><i class="bi bi-floppy2-fill"></i> Mentés</div>
                            <div class="btn btn-default btn-sm btn-secondary" data-name="alertify-cancel"><i class="bi bi-x-circle"></i> Bezárás</div>
                        </div>
                    </div>
                </div>
            `;

            alertify.popup('Csatolmány szerkesztése', html)
                .set('movable', false)
                .set('resizable', false)
                .set('closable', false)
                .set('closableByEscape', false)
                .resizeTo('50%', '80%')
                .set({transition: 'zoom'})
                .setFooter(footer);

            $("div[data-box='attachmentEdit'] [data-name='alertify-cancel']").off('click').on('click', function () {
                alertify.popup().close();
            });

            $("div[data-box='attachmentEdit'] [data-name='alertify-save']").off('click').on('click', function () {
                const description = $("[data-box='attachmentEdit'] [data-name='attachmentDescription']").val();

                attachment.description = description;
                attachment.data = attachment.data || {};
                attachment.data.percentage = 0;

                if (attachment.data.attachmentType !== 'new') {
                    attachment.data.function = 'update';
                }

                delete attachment.function;
                attachmentElements(attachmentId).find("[data-name='description']").text(description);
                refreshConditionImages();
                alertify.popup().close();
            });
        }

        function deleteAttachment(attachmentId, element) {
            const attachment = findAttachment(attachmentId);

            if (!attachment) {
                alertify.error('A csatolmány nem található.');
                return;
            }

            alertify.confirm('Megerősítés', 'Törlöd a csatolmányt?', function () {
                attachment.data = attachment.data || {};

                if (attachment.data.attachmentType === 'new') {
                    data_all.attachments = attachments().filter(item => item !== attachment);
                    renderNewAttachmentsList();
                    return;
                }

                attachment.data.function = 'delete';
                attachment.data.percentage = 0;
                delete attachment.function;

                element.fadeOut(150, function () {
                    $(this).remove();
                    refreshConditionImages();
                });
            }, function () {});
        }

        function initAttachmentEvents() {
            $("[data-name='attachment-item']")
                .css('cursor', 'pointer')
                .off('click.attachmentViewer')
                .on('click.attachmentViewer', function (event) {
                    if ($(event.target).closest('.btn, a, button, input, textarea, select').length) {
                        return;
                    }

                    showAttachmentViewer($(this), 'attachment-item');
                });

            $("[data-name='btnDeleteAttachment']")
                .off('click.attachment')
                .on('click.attachment', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    const element = $(this).closest("[data-name='attachment-item']");
                    deleteAttachment(element.attr('data-id'), element);
                });

            $("[data-name='btnEditAttachment']")
                .off('click.attachment')
                .on('click.attachment', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    openAttachmentEditor($(this).closest("[data-name='attachment-item']").attr('data-id'));
                });

            $("[data-name='btnDownloadAttachment']")
                .off('click.attachment')
                .on('click.attachment', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    const attachmentId = $(this).closest("[data-name='attachment-item']").attr('data-id');
                    const attachment = findAttachment(attachmentId);

                    if (!attachment || attachment?.data?.attachmentType === 'new') {
                        return;
                    }

                    window.location.assign(attachmentDownloadUrl + '?download=1&id=' + encodeURIComponent(attachmentId));
                });
        }

        const searchInput = $("[data-name='search_list_worksheet_attachments_list']");
        const listFormData = new FormData();
        listFormData.set('worksheet_id', {{ (item.id|default(''))|json_encode|raw }});
        listFormData.set('filters', JSON.stringify({search: ''}));

        const attachmentsRequest = new Ajax({
            url: '{{ path('list_worksheet_attachments_list') }}',
            name: 'list_worksheet_attachments_list',
            type: 'POST',
            dataType: 'json',
            formData: listFormData,
            target: $("[data-key='list_worksheet_attachments_list']"),
            function_success: function (result) {
                if (!result.success) {
                    this.target.html('<div class="text-center text-danger py-3">Nem sikerült betölteni a csatolmányokat.</div>');
                    return;
                }

                this.target.html(result.content);

                this.target.find("[data-name='attachment-item']").each(function () {
                    const element = $(this);
                    const attachmentId = element.attr('data-id');
                    const attachment = findAttachment(attachmentId);

                    if (attachment?.data?.function === 'delete') {
                        element.remove();
                        return;
                    }

                    if (attachment) {
                        element.find("[data-name='description']").text(attachment.description ?? '');
                        return;
                    }

                    attachments().push({
                        id: attachmentId,
                        name: element.find("[data-name='name']").text(),
                        description: element.find("[data-name='description']").text(),
                        data: {
                            attachmentType: 'exists',
                            function: '',
                            percentage: 100
                        }
                    });
                });

                initAttachmentEvents();
                refreshConditionImages();
            },
            function_error: function (xhr) {
                this.target.html('<div class="text-center text-danger py-3">Nem sikerült betölteni a csatolmányokat.</div>');
                alertify.error(xhr.responseJSON?.data?.error || 'Nem sikerült betölteni a csatolmányokat.');
            }
        });

        function loadAttachments() {
            attachmentsRequest.formData.set('filters', JSON.stringify({
                search: searchInput.val() || ''
            }));
            attachmentsRequest.send();
        }

        loadAttachments();

        searchInput.off('keyup.worksheetAttachments').on('keyup.worksheetAttachments', function (event) {
            if (event.key === 'Enter') {
                loadAttachments();
            }
        });

        $("[data-name='btn_list_worksheet_attachments_list']")
            .off('click.worksheetAttachments')
            .on('click.worksheetAttachments', loadAttachments);

        $("[data-name='btnAddAttachments']")
            .off('click.attachment')
            .on('click.attachment', function () {
                const fileInput = $("[data-name='fileAddAttachments']");
                fileInput
                    .data('attachmentDescription', $(this).data('attachmentDescription') ?? null)
                    .data('isConditionImage', $(this).data('isConditionImage') === true)
                    .trigger('click');

                $(this).removeData('attachmentDescription').removeData('isConditionImage');
            });

        $("[data-name='fileAddAttachments']")
            .off('change.attachment')
            .on('change.attachment', function () {
                const fileInput = $(this);
                const description = fileInput.data('attachmentDescription') ?? null;
                const isConditionImage = fileInput.data('isConditionImage') === true;
                const selectedFiles = Array.from(this.files || []);
                const oversizedFiles = selectedFiles.filter(file => file.size > maxAttachmentFileSize);

                if (oversizedFiles.length > 0) {
                    const fileNames = oversizedFiles.map(file => file.name).join(', ');
                    alertify.error(
                        'A következő fájl túl nagy (maximum ' + formatFileSize(maxAttachmentFileSize) + '): ' + fileNames
                    );
                }

                selectedFiles
                    .filter(file => file.size <= maxAttachmentFileSize)
                    .forEach(function (file) {
                    attachments().push({
                        id: randomString(10),
                        name: file.name,
                        file: file,
                        description: description,
                        data: {
                            attachmentType: 'new',
                            function: 'add',
                            percentage: 0,
                            size: file.size,
                            type: file.type,
                            isConditionImage: isConditionImage
                        }
                    });
                    });

                fileInput
                    .removeData('attachmentDescription')
                    .removeData('isConditionImage')
                    .val('');
                renderNewAttachmentsList();
            });
    })();
</script>
