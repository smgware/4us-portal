<div class="container-fluid">
    <div class="row">
        <div class="col-lg-9 col-12" data-name="main_data">

            <div class="card panel-card p-2 mb-2">
                <div class="row mt-2">
                    <div class="col-12"><span class="text-xs">Munkalap címe</span></div>
                    <div class="col-12">
                        <input type="text" class="form-control" data-group="worksheet" data-name="worksheet_title" value="{{ item.title }}" placeholder="Munkalap címe">
                    </div>
                </div>
            </div>

            <div class="card panel-card p-2 mb-2" >
                <div class="row mt-2">
                    <div class="col-12"><span class="text-xs">Feladatlap típusa</span></div>

                    <div class="col-12">
                        <select class="form-control" data-group="worksheet" data-name="worksheet_type" {{ isNew ? '' : 'disabled' }}>


                            {% for worksheetType in worksheetTypes %}
                                {% if (is_granted('ROLE_SERVICE') and worksheetType.code == 'ERROR_REPORT') %}
                                    <option value="{{ worksheetType.id }}" data-code="{{ worksheetType.code }}" {{ item.worksheetType and item.worksheetType.id == worksheetType.id ? 'selected' : '' }}>{{ worksheetType.title }}</option>
                                {% else %}
                                    <option value="{{ worksheetType.id }}" data-code="{{ worksheetType.code }}" {{ item.worksheetType and item.worksheetType.id == worksheetType.id ? 'selected' : '' }}>{{ worksheetType.title }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            {% set errorReportCodes = ['ERROR_REPORT', 'ERROR_REPORTING'] %}
            {% set worksheetTypeCode = item.worksheetType ? item.worksheetType.code : item.temp_data.worksheet_type_code|default('') %}
            {% set isErrorReport = worksheetTypeCode in errorReportCodes %}
            {% if isErrorReport and item.id is not null%}
                {% set errorReportFields = {
                    'machine_code': 'Gép száma',
                    'error_description': 'Hiba leírása',
                    'company_name': 'Cégnév',
                    'tax_number': 'Adószám',
                    'name': 'Bejelentő neve',
                    'email': 'E-mail cim',
                    'phone': 'Telefonszám',
                    'address': 'Helyszín'
                } %}
                <div class="card panel-card p-2 mb-2">
                    <div class="row mt-2">
                        <div class="col-12"><span>Hibajegy információk</span></div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-12">
                            <div class="text-xs text-muted">Azonosító</div>
                            <div>{{ item.code }}</div>
                        </div>

                    </div>
                    <div class="row mt-2">
                        {% for fieldKey, fieldLabel in errorReportFields %}
                            <div class="col-md-6 col-12 mb-2">
                                <div class="text-xs text-muted">{{ fieldLabel }}</div>
                                <div>{{ item.data[fieldKey]|default('-') }}</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <div class="card panel-card p-2 mb-2">
                <div class="row mt-2">
                    <div class="col-12"><span class="text-xs">Partner</span></div>
                    <div class="col-12">
                        <select data-group="worksheet" class="form-control" data-name="partner_id">
                            <option value="">Nincs kiválasztva</option>
                            {% for partner in partners %}
                                <option value="{{ partner.id }}" {{ item.partner and item.partner.id == partner.id ? 'selected' : '' }}>{{ partner.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-12"><span class="text-xs">Gép</span></div>
                    <div class="col-12">
                        {% set selectedMachineId = item.data.machine_id|default(item.machineRental and item.machineRental.machine ? item.machineRental.machine.id : '') %}
                        <select data-group="worksheet" class="form-control" data-name="machine_id" >
                            <option value="">Nincs kiválasztva</option>
                            {% for machine in machines %}
                                <option value="{{ machine.id }}" {{ selectedMachineId == machine.id ? 'selected' : '' }}>{{ machine.title }} ({{ machine.code }})</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-12"><span class="text-xs">Megjegyzés (Bérbeadó)</span></div>
                    <div class="col-12">
                        <textarea rows="5" class="form-control" data-group="worksheet.data" data-name="lessor_comment"  placeholder="felhasznált alkatrészek, feltárt hibák, egyéb megjegyzések">{{ item.data.lessor_comment|default('') }}</textarea>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-12"><span class="text-xs">Megjegyzés (Bérlő)</span></div>
                    <div class="col-12">
                        <textarea rows="5" class="form-control"  data-group="worksheet.data" data-name="renter_comment" >{{ item.data.renter_comment|default('') }}</textarea>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-12"><span class="text-xs">KM óra állás</span></div>
                    <div class="col-12">
                        <input type="text" class="form-control" data-group="worksheet.data" data-name="km"  value="{{ item.data.km|default('') }}">
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-12"><span class="text-xs">Üzemóra</span></div>
                    <div class="col-12">
                        <input type="text"  class="form-control" data-group="worksheet.data"  data-name="operating_hours" value="{{ item.data.operating_hours|default('') }}">
                    </div>
                </div>

                {% set conditionImageDescriptions = ['Elölről', 'Hátulról', 'Jobbról', 'Balról', 'Üzem / KM óra'] %}
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card panel-card p-2">
                            <div class="row g-2">
                                <div class="col-12">Állapot képek</div>
                                {% for description in conditionImageDescriptions %}
                                    <div class="col-xl col-md-4 col-6">
                                        <div class="card panel-card p-2 h-100" data-name="condition_image_slot" data-description="{{ description }}">
                                            <div class="text-xs mb-2">{{ description }}</div>
                                            <button type="button" class="condition-image-preview border rounded bg-light w-100 mb-2" data-name="condition_image_browse" aria-label="{{ description }} kép tallózása">
                                                <i class="bi bi-image condition-image-placeholder"></i>
                                                <img class="d-none" src="" alt="{{ description }}">
                                            </button>
                                            <button type="button" class="btn btn-default btn-sm w-100" data-name="btnAddConditionImage">
                                                <i class="bi bi-folder2-open"></i> Tallózás
                                            </button>

                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>



        <div class="col-lg-3 col-12">
            <div class="card panel-card p-2">
                <div class="row">
                    <div class="col-12">Státusz</div>
                    <div class="col-12">
                        <select data-name="status" id="" class="form-control">
                            {% if isErrorReport %}
                                <option value="1" {{ item.status == '1' ? 'selected' : '' }}>Új</option>
                                <option value="2" {{ item.status == '2' ? 'selected' : '' }}>Javítás alatt</option>
                                <option value="-1" {{ item.status == '-1' ? 'selected' : '' }}>Visszavéve</option>
                                <option value="-2" {{ item.status == '-2' or item.status == '0' ? 'selected' : '' }}>Javítva, kiadva</option>
                            {% else %}
                                <option value="1" {{ item.status == '1' ? 'selected' : '' }}>Nyitott</option>
                                <option value="0" {{ item.status == '0' ? 'selected' : '' }}>Lezárt</option>
                            {% endif %}
                        </select>
                    </div>

                </div>
            </div>

            <div class="card panel-card p-2 mt-3">
                <div class="row">
                    <div class="col-7">Csatolmányok</div>
                    <div class="col-5 text-end">
                        <div class="btn btn-default btn-sm" data-name="btnAddAttachments"><i class="bi bi-plus-circle-fill"></i> Hozzáadás</div>
                        <input type="file" data-name="fileAddAttachments" id="" class="form-control d-none" multiple>
                    </div>

                </div>

                <div class="row mt-2">
                    <div class="col-12"><input type="text" class="form-control" data-name="search_attachments" placeholder="Keresés..."></div>
                </div>

                <div class="row mt-2">
                    <div class="col-12" data-name="listAttachments" data-section="add"></div>
                    <div class="col-12" data-name="listAttachments" data-section="existing"></div>

                </div>
            </div>


            <div class="card panel-card p-2 mt-3">
                <div class="row">
                    <div class="col-12">Funkciók</div>
                </div>

                <div class="row">
                    <div class="col-12 text-end">
                        <div class="btn btn-sm btn-default" data-name="btn_print_pdf"><i class="bi bi-file-pdf"></i> Nyomtatási nézet</div>

                    </div>

                </div>
            </div>



        </div>

        <div class="col-12 mt-2" data-name="signatures" style="display:noned">
            <div class="card panel-card p-2">
                <div class="row">
                    <div class="col-12"><span>Aláírások</span></div>

                    <div class="row">
                        <div class="col-lg-6 col-12 mb-2" data-name="signature_preview" data-type="handed">
                            <div class="row">
                                <div class="col-12"><span class="text-xs">Átvevő</span></div>
                            </div>
                            <div class="row">
                                <div class="col-12"><span class="text-xs">Név</span></div>
                                <div class="col-12">
                                    <span data-name="signature_name">{{ item.data.signatures.handed.name|default('') }}</span>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-8" data-name="image">
                                    <span class="text-xs">Nincs rögzített aláírás</span>
                                </div>
                                <div class="col-4">
                                    <div class="btn btn-default btn-sm" data-name="btnSignatureAdd" data-type="handed"><i class="bi bi-pencil-square"></i> Kitöltés</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-12 mb-2" data-name="signature_preview" data-type="received">
                            <div class="row">
                                <div class="col-12"><span class="text-xs">Átvevő</span></div>
                            </div>
                            <div class="row">
                                <div class="col-12"><span class="text-xs">Név</span></div>
                                <div class="col-12">
                                    <span data-name="signature_name">{{ item.data.signatures.received.name|default('') }}</span>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-8" data-name="image">
                                    <span class="text-xs">Nincs rögzített aláírás</span>
                                </div>
                                <div class="col-4">
                                    <div class="btn btn-default btn-sm" data-name="btnSignatureAdd" data-type="received"><i class="bi bi-pencil-square"></i> Kitöltés</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>


    </div>

</div>


<style>
    .condition-image-preview {
        height: 150px;
        cursor: pointer;
        overflow: hidden;
    }
    .condition-image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .condition-image-placeholder {
        font-size: 4rem;
        color: #adb5bd;
    }
</style>

<script>
    //FUNCTIONS
    var formData = new FormData();

    formData.append("worksheet_id", "{{ item.id }}");
    formData.append("filters", "{}");

    new Ajax({
        url: '{{ path('index_worksheet_attachments_list') }}',
        name: 'index_worksheet_attachments_list',
        type: 'POST',
        dataType: 'json',
        formData: formData,
        target:  $("[data-name='index_worksheet_attachments_list']"),
        function_success: function (result) {
            if (result.success) {
                for (const [key, item] of Object.entries(data_all.attachments)) {
                    if(item.function != "add"){
                        delete data_all.attachments[key];
                    }
                }

                data_all.attachments = Object.assign(data_all.attachments, result.data.attachments);

                renderAttachmentsList();
            }
        },
        function_error: function (xhr) {
            alertify.error(xhr.responseJSON?.data?.error || 'Hiba');
        }
    }).send();


    function renderAttachmentsList(section){

        targetNew = $(`[data-name='listAttachments'][data-section='add']`);
        targetExisting = $(`[data-name='listAttachments'][data-section='existing']`);

        if(section == "add"){
            target = targetNew;
        }

        if(section == "existing"){
            target = targetExisting;
        }

        target.html("");

        for (const [key, item] of Object.entries(data_all.attachments)) {
            if(section == "add") {
                if((item.data.function ?? null) != "add"){
                    continue;
                }
            }

            if(section == "existing") {
                if((item.data.function ?? null) == "add"){
                    continue;
                }
            }
            if((item.data.function ?? null) == "delete"){
                continue;
            }

            htmlAttachmentItem = `
                <div class="row g-2 mt-2 bg-light" data-name="attachment-item" data-id="${item.id}">
                    <div class="col-4">
                        <span class="m-2 d-flex align-items-center justify-content-center text-muted text-decoration-none" style="width:80px;aspect-ratio:4/3;background:#f5f6f8;">
                            <img src="" alt="" class="rounded-3" style="width: 100%; aspect-ratio: 1 / 1; object-fit: cover;display:none;">
                        </span>
                    </div>
                    <div class="col-8">
                        <div class="row">
                            <div class="col-12"><div class="fw-semibold text-truncate" title="${item.description ?? item.name}">${item.description ?? item.name}</div></div>
                            <div class="col-12"><div class="text-xs">${item.description != '' ? item.name :  ''}</div></div>
                            <div class="col-12">
                                <div class="text-muted text-xs">
                                   ${((item?.data?.size ?? 0) / 1024 /1024).toFixed(2)} KB
                                    - ${item.datetime_add ?? ''}
                                </div>

                                <div class="col-12">
                                    <div class="text-end mt-2">
                                        <div class="btn btn-default btn-sm" data-name="btnEditAttachment"><i class="bi bi-pencil-square"></i></div>
                                        ${item?.data?.function != "add" ? '<div class="btn btn-default btn-sm" data-name="btnDownloadAttachment"><i class="bi bi-download"></i></div>' : '' }
                                        <div class="btn btn-default btn-sm text-danger" data-name="btnDeleteAttachment"><i class="bi bi-trash"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;


            target.append(htmlAttachmentItem);

            //attachment-events

            $("[data-name='btnDeleteAttachment']").off("click.attachment").on("click.attachment", function (e) {

                attachmentId = $(this).closest("[data-name='attachment-item']").attr("data-id");
                let attachmentItem = data_all.attachments.find(item => item.id == attachmentId);

                alertify.confirm("Megerősítés", "Törlöd a csatományt?", ()=>{
                    if(attachmentItem?.data?.function == "add"){
                        data_all.attachments = data_all.attachments.filter(item => item !== attachmentItem);
                    }else{
                        attachmentItem.data.function = "delete";
                    }

                    $("[data-name='attachment-item'][data-id='"+attachmentId+"']").remove();
                    copyConditionImages();

                }, ()=>{} );
            });

            $("[data-name='btnEditAttachment']").off("click.attachment").on("click.attachment", function (e) {

                attachmentId = $(this).closest("[data-name='attachment-item']").attr("data-id");

                let attachmentItem = data_all.attachments.find(item => item.id == attachmentId);

                var html_popup = `
                    <div class="container-fluid p-0" data-box="attachmentEdit">
                            <div class="row">
                                <div class="col-12">
                                    <div class="text-xs text-muted">Fájlnév:</div>
                                </div>
                                <div class="col-12">
                                    <div class="text-xs text-muted">${attachmentItem.name ?? ''}</div>
                                </div>
                                <div class="col-12">
                                    <div class="text-xs text-muted">Cím</div>
                                </div>
                                <div class="col-12">
                                    <input type="text" class="form-control" data-name="attachmentDescription" value="${attachmentItem.description ?? ''}">
                                </div>
                            </div>
                    </div>
                `;
                var html_footer = `
                    <div class="container-fluid p-0" data-box="attachmentEdit">
                        <div class="row">
                            <div class="col-12 text-end">
                                <div class="btn btn-defaul btn-sm btn-success" data-name="alertify-save"><i class="bi bi-floppy2-fill"></i> Mentés</div>
                                <div class="btn btn-default btn-sm btn-secondary" data-name="alertify-cancel"><i class="bi bi-x-circle"></i> Bezárás</div>
                            </div>
                        </div>
                    </div>
                `;

                alertify.popup("Csatomány szerkesztése",html_popup)
                    .set("movable", false)
                    .set("resizable", false)
                    .set("closable", false)
                    .set('closableByEscape', false)
                    .resizeTo("50%","80%")
                    .set({transition: 'zoom'})
                    .setFooter(html_footer);

                $(`div[data-box="attachmentEdit"] .btn[data-name='alertify-cancel']`).unbind("click").click(function () {
                    alertify.popup().close();
                });

                $(`div[data-box="attachmentEdit"] .btn[data-name='alertify-save']`).unbind("click").click(function () {

                    attachmentItem.description = $("[data-box='attachmentEdit'] [data-name='attachmentDescription']").val();

                    attachmentItemFunction = attachmentItem?.data?.function ?? null;

                    if(attachmentItemFunction == "add"){
                        renderAttachmentsList("add");
                    }else{
                        attachmentItem.data = attachmentItem.data || {};
                        attachmentItem.data.function = "update";
                        renderAttachmentsList("existing");
                    }
                    alertify.popup().close();
                });
            });

        }


        //preview add image
        $("[data-name='attachment-item']").each(function(){
            attachmentId = $(this).attr("data-id");

            let attachmentItem = data_all.attachments.find(item => item.id == attachmentId);

            if(attachmentItem.file){
                file = attachmentItem.file;
                if (file && file.type.startsWith("image/")) {
                    const reader = new FileReader();
                    reader.id = attachmentId;
                    reader.onload = function (e) {
                        $("[data-name='attachment-item'][data-id='"+this.id+"'] img").attr("src", e.target.result);
                        $("[data-name='attachment-item'][data-id='"+this.id+"'] img").fadeIn(200);

                        copyConditionImages();

                    };
                    reader.readAsDataURL(file);


                }else{
                    $("[data-name='attachment-item'][data-id='"+attachmentId+"'] img").parent().html('<i class="bi bi-file-earmark-fill"></i>');
                }
            }else{
                if(/\.(jpg|jpeg|png|gif|bmp|webp|svg|avif|ico|tiff?)$/i.test(attachmentItem.name) ){
                    $("[data-name='attachment-item'][data-id='"+attachmentId+"'] img").attr("src", "{{ path('getdata_attachment') }}?id="+ attachmentId);
                    $("[data-name='attachment-item'][data-id='"+attachmentId+"'] img").fadeIn(200);
                }else{
                    $("[data-name='attachment-item'][data-id='"+attachmentId+"'] img").parent().html('<i class="bi bi-file-earmark-fill"></i>');
                }
            }
        });

        copyConditionImages();
    }

    function copyConditionImages(){

        //PRELOAD STATUS IMAGES
        for (const [key, item] of Object.entries(data_all.attachments)) {
            imgsrc = $("[data-name='listAttachments'] [data-name='attachment-item'][data-id='"+item.id+"'] img").attr("src");

            if(imgsrc !== undefined) {
                $("[data-name='condition_image_slot'][data-description='" + item.description + "'] img").attr("src", imgsrc);
                $("[data-name='condition_image_slot'][data-description='" + item.description + "'] img").removeClass("d-none");
                $("[data-name='condition_image_slot'][data-description='" + item.description + "'] img").css("display", "none");
                $("[data-name='condition_image_slot'][data-description='" + item.description + "'] .condition-image-placeholder").css("display", "none");
                $("[data-name='condition_image_slot'][data-description='" + item.description + "'] img").fadeIn(200);
            }else{
                $("[data-name='condition_image_slot'][data-description='" + item.description + "'] img").addClass("d-none");
                $("[data-name='condition_image_slot'][data-description='" + item.description + "'] .condition-image-placeholder").fadeIn(200);
            }
        }
    }

    function renderSignatures(){
        signatures = data_all?.worksheet?.data?.signatures ?? {};

        for (const [type, item] of Object.entries(signatures)) {
            target = $("[data-name='signature_preview'][data-type='"+item.type+"']");

            console.log(item.name);

            if(item.image != null){
                target.find("[data-name='image']").html(`<img src="${item.image}" height="100"/>`);
            }else{
                target.find("[data-name='image']").html(`<span class="text-xs">Nincs rögzített aláírás</span>`);
            }

            target.find("[data-name='signature_name']").html((item.name ?? null));

        }

    }

    function finishWorksheetSave() {
        if (ajaxquery['list_worksheets']) {
            ajaxquery['list_worksheets'].send();
        }

        alertify.success('A munkalap mentése sikerült.');
        alertify.sheet().close();
    }

    function uploadAttachments(){
        const operations = (data_all.attachments || []).filter(function (item) {
            return ['add', 'update', 'delete'].includes(item?.data?.function);
        });

        if (operations.length === 0) {
            finishWorksheetSave();
            return;
        }

        const progress = new Map();
        let completed = 0;
        let failed = false;
        let firstError = '';

        operations.forEach(function (item) {
            progress.set(item, 0);
        });

        alertify.popup(
            'Információ',
            '<div class="container-fluid text-center py-3">' +
                '<div>Csatolmányok feldolgozása folyamatban...</div>' +
                '<div class="fs-4 fw-semibold mt-2" data-name="upload-percentage-all">0%</div>' +
            '</div>'
        )
            .set('closable', false)
            .set('closableByEscape', false)
            .set('movable', false)
            .set('resizable', false);

        function updateOverallProgress() {
            let sum = 0;
            progress.forEach(function (value) {
                sum += value;
            });

            const percentage = Math.round(sum / operations.length);
            $("[data-name='upload-percentage-all']").text(percentage + '%');
        }

        function completeOperation(item, success, result, errorMessage) {
            completed++;

            if (success) {
                progress.set(item, 100);

                if (item.data.function === 'delete') {
                    item._deleteCompleted = true;
                } else if (result?.data?.attachment) {
                    const savedAttachment = result.data.attachment;
                    item.id = savedAttachment.id;
                    item.name = savedAttachment.name;
                    item.description = savedAttachment.description;
                    item.data = savedAttachment.data || {};
                    item.datetime_add = savedAttachment.datetime_add;
                    item.datetime_last = savedAttachment.datetime_last;
                    delete item.file;
                }
            } else {
                failed = true;
                firstError = firstError || errorMessage || 'Nem sikerült feldolgozni egy csatolmányt.';
            }

            updateOverallProgress();

            if (completed !== operations.length) {
                return;
            }

            data_all.attachments = (data_all.attachments || []).filter(function (attachment) {
                return !attachment._deleteCompleted;
            });
            renderAttachmentsList('add');
            renderAttachmentsList('existing');

            if (failed) {
                alertify.popup().close();
                $(`div[data-box="worksheet_add"] .btn[data-name='alertify-save']`).removeClass('disabled');
                alertify.error(firstError);
                return;
            }

            $("[data-name='upload-percentage-all']").text('100%');
            window.setTimeout(function () {
                alertify.popup().close();
                finishWorksheetSave();
            }, 250);
        }

        operations.forEach(function (item) {
            const operation = item.data.function;
            const attachmentFormData = new FormData();
            attachmentFormData.append('worksheet_id', data_all.worksheet.id);
            attachmentFormData.append('id', item.id ?? '');
            attachmentFormData.append('function', operation);
            attachmentFormData.append('data', JSON.stringify({
                name: item.name ?? '',
                description: item.description ?? '',
                data: item.data || {}
            }));

            const hasFile = item.file instanceof Blob && operation !== 'delete';
            if (hasFile) {
                attachmentFormData.append('file', item.file, item.name || item.file.name);
            }

            $.ajax({
                url: '{{ path('save_worksheets_attachment') }}',
                type: 'POST',
                dataType: 'json',
                timeout: 800000,
                processData: false,
                contentType: false,
                data: attachmentFormData,
                xhr: function () {
                    const xhr = $.ajaxSettings.xhr();

                    if (hasFile && xhr.upload) {
                        xhr.upload.addEventListener('progress', function (event) {
                            if (event.lengthComputable) {
                                progress.set(item, Math.min(99, Math.round((event.loaded / event.total) * 100)));
                                updateOverallProgress();
                            }
                        });
                    }

                    return xhr;
                },
                success: function (result) {
                    completeOperation(item, result.success === true, result, result.data?.error);
                },
                error: function (xhr) {
                    completeOperation(
                        item,
                        false,
                        null,
                        xhr.responseJSON?.data?.error || 'Nem sikerült feltölteni a csatolmányt.'
                    );
                }
            });

        });
    }

    //FUNCTIONS END

    //EVENTS

    $(document).ready(function(){
        renderAttachmentsList("existing");
        renderSignatures();
    });

    {% if item.status > 0 %}
    $("[data-name='worksheet_add'] [data-name='alertify-save']").fadeIn(100);
    {% endif %}


    $("[data-name='btnAddAttachments']").off("click.attachment").on("click.attachment", function (e) {
        $("[data-name='fileAddAttachments']").trigger("click");
    });

    $("[data-name='fileAddAttachments']").off("change.attachment").on("change.attachment", function (e) {

        Array.from(this.files || []).forEach(function (file) {
            data_all.attachments = data_all.attachments || [];
            data_all.attachments.push({
                id: randomString(10),
                name: file.name,
                file: file,
                description: localStorage.getItem("attachmentDescription") ?? null,
                data: {
                    function: "add",
                    size: file.size,
                    type: file.type
                }
            });
        });
        localStorage.removeItem("attachmentDescription");

        renderAttachmentsList("add");

        $(this).val("");
    });

    $("[data-name='btnAddConditionImage']").off("click.attachment").on("click.attachment", function (e) {
        attachmentDescription = $(this).closest("[data-name='condition_image_slot']").attr("data-description");
        localStorage.setItem("attachmentDescription", attachmentDescription);
        $("[data-name='btnAddAttachments']").trigger("click");
    });


    $(`.btn[data-name='btnSignatureAdd']`).off("click.attachment").on("click.attachment", function (e) {
        //openWorksheetSignaturePopup($(this).attr("data-type"));
        signatureDataType = $(this).attr("data-type");
        localStorage.setItem("signatureDataType",signatureDataType);

        new Ajax({
            url: '{{ path('index_worksheet_signature_add') }}',
            name: 'index_worksheet_signature_add',
            type: 'GET',
            dataType: 'json',
            formData: formData,
            target: null,
            function_success: function (result) {
                html_footer = `
                        <div class="container-fluid p-0" data-box="${this.name}">
                            <div class="row">
                                <div class="col-12 text-end">
                                        <div class="btn btn-default btn-sm btn-success" data-name="alertify-save">Mentés</div>
                                        <div class="btn btn-default btn-sm btn-secondary" data-name="alertify-cancel">Mégse</div>
                                </div>
                            </div>
                        </div>
                `;


                let previousBodyOverflow = $("body").css("overflow");
                $("body").css("overflow", "hidden");

                function restoreSignaturePopupScroll() {
                    $("body").css("overflow", previousBodyOverflow);
                }

                alertify.popup("Aláírás", result.content).
                set("movable",false).
                set("closable",false).
                set('closableByEscape', false).

                set({transition:'zoom'}).
                set("onclose", restoreSignaturePopupScroll).
                set("resizable",false).
                setFooter(html_footer);




                $(`div[data-box="${this.name}"] .btn[data-name='alertify-cancel']`).unbind("click").click(function(){
                    alertify.popup().close();

                    localStorage.removeItem("signatureDataType");
                });

                $(`div[data-box="${this.name}"] .btn[data-name='alertify-save']`).unbind("click").click(function(){

                    signatureDataType = localStorage.getItem("signatureDataType");

                    const canvas = document.querySelector('[data-name="signature_canvas"]');
                    const signature = canvas.toDataURL('image/png');

                    data_all.worksheet = data_all.worksheet || {};
                    data_all.worksheet.data = data_all.worksheet.data || {};
                    data_all.worksheet.data.signatures = data_all.worksheet.data.signatures || {};

                    data_all.worksheet.data.signatures[signatureDataType] = {
                        'image': signature,
                        'type': signatureDataType,
                        'name' : $("[data-name='signature_popup'] [data-name='signature_name']").val()
                    };

                    //draw image use
                    renderSignatures();

                    alertify.popup().close();

                    localStorage.removeItem("signatureDataType");
                });
            },
            function_error: function (xhr) {
                const message = xhr.responseText || 'Nem sikerült betölteni az oldalt.';
                alertify.error(message);
            }
        }).send();


    });

    $(`div[data-box="worksheet_add"] .btn[data-name='alertify-save']`).unbind("click").click(function () {
        const saveButton = $(this);
        if (saveButton.hasClass('disabled')) {
            return;
        }

        alertify.confirm("Megerősítés", "Mented az adatokat?", () => {

            const worksheet = $.extend(true, {}, data_all.worksheet || {});
            worksheet.data = worksheet.data || {};
            delete worksheet.temp_data;

            worksheet.title = ($("[data-name='worksheet_title']").val() || '').trim();
            worksheet.worksheet_type_id = $("[data-name='worksheet_type']").val();
            worksheet.partner_id = $("[data-name='partner_id']").val() || null;
            worksheet.status = $("[data-name='status']").val();
            worksheet.data.machine_id = $("[data-name='machine_id']").val() || null;

            $("[data-group='worksheet.data']").each(function () {
                worksheet.data[$(this).attr('data-name')] = $(this).val();
            });

            const saveData = {
                worksheet: worksheet,
                contacts: data_all.contacts || {}
            };

            const worksheetFormData = new FormData();
            worksheetFormData.append("data", JSON.stringify(saveData));
            saveButton.addClass('disabled');


            new Ajax({
                url: '{{ path('save_worksheets') }}',
                name: 'save_worksheets',
                type: 'POST',
                dataType: 'json',
                formData: worksheetFormData,
                function_success: function (result) {
                    if (!result.success) {
                        saveButton.removeClass('disabled');
                        alertify.error(result.data?.error || 'Nem sikerult menteni a munkalapot.');
                        return;
                    }

                    data_all.worksheet = result.data.worksheet;
                    uploadAttachments();
                },
                function_error: function (xhr) {
                    saveButton.removeClass('disabled');
                    alertify.error(xhr.responseJSON?.data?.error || 'Nem sikerult menteni a munkalapot.');
                }
            }).send();



        }, () => {});
    });

    $("[data-name='search_attachments']").off("keyup.attachment").on("keyup.attachment", function (e) {

        if(e.keyCode == 13){
            var filters = JSON.parse(ajaxquery['list_worksheet_attachments_list'].formData.get("filters"));
            filters.search = $(this).val();
            ajaxquery['list_worksheet_attachments_list'].formData.set("filters", JSON.stringify(filters));
            ajaxquery['list_worksheet_attachments_list'].send();
        }

    });

</script>
