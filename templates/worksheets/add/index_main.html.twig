
<style>
    .condition-image-preview {
        height: 150px;
        cursor: pointer;
        overflow: hidden;
    }
    .condition-image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .condition-image-placeholder {
        font-size: 4rem;
        color: #adb5bd;
    }
    .bg-new-attachment{
        background:rgba(255,245,195,0.5);
    }
    .worksheet-combobox {
        position: relative;
    }
    .worksheet-combobox-results {
        position: absolute;
        top: calc(100% + 2px);
        left: 0;
        z-index: 1080;
        width: 100%;
        max-height: 260px;
        overflow-y: auto;
        background: #fff;
    }
    .worksheet-combobox-option {
        text-align: left;
        white-space: normal;
    }
</style>




<div class="container-fluid">
    <div class="row">
        <div class="col-lg-9 col-12" data-name="main_data">

            <div class="row">
                <div class="col-12">
                    <div class="card panel-card p-2 mb-2">

                        <div class="row mt-2">
                            <div class="col-12"><span class="text-xs">Feladatlap típusa</span></div>

                            <div class="col-12">
                                <select class="form-control" data-group="worksheet" data-name="worksheet_type" {{ isNew ? '' : 'disabled' }}>


                                    {% for worksheetType in worksheetTypes %}
                                        {% if (is_granted('ROLE_SERVICE') and worksheetType.code == 'ERROR_REPORT') %}
                                            <option value="{{ worksheetType.id }}" data-code="{{ worksheetType.code }}" {{ item.worksheetType and item.worksheetType.id == worksheetType.id ? 'selected' : '' }}>{{ worksheetType.title }}</option>
                                        {% else %}
                                            <option value="{{ worksheetType.id }}" data-code="{{ worksheetType.code }}" {{ item.worksheetType and item.worksheetType.id == worksheetType.id ? 'selected' : '' }}>{{ worksheetType.title }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12"><span class="text-xs">Munkalap címe</span></div>
                            <div class="col-12">
                                <input type="text" class="form-control" data-group="worksheet" data-name="worksheet_title" value="{{ item.title }}" placeholder="Munkalap címe">
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12"><span class="text-xs">Partner</span></div>
                            <div class="col-12">
                                {% set selectedPartnerLabel = item.partner ? item.partner.name : '' %}
                                <div class="worksheet-combobox" data-worksheet-combobox="partner">
                                    <div class="input-group">
                                        <input
                                            type="text"
                                            name="partner_search"
                                            class="form-control"
                                            data-name="partner_search"
                                            value="{{ selectedPartnerLabel }}"
                                            placeholder="Partner vagy cég keresése..."
                                            autocomplete="off"
                                            role="combobox"
                                            aria-autocomplete="list"
                                            aria-controls="worksheet_partner_results"
                                            aria-expanded="false"
                                        >
                                        <button type="button" class="btn btn-outline-secondary" data-name="combobox-clear" aria-label="Partner törlése">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    <input type="hidden" name="partner_id" data-group="worksheet" data-name="partner_id" value="{{ item.partner ? item.partner.id : '' }}">
                                    <div id="worksheet_partner_results" class="worksheet-combobox-results list-group shadow-sm d-none" data-name="combobox-results" role="listbox"></div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12"><span class="text-xs">Gép</span></div>
                            <div class="col-12">
                                {% set selectedMachineLabel = selectedMachine ? selectedMachine.title : '' %}
                                <div class="worksheet-combobox" data-worksheet-combobox="machine">
                                    <div class="input-group">
                                        <input
                                            type="text"
                                            name="machine_search"
                                            class="form-control"
                                            data-name="machine_search"
                                            value="{{ selectedMachineLabel }}"
                                            placeholder="Gép keresése név vagy kód alapján..."
                                            autocomplete="off"
                                            role="combobox"
                                            aria-autocomplete="list"
                                            aria-controls="worksheet_machine_results"
                                            aria-expanded="false"
                                        >
                                        <button type="button" class="btn btn-outline-secondary" data-name="combobox-clear" aria-label="Gép törlése">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    <input type="hidden" name="machine_id" data-group="worksheet" data-name="machine_id" value="{{ selectedMachine ? selectedMachine.id : '' }}">
                                    <div id="worksheet_machine_results" class="worksheet-combobox-results list-group shadow-sm d-none" data-name="combobox-results" role="listbox"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>


            {% if item.worksheetType.code == 'ERROR_REPORT' and item.id is not null%}
                {% set errorReportFields = {
                    'machine_code': 'Gép száma',
                    'error_description': 'Hiba leírása',
                    'company_name': 'Cégnév',
                    'tax_number': 'Adószám',
                    'name': 'Bejelentő neve',
                    'email': 'E-mail cim',
                    'phone': 'Telefonszám',
                    'address': 'Helyszín'
            } %}
            <!--error report informations-->
            <div class="row mt-2">
                <div class="col-12">
                    <div class="card panel-card p-2 mb-2">
                        <div class="row mt-2">
                            <div class="col-12"><span>Hibajegy információk</span></div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <div class="text-xs text-muted">Azonosító</div>
                                <div>{{ item.code }}</div>
                            </div>

                        </div>
                        <div class="row mt-2">
                            {% for fieldKey, fieldLabel in errorReportFields %}
                                <div class="col-md-6 col-12 mb-2">
                                    <div class="text-xs text-muted">{{ fieldLabel }}</div>
                                    <div>{{ item.data[fieldKey]|default('-') }}</div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}

            <!--descriptions-->
            <div class="row">
                <div class="col-12">
                    <div class="card panel-card p-2 mb-2">
                        <div class="row mt-2">
                            <div class="col-12"><span class="text-xs">Megjegyzés (Bérbeadó)</span></div>
                            <div class="col-12">
                                <textarea rows="5" class="form-control" data-group="worksheet.data" data-name="lessor_comment"  placeholder="felhasznált alkatrészek, feltárt hibák, egyéb megjegyzések">{{ item.data.lessor_comment|default('') }}</textarea>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12"><span class="text-xs">Megjegyzés (Bérlő)</span></div>
                            <div class="col-12">
                                <textarea rows="5" class="form-control"  data-group="worksheet.data" data-name="renter_comment" >{{ item.data.renter_comment|default('') }}</textarea>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12"><span class="text-xs">KM óra állás</span></div>
                            <div class="col-12">
                                <input type="number" class="form-control" data-group="worksheet.data" data-name="km"  value="{{ item.data.km|default('') }}">
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12"><span class="text-xs">Üzemóra</span></div>
                            <div class="col-12">
                                <input type="number"  class="form-control" data-group="worksheet.data"  data-name="operating_hours" value="{{ item.data.operating_hours|default('') }}">
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!--condition images -->
            <div class="row">
                <div class="col-12">
                    <div class="card panel-card p-2">
                        <div class="row g-2">
                            <div class="col-12">Állapot képek</div>
                            {% for conditionImageType in conditionImageTypes %}
                                <div class="col-xl col-md-4 col-6">
                                    <div class="card panel-card p-2 h-100" data-name="condition_image_slot" data-description="{{ conditionImageType.title }}">
                                        <div class="text-xs mb-2">{{ conditionImageType.title }}</div>
                                        <button type="button" class="condition-image-preview border rounded bg-light w-100 mb-2" data-name="condition_image_browse">
                                            <i class="bi bi-image condition-image-placeholder"></i>
                                            <img class="d-none" src="">
                                        </button>
                                        <button type="button" class="btn btn-default btn-sm w-100" data-name="btnAddConditionImage">
                                            <i class="bi bi-folder2-open"></i> Tallózás
                                        </button>

                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <!--signatures-->
            <div class="row mt-2">
                <div class="col-12">
                    <div class="card panel-card p-2 mb-2">
                        <div class="col-12">


                            <div class="row">
                                <div class="col-12"><span>Aláírások</span></div>
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <div class="row">
                                        <div class="col-lg-6 col-12 mb-2" data-name="signature_preview" data-type="handed">
                                            <div class="card panel-card p-2 mb-2">
                                                <div class="row">
                                                    <div class="col-12"><span class="text-xs">Átvevő</span></div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-12"><span class="text-xs">Név</span></div>
                                                    <div class="col-12">
                                                        <span data-name="signature_name">{{ item.data.signatures.handed.name|default('') }}</span>
                                                    </div>
                                                </div>
                                                <div class="row mt-2">
                                                    <div class="col-8" data-name="image">
                                                        <span class="text-xs">Nincs rögzített aláírás</span>
                                                    </div>
                                                    <div class="col-4 text-end">
                                                        <div class="btn btn-default btn-sm" data-name="btnSignatureAdd" data-type="handed"><i class="bi bi-pencil-square"></i> Kitöltés</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-6 col-12 mb-2" data-name="signature_preview" data-type="received">
                                            <div class="card panel-card p-2 mb-2">
                                                <div class="row">
                                                    <div class="col-12"><span class="text-xs">Átvevő</span></div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-12"><span class="text-xs">Név</span></div>
                                                    <div class="col-12">
                                                        <span data-name="signature_name">{{ item.data.signatures.received.name|default('') }}</span>
                                                    </div>
                                                </div>
                                                <div class="row mt-2">
                                                    <div class="col-8" data-name="image">
                                                        <span class="text-xs">Nincs rögzített aláírás</span>
                                                    </div>
                                                    <div class="col-4 text-end">
                                                        <div class="btn btn-default btn-sm" data-name="btnSignatureAdd" data-type="received"><i class="bi bi-pencil-square"></i> Kitöltés</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-3 col-12">

            <!--status-->
            <div class="row">
                <div class="card panel-card p-2">
                    <div class="col-12">Státusz</div>
                    <div class="col-12">
                        <select data-group="worksheet" data-name="worksheet_status_type_id" class="form-control" disabled>
                            <option value="">Státuszok betöltése...</option>
                        </select>
                    </div>
                </div>
            </div>

            <!--attachments-->
            <div class="row">
                <div class="card panel-card p-2 mt-3">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-7">Csatolmányok</div>
                            <div class="col-5 text-end">
                                <div class="btn btn-default btn-sm" data-name="btnAddAttachments"><i class="bi bi-plus-circle-fill"></i> Hozzáadás</div>
                                <input type="file" data-name="fileAddAttachments" id="" class="form-control d-none" multiple>
                            </div>

                        </div>

                        <div class="row mt-2">
                            <div class="col-10"><input type="text" class="form-control" placeholder="Kereses...." data-name="search_list_worksheet_attachments_list"></div>
                            <div class="col-2 text-end"><div class="btn btn-default btn-sm" data-name="btn_list_worksheet_attachments_list"><i class="bi bi-search"></i></div></div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12" data-name="listAttachments" data-section="add"></div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12" data-name="ajax-content" data-key="list_worksheet_attachments_list" style="height:300px;overflow-y:auto;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!--notifications-->
            <div class="row">
                <div class="card panel-card p-2 mt-3">
                    <div class="row">
                        <div class="col-12"><span>Értesítések beállítása</span></div>
                    </div>
                    <div class="row">
                        <!--<div class="col-12 text-end"><div class="btn btn-default btn-sm" data-name="btnAddNewPartnerContact"><i class="bi bi-plus-circle-fill"></i> Hozzáadás</div></div>-->
                    </div>

                    <div class="row mt-2">
                        <div class="col-10">
                            <input type="text" class="form-control" data-name="search_list_worksheet_notifications_contacts_list" placeholder="Keresés...">
                        </div>
                        <div class="col-2 text-end"><div class="btn btn-default btn-sm" data-name="btn_list_worksheet_notifications_contacts_list"><i class="bi bi-search"></i></div></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-12" data-name="ajax-content" data-key="list_worksheet_notifications_contacts_list"></div>
                    </div>

                </div>
            </div>

            <!--functions-->
            <div class="row">
                <div class="card panel-card p-2 mt-3">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-12 text-end">
                                <div class="btn btn-sm btn-default" data-name="btn_print_pdf"><i class="bi bi-file-pdf"></i> Nyomtatási nézet</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>


</div>

{% include 'worksheets/add/attachments/script_worksheet_attachments.html.twig' %}

{% include 'worksheets/add/signatures/script_worksheet_signatures.html.twig' %}

{% include 'worksheets/add/notifications/script_worksheet_notifications.html.twig' %}

{% include 'worksheets/add/script_index_main.html.twig' %}
