<script>
    function renderSignatures(){
        signatures = data_all?.worksheet?.data?.signatures ?? {};

        for (const [type, item] of Object.entries(signatures)) {
            target = $("[data-name='signature_preview'][data-type='"+item.type+"']");

            console.log(item.name);

            if(item.image != null){
                target.find("[data-name='image']").html(`<img src="${item.image}" height="100"/>`);
            }else{
                target.find("[data-name='image']").html(`<span class="text-xs">Nincs rögzített aláírás</span>`);
            }

            target.find("[data-name='signature_name']").html((item.name ?? null));

        }

    }


    $(document).ready(function(){
        renderSignatures();
    });

    $(`.btn[data-name='btnSignatureAdd']`).off("click.attachment").on("click.attachment", function (e) {
        //openWorksheetSignaturePopup($(this).attr("data-type"));
        signatureDataType = $(this).attr("data-type");
        localStorage.setItem("signatureDataType",signatureDataType);

        new Ajax({
            url: '{{ path('index_worksheet_signature_add') }}',
            name: 'index_worksheet_signature_add',
            type: 'GET',
            dataType: 'json',
            formData: formData,
            target: null,
            function_success: function (result) {
                html_footer = `
                        <div class="container-fluid p-0" data-box="${this.name}">
                            <div class="row">
                                <div class="col-12 text-end">
                                        <div class="btn btn-default btn-sm btn-success" data-name="alertify-save">Mentés</div>
                                        <div class="btn btn-default btn-sm btn-secondary" data-name="alertify-cancel">Mégse</div>
                                </div>
                            </div>
                        </div>
                `;


                let previousBodyOverflow = $("body").css("overflow");
                $("body").css("overflow", "hidden");

                function restoreSignaturePopupScroll() {
                    $("body").css("overflow", previousBodyOverflow);
                }

                alertify.popup("Aláírás", result.content).
                set("movable",false).
                set("closable",false).
                set('closableByEscape', false).

                set({transition:'zoom'}).
                set("onclose", restoreSignaturePopupScroll).
                set("resizable",false).
                setFooter(html_footer);




                $(`div[data-box="${this.name}"] .btn[data-name='alertify-cancel']`).unbind("click").click(function(){
                    alertify.popup().close();

                    localStorage.removeItem("signatureDataType");
                });

                $(`div[data-box="${this.name}"] .btn[data-name='alertify-save']`).unbind("click").click(function(){

                    signatureDataType = localStorage.getItem("signatureDataType");

                    const canvas = document.querySelector('[data-name="signature_canvas"]');
                    const signature = canvas.toDataURL('image/png');

                    data_all.worksheet = data_all.worksheet || {};
                    data_all.worksheet.data = data_all.worksheet.data || {};
                    data_all.worksheet.data.signatures = data_all.worksheet.data.signatures || {};

                    data_all.worksheet.data.signatures[signatureDataType] = {
                        'image': signature,
                        'type': signatureDataType,
                        'name' : $("[data-name='signature_popup'] [data-name='signature_name']").val()
                    };

                    //draw image use
                    renderSignatures();

                    alertify.popup().close();

                    localStorage.removeItem("signatureDataType");
                });
            },
            function_error: function (xhr) {
                const message = xhr.responseText || 'Nem sikerült betölteni az oldalt.';
                alertify.error(message);
            }
        }).send();


    });

</script>
