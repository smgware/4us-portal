<div data-name="signature_popup" data-type="">
    <div class="row">
        <div class="col-12">
            <canvas data-name="signature_canvas" style="width:100%;height:280px;border:1px solid #d8dde6;background:#fff;touch-action:none;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;"></canvas>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <span class="text-xs">Név</span><br>
            <input type="text" class="form-control" data-name="signature_name">
        </div>
        <div class="col-6 text-end">
            <div class="btn btn-default btn-sm" data-name="signature_clear">Törlés</div>
        </div>
    </div>
</div>

<script>


    function initializeSignatureCanvas() {
        const popups = document.querySelectorAll('[data-name="signature_popup"]');
        const popup = popups.length ? popups[popups.length - 1] : null;
        const canvas = popup && popup.querySelector('[data-name="signature_canvas"]');

        if (!canvas || canvas.getAttribute('data-drawing-initialized') === '1') {
            return;
        }

        canvas.setAttribute('data-drawing-initialized', '1');
        const context = canvas.getContext('2d');
        const pixelRatio = window.devicePixelRatio || 1;
        // A canvas alapértelmezett belső mérete 300x150, miközben CSS-ben
        // teljes szélességű. A belső felbontást hozzáigazítjuk a látható mérethez.
        const initialRect = canvas.getBoundingClientRect();
        canvas.width = Math.max(1, Math.round(initialRect.width * pixelRatio));
        canvas.height = Math.max(1, Math.round(initialRect.height * pixelRatio));

        context.lineWidth = 3 * pixelRatio;
        context.lineCap = "round";
        context.lineJoin = "round";
        context.strokeStyle = "#111";

        let drawing = false;
        let lastPoint = null;

        function getPoint(event) {
            const rect = canvas.getBoundingClientRect();

            // Az Alertify zoom transzformációja miatt mindig a pillanatnyi
            // képernyőméretet váltjuk át a canvas belső koordinátáira.
            return {
                x: (event.clientX - rect.left) * (canvas.width / rect.width),
                y: (event.clientY - rect.top) * (canvas.height / rect.height)
            };
        }

        function startDrawing(event) {
            if (event.preventDefault) {
                event.preventDefault();
            }
            drawing = true;
            lastPoint = getPoint(event);

            // Egyetlen érintés vagy kattintás is rajzoljon látható pontot.
            context.beginPath();
            context.arc(
                lastPoint.x,
                lastPoint.y,
                context.lineWidth / 2,
                0,
                Math.PI * 2
            );
            context.fillStyle = context.strokeStyle;
            context.fill();

            context.beginPath();
            context.moveTo(lastPoint.x, lastPoint.y);
        }

        function draw(event) {
            if (!drawing) {
                return;
            }

            if (event.preventDefault) {
                event.preventDefault();
            }
            const point = getPoint(event);
            context.lineTo(point.x, point.y);
            context.stroke();
            context.beginPath();
            context.moveTo(point.x, point.y);
            lastPoint = point;
        }

        function stopDrawing() {
            if (!drawing) {
                return;
            }

            drawing = false;
            lastPoint = null;
            context.beginPath();
        }

        function getTouch(event) {
            if (event.touches && event.touches.length > 0) {
                return event.touches[0];
            }

            return event.changedTouches && event.changedTouches[0];
        }

        // Az iOS Safarihoz külön touch eseményeket használunk. A passive:false
        // szükséges, hogy rajzolás közben az oldal ne scrollozzon.
        canvas.addEventListener('touchstart', function (event) {
            const touch = getTouch(event);
            if (touch) {
                startDrawing(touch);
                event.preventDefault();
            }
        }, {passive: false});

        canvas.addEventListener('touchmove', function (event) {
            const touch = getTouch(event);
            if (touch) {
                draw(touch);
                event.preventDefault();
            }
        }, {passive: false});

        canvas.addEventListener('touchend', function (event) {
            event.preventDefault();
            stopDrawing();
        }, {passive: false});
        canvas.addEventListener('touchcancel', stopDrawing, {passive: false});

        // Asztali egérkezelés.
        canvas.addEventListener('mousedown', startDrawing);
        canvas.addEventListener('mousemove', draw);
        window.addEventListener('mouseup', stopDrawing);

        const clearButton = popup.querySelector('[data-name="signature_clear"]');
        if (clearButton) {
            clearButton.addEventListener('click', function () {
                context.clearRect(0, 0, canvas.width, canvas.height);
            });
        }
    }

    // Az Alertify zoom animációjának befejezése után mérjük meg a canvast.
    // iPhone Safari alatt az animáció közbeni getBoundingClientRect pontatlan lehet.
    window.setTimeout(initializeSignatureCanvas, 350);


</script>
