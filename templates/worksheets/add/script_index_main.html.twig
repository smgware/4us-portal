
<script>
    (() => {
        var worksheetTypeSelect = $("select[data-name='worksheet_type']");
        var statusSelect = $("select[data-name='worksheet_status_type_id']");
        let selectedStatusTypeId = String({{ (item.worksheetStatusType ? item.worksheetStatusType.id : '')|json_encode|raw }} ?? '');
        var statusTypesFormData = new FormData();

        function showStatusMessage(message) {
            statusSelect
                .empty()
                .append($('<option>', { value: '', text: message }))
                .prop('disabled', true);
        }

        function renderStatusTypes(statusTypes) {
            statusSelect.empty();

            if (!Array.isArray(statusTypes) || statusTypes.length === 0) {
                showStatusMessage('Nincs beállított státusz');
                return;
            }

            let selectedStatusFound = false;

            statusTypes.forEach(function (statusType) {
                var statusTypeId = String(statusType.id ?? '');
                var isSelected = selectedStatusTypeId === statusTypeId;
                var option = $('<option>', {
                    value: statusTypeId,
                    text: statusType.title ?? statusType.code ?? statusTypeId,
                }).attr('data-code', statusType.code ?? '');

                if (isSelected) {
                    option.prop('selected', true);
                    selectedStatusFound = true;
                }

                statusSelect.append(option);
            });

            if (!selectedStatusFound) {
                statusSelect.prop('selectedIndex', 0);
            }

            statusSelect.prop('disabled', false);
            selectedStatusTypeId = String(statusSelect.val() ?? '');
        }

        var statusTypesRequest = new Ajax({
            url: '{{ path('list_worksheet_status_types_for_worksheet') }}',
            name: 'list_worksheet_status_types_for_worksheet',
            type: 'POST',
            dataType: 'json',
            formData: statusTypesFormData,
            function_prepare: function () {
                showStatusMessage('Státuszok betöltése...');
            },
            function_success: function (result) {
                if (!result.success) {
                    showStatusMessage('Nem sikerült betölteni');
                    alertify.error(result.data?.error || 'Nem sikerült betölteni a munkalap státuszokat.');
                    return;
                }

                renderStatusTypes(result.data?.status_types ?? []);
            },
            function_error: function (xhr, status) {
                if (status === 'abort') {
                    return;
                }

                showStatusMessage('Nem sikerült betölteni');
                alertify.error(xhr.responseJSON?.data?.error || 'Nem sikerült betölteni a munkalap státuszokat.');
            }
        });

        function loadStatusTypes(worksheetTypeId, preserveCurrentSelection) {
            if (preserveCurrentSelection) {
                selectedStatusTypeId = String(statusSelect.val() ?? '');
            }

            if (!worksheetTypeId) {
                showStatusMessage('Válassz munkalap típust');
                return;
            }

            if (statusTypesRequest.ajax && statusTypesRequest.ajax.readyState !== 4) {
                statusTypesRequest.ajax.abort();
            }

            statusTypesRequest.formData.set('filters', JSON.stringify({
                worksheet_type_id: worksheetTypeId,
            }));
            statusTypesRequest.send();
        }

        loadStatusTypes(worksheetTypeSelect.val(), false);

        worksheetTypeSelect
            .off('change.worksheetStatusTypes')
            .on('change.worksheetStatusTypes', function () {
                loadStatusTypes($(this).val(), true);
            });

        function initWorksheetCombobox(options) {
            const root = $("[data-worksheet-combobox='" + options.type + "']");
            if (!root.length) {
                return;
            }

            const searchInput = root.find("[data-name='" + options.searchName + "']");
            const idInput = root.find("[data-name='" + options.idName + "']");
            const results = root.find("[data-name='combobox-results']");
            const clearButton = root.find("[data-name='combobox-clear']");
            const formData = new FormData();
            const eventNamespace = '.worksheet' + options.type.charAt(0).toUpperCase() + options.type.slice(1) + 'Combobox';
            const trimValue = value => String(value ?? '').trim();
            let selectedLabel = trimValue(searchInput.val());
            let searchTimer = null;

            function openResults() {
                results.removeClass('d-none');
                searchInput.attr('aria-expanded', 'true');
            }

            function closeResults() {
                results.addClass('d-none');
                searchInput.attr('aria-expanded', 'false');
            }

            function showMessage(message) {
                results
                    .empty()
                    .append($('<div>', {
                        class: 'px-3 py-2 text-muted text-sm',
                        text: message
                    }));
                openResults();
            }

            const previousRequest = ajaxquery?.[options.requestName]?.ajax;
            if (previousRequest && previousRequest.readyState !== 4) {
                previousRequest.abort();
            }

            const request = new Ajax({
                url: options.url,
                name: options.requestName,
                type: 'POST',
                dataType: 'json',
                formData: formData,
                function_prepare: function () {
                    showMessage('Keresés...');
                },
                function_success: function (result) {
                    if (!result.success) {
                        showMessage(result.data?.error || 'A találatok nem tölthetők be.');
                        return;
                    }

                    results.html(result.content || '');
                    if (!trimValue(results.html())) {
                        showMessage('Nincs találat.');
                        return;
                    }

                    openResults();
                },
                function_error: function (xhr, status) {
                    if (status === 'abort') {
                        return;
                    }

                    showMessage(xhr.responseJSON?.data?.error || 'A keresés nem sikerült.');
                }
            });

            function sendSearch() {
                if (request.ajax && request.ajax.readyState !== 4) {
                    request.ajax.abort();
                }

                formData.set('filters', JSON.stringify({
                    search: trimValue(searchInput.val())
                }));
                request.send();
            }

            function queueSearch(delay) {
                window.clearTimeout(searchTimer);
                searchTimer = window.setTimeout(sendSearch, delay ?? 250);
            }

            function selectOption(option) {
                const id = String(option.attr('data-select-id') ?? '');
                const label = String(option.attr('data-select-label') ?? '');

                window.clearTimeout(searchTimer);
                if (request.ajax && request.ajax.readyState !== 4) {
                    request.ajax.abort();
                }

                idInput.val(id).trigger('change');
                searchInput.val(label);
                selectedLabel = label;
                closeResults();
            }

            searchInput
                .off(eventNamespace)
                .on('focus' + eventNamespace, function () {
                    queueSearch(0);
                })
                .on('keyup' + eventNamespace, function (event) {
                    if (event.key === 'Escape') {
                        closeResults();
                        return;
                    }

                    if (event.key === 'Enter') {
                        const firstOption = results.find('[data-select-id]').first();
                        if (firstOption.length) {
                            selectOption(firstOption);
                        }
                        return;
                    }

                    if (['ArrowDown', 'ArrowUp', 'Tab', 'Shift', 'Control', 'Alt', 'Meta'].includes(event.key)) {
                        return;
                    }

                    if (trimValue(searchInput.val()) !== selectedLabel && idInput.val() !== '') {
                        idInput.val('').trigger('change');
                    }

                    queueSearch(250);
                })
                .on('keydown' + eventNamespace, function (event) {
                    if (event.key !== 'ArrowDown') {
                        return;
                    }

                    const firstOption = results.find('[data-select-id]').first();
                    if (firstOption.length) {
                        event.preventDefault();
                        firstOption.trigger('focus');
                    }
                });

            results
                .off(eventNamespace)
                .on('mousedown' + eventNamespace, '[data-select-id]', function (event) {
                    event.preventDefault();
                    selectOption($(this));
                })
                .on('keydown' + eventNamespace, '[data-select-id]', function (event) {
                    const optionsList = results.find('[data-select-id]');
                    const currentIndex = optionsList.index(this);

                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        selectOption($(this));
                    } else if (event.key === 'ArrowDown' && currentIndex < optionsList.length - 1) {
                        event.preventDefault();
                        optionsList.eq(currentIndex + 1).trigger('focus');
                    } else if (event.key === 'ArrowUp') {
                        event.preventDefault();
                        if (currentIndex > 0) {
                            optionsList.eq(currentIndex - 1).trigger('focus');
                        } else {
                            searchInput.trigger('focus');
                        }
                    } else if (event.key === 'Escape') {
                        closeResults();
                        searchInput.trigger('focus');
                    }
                });

            clearButton
                .off(eventNamespace)
                .on('click' + eventNamespace, function () {
                    selectedLabel = '';
                    idInput.val('').trigger('change');
                    searchInput.val('').trigger('focus');
                    queueSearch(0);
                });

            $(document)
                .off('mousedown' + eventNamespace)
                .on('mousedown' + eventNamespace, function (event) {
                    if (!$(event.target).closest(root).length) {
                        closeResults();
                    }
                });
        }

        initWorksheetCombobox({
            type: 'partner',
            searchName: 'partner_search',
            idName: 'partner_id',
            requestName: 'list_worksheet_partner_select_list',
            url: '{{ path('list_worksheet_partner_select_list') }}'
        });

        initWorksheetCombobox({
            type: 'machine',
            searchName: 'machine_search',
            idName: 'machine_id',
            requestName: 'list_worksheet_machine_select_list',
            url: '{{ path('list_worksheet_machine_select_list') }}'
        });


    //BUTTON EVENTS
        $("[data-name='btnAddConditionImage']").off("click.attachment").on("click.attachment", function (e) {
            $("[data-name='btnAddAttachments']")
                .data('attachmentDescription', $(this).closest("[data-name='condition_image_slot']").attr("data-description"))
                .data('isConditionImage', true)
                .trigger('click');
        });

    //SAVE EVENT
        const attachmentOperations = ['add', 'update', 'delete'];
        let worksheetSaveInProgress = false;

        function getAttachmentOperation(attachment) {
            const dataOperation = String(attachment?.data?.function ?? '').toLowerCase();
            if (attachmentOperations.includes(dataOperation)) {
                return dataOperation;
            }

            const legacyOperation = String(attachment?.function ?? '').toLowerCase();
            return attachmentOperations.includes(legacyOperation) ? legacyOperation : '';
        }

        function normalizePercentage(value) {
            return Math.max(0, Math.min(100, Number(value) || 0));
        }

        function uploadWorksheetAttachmentsProgress(pendingAttachments, currentAttachment) {
            if (!pendingAttachments.length) {
                return;
            }

            const percentageSum = pendingAttachments.reduce(function (sum, attachment) {
                return sum + normalizePercentage(attachment?.data?.percentage);
            }, 0);
            const averagePercentage = Math.round(percentageSum / pendingAttachments.length);
            const currentPercentage = normalizePercentage(currentAttachment?.data?.percentage);
            const popup = $("[data-box='worksheetAttachmentUpload']");

            popup.find("[data-name='upload-percentage-all']").text(averagePercentage + '%');
            popup.find("[data-name='upload-progress-all']")
                .css('width', averagePercentage + '%')
                .attr('aria-valuenow', averagePercentage);
            popup.find("[data-name='upload-current-name']").text(currentAttachment?.name || 'Csatolmány feldolgozása');
            popup.find("[data-name='upload-percentage-current']").text(Math.round(currentPercentage) + '%');
            popup.find("[data-name='upload-progress-current']")
                .css('width', currentPercentage + '%')
                .attr('aria-valuenow', currentPercentage);
        }

        function openAttachmentUploadPopup(pendingAttachments) {
            const html = `
                <div class="container-fluid py-3" data-box="worksheetAttachmentUpload">
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-between mb-1">
                                <span>Összesített állapot</span>
                                <strong data-name="upload-percentage-all">0%</strong>
                            </div>
                            <div class="progress" style="height:10px;">
                                <div class="progress-bar" data-name="upload-progress-all" role="progressbar" style="width:0%;" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
                            </div>
                        </div>
                        <div class="col-12 mt-3">
                            <div class="text-truncate mb-1" data-name="upload-current-name"></div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>Aktuális csatolmány</span>
                                <strong data-name="upload-percentage-current">0%</strong>
                            </div>
                            <div class="progress" style="height:10px;">
                                <div class="progress-bar bg-info" data-name="upload-progress-current" role="progressbar" style="width:0%;" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
                            </div>
                            <div class="text-muted text-xs mt-2">${pendingAttachments.length} csatolmány feldolgozása</div>
                        </div>
                    </div>
                </div>
            `;

            alertify.popup('Csatolmányok feldolgozása', html)
                .set('closable', false)
                .set('closableByEscape', false)
                .set('movable', false)
                .set('resizable', false);
        }

        function closeAttachmentUploadPopup() {
            if ($("[data-box='worksheetAttachmentUpload']").length) {
                alertify.popup().close();
            }
        }

        function applyAttachmentResponse(attachment, operation, result) {
            if (operation === 'delete') {
                data_all.attachments = data_all.attachments.filter(item => item !== attachment);
                return;
            }

            const savedAttachment = result.data?.attachment;
            if (!savedAttachment?.id) {
                throw new Error('A szerver nem adta vissza a mentett csatolmány azonosítóját.');
            }

            attachment.id = savedAttachment.id;
            attachment.name = savedAttachment.name ?? attachment.name;
            attachment.description = savedAttachment.description ?? null;
            attachment.data = $.extend(true, {}, savedAttachment.data || {}, {
                attachmentType: 'exists',
                function: '',
                percentage: 100
            });
            delete attachment.file;
            delete attachment.function;
        }

        function uploadWorksheetAttachment(attachment, pendingAttachments) {
            return new Promise(function (resolve, reject) {
                const operation = getAttachmentOperation(attachment);
                const attachmentFormData = new FormData();

                attachment.data = attachment.data || {};
                attachment.data.function = operation;
                attachmentFormData.append('id', attachment.id ?? '');
                attachmentFormData.append('worksheet_id', data_all.worksheet.id);
                attachmentFormData.append('function', operation);
                attachmentFormData.append('data', JSON.stringify({
                    id: attachment.id ?? null,
                    name: attachment.name ?? '',
                    description: attachment.description ?? null,
                    data: attachment.data
                }));

                if (attachment.file instanceof Blob) {
                    attachmentFormData.append('file', attachment.file, attachment.name || attachment.file.name);
                }

                uploadWorksheetAttachmentsProgress(pendingAttachments, attachment);

                $.ajax({
                    url: '{{ path('save_worksheets_attachment') }}',
                    type: 'POST',
                    dataType: 'json',
                    timeout: 800000,
                    processData: false,
                    contentType: false,
                    data: attachmentFormData,
                    xhr: function () {
                        const xhr = $.ajaxSettings.xhr();

                        if (xhr.upload) {
                            xhr.upload.addEventListener('progress', function (event) {
                                if (!event.lengthComputable) {
                                    return;
                                }

                                attachment.data.percentage = Math.min(99, Math.round((event.loaded / event.total) * 100));
                                uploadWorksheetAttachmentsProgress(pendingAttachments, attachment);
                            });
                        }

                        return xhr;
                    },
                    success: function (result) {
                        if (!result.success) {
                            reject(new Error(result.data?.error || 'Nem sikerült feldolgozni a csatolmányt.'));
                            return;
                        }

                        attachment.data.percentage = 100;

                        try {
                            applyAttachmentResponse(attachment, operation, result);
                            uploadWorksheetAttachmentsProgress(pendingAttachments, attachment);
                            resolve(result);
                        } catch (error) {
                            reject(error);
                        }
                    },
                    error: function (xhr) {
                        reject(new Error(xhr.responseJSON?.data?.error || 'Nem sikerült feldolgozni a csatolmányt.'));
                    }
                });
            });
        }

        uploadWorksheetAttachments = function() {
            data_all.attachments = Array.isArray(data_all.attachments) ? data_all.attachments : [];

            const pendingAttachments = data_all.attachments.filter(function (attachment) {
                return getAttachmentOperation(attachment) !== '';
            });
            const cntUploadAttachments = pendingAttachments.length;

            if (cntUploadAttachments === 0) {
                return Promise.resolve([]);
            }
            if (!data_all?.worksheet?.id) {
                return Promise.reject(new Error('A csatolmányok mentéséhez hiányzik a munkalap azonosítója.'));
            }

            for (const attachment of pendingAttachments) {
                const operation = getAttachmentOperation(attachment);
                const hasFile = attachment.file instanceof Blob;
                const maxAttachmentFileSize = Number(data_all?.options?.max_attachment_file_size) || 268435456;

                if (operation === 'add' && !hasFile) {
                    return Promise.reject(new Error('A(z) "' + (attachment.name || 'csatolmány') + '" fájlja hiányzik.'));
                }
                if (hasFile && attachment.file.size > maxAttachmentFileSize) {
                    return Promise.reject(new Error(
                        'A(z) "' + (attachment.name || 'csatolmány') + '" fájl túl nagy. A maximum 256 MB.'
                    ));
                }
                if (operation !== 'add' && !/^\d+$/.test(String(attachment.id ?? ''))) {
                    return Promise.reject(new Error('A(z) "' + (attachment.name || 'csatolmány') + '" azonosítója érvénytelen.'));
                }

                attachment.data = attachment.data || {};
                attachment.data.function = operation;
                attachment.data.percentage = 0;
                delete attachment.function;
            }

            openAttachmentUploadPopup(pendingAttachments);
            uploadWorksheetAttachmentsProgress(pendingAttachments, pendingAttachments[0]);

            let uploadSequence = Promise.resolve();
            pendingAttachments.forEach(function (attachment) {
                uploadSequence = uploadSequence.then(function () {
                    return uploadWorksheetAttachment(attachment, pendingAttachments);
                });
            });

            return uploadSequence
                .then(function () {
                    closeAttachmentUploadPopup();
                    return pendingAttachments;
                })
                .catch(function (error) {
                    closeAttachmentUploadPopup();
                    throw error;
                });
        };

        function reloadWorksheetsList() {
            if (ajaxquery?.['list_worksheets']) {
                ajaxquery['list_worksheets'].send();
            }
        }

        saveWorksheetData = function() {
            if (worksheetSaveInProgress) {
                return Promise.resolve(false);
            }

            const btnAlertifySave = $(`div[data-box="worksheet_add"] .btn[data-name='alertify-save']`);
            worksheetSaveInProgress = true;
            btnAlertifySave.addClass('disabled');

            data_all = data_all || {};
            data_all.worksheet = data_all.worksheet || {};

            const worksheet = $.extend(true, {}, data_all.worksheet);
            worksheet.data = worksheet.data || {};
            delete worksheet.temp_data;
            delete worksheet.status;

            worksheet.title = ($("[data-name='worksheet_title']").val() || '').trim();
            worksheet.worksheet_type_id = worksheetTypeSelect.val();
            worksheet.worksheet_status_type_id = statusSelect.val();
            worksheet.partner_id = $("[data-name='partner_id']").val() || null;
            worksheet.data.machine_id = $("[data-name='machine_id']").val() || null;

            $("[data-group='worksheet.data']").each(function () {
                const field = $(this);
                worksheet.data[field.attr('data-name')] = field.is(':checkbox') ? field.is(':checked') : field.val();
            });

            const saveData = {
                worksheet: worksheet,
                contacts: Array.isArray(data_all.contacts) ? data_all.contacts : []
            };
            const worksheetFormData = new FormData();
            worksheetFormData.append('data', JSON.stringify(saveData));

            const worksheetRequest = new Promise(function (resolve, reject) {
                const request = new Ajax({
                    url: '{{ path('save_worksheets') }}',
                    name: 'save_worksheets',
                    type: 'POST',
                    dataType: 'json',
                    formData: worksheetFormData,
                    function_success: function (result) {
                        if (!result.success) {
                            reject(new Error(result.data?.error || 'Nem sikerült menteni a munkalapot.'));
                            return;
                        }

                        resolve(result);
                    },
                    function_error: function (xhr) {
                        reject(new Error(xhr.responseJSON?.data?.error || 'Nem sikerült menteni a munkalapot.'));
                    }
                });

                request.send();
            });

            return worksheetRequest
                .then(function (result) {
                    const worksheetId = result.data?.worksheet_id ?? result.data?.id ?? result.data?.worksheet?.id;
                    if (!worksheetId) {
                        throw new Error('A szerver nem adta vissza a munkalap azonosítóját.');
                    }

                    data_all.worksheet = $.extend(true, {}, data_all.worksheet, result.data?.worksheet || {});
                    data_all.worksheet.id = worksheetId;
                    $("[data-name='worksheet_code']").text(data_all.worksheet.code || '');

                    return uploadWorksheetAttachments();
                })
                .then(function () {
                    reloadWorksheetsList();
                    alertify.success('A munkalap mentése sikerült.');

                    let worksheetTypeId = data_all.worksheet.worksheet_type_id;
                    let worksheet_status_type_id = data_all.worksheet.worksheet_status_type_id;
                    let code_worksheet_type = $("select[data-name='worksheet_type'] option[value='"+data_all.worksheet.worksheet_type_id+"']").attr("data-code");

                    let code_worksheet_status_type = $("select[data-name='worksheet_status_type_id'] option:selected").attr("data-code");

                    if(code_worksheet_type == "MACHINE_RETURN" && code_worksheet_status_type == "CLOSED"){
                        alertify.confirm("Kérdés", "Szeretne 'Visszavételkor feltárt problémák' munkalapot létrehozni? ",
                            ()=>{
                                    alertify.success("Munkalap létrehozva");
                                    alertify.sheet().close();
                            },
                            ()=>{

                            },
                        )
                    }else{
                        alertify.sheet().close();
                    }


                    return true;
                })
                .catch(function (error) {
                    alertify.error(error?.message || 'Nem sikerült menteni a munkalapot.');
                    return false;
                })
                .finally(function () {
                    worksheetSaveInProgress = false;
                    btnAlertifySave.removeClass('disabled');
                });
        };

    })();
</script>
