{% extends '../base.html.twig' %}
{% block body %}
<div class="page-title"><i class="bi bi-tags"></i> Gepkategoriak</div>

<div class="container-fluid p-0">
    <div class="row">
        <div class="col-12">
            <div class="card panel-card p-2">
                <div class="row">
                    <div class="col-5"><input type="text" class="form-control" placeholder="Kereses..." /></div>
                    <div class="col-7">
                        <div class="row">
                            <div class="col-12 text-end">
                                <div class="btn btn-default btn-sm" data-name="btn_index_machine_categories_filter"><i class="bi bi-filter-circle-fill"></i> Szűrők</div>
                                <div class="btn btn-default btn-sm" data-name="btn_index_machine_categories_add"><i class="bi bi-plus-circle-fill"></i> Uj hozzaadasa</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="row mt-3">
        <div class="col-12">
            <div class="card panel-card p-2">
                <div class="row">
                   <div class="col-12" data-name="list_machine_categories"></div>
                </div>
            </div>
        </div>
    </div>

</div>


<script>

    let formData = new FormData();
    formData.set('filters', '{}');

    new Ajax({
        url: '{{ path('list_machine_categories') }}',
        name: 'list_machine_categories',
        type: 'GET',
        dataType: 'html',
        formData: formData,
        target: $('[data-name="list_machine_categories"]'),
        function_success: function (result) {
            this.target.html(result.content);


        },
        function_error: function (xhr) {
            const message = xhr.responseText || 'Nem sikerült betölteni az oldalt.';
            alertify.error(message);
        }
    }).send();

</script>
{% endblock %}
