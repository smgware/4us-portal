{% extends 'base.html.twig' %}

{% block title %}Everlink eventlog{% endblock %}

{% block body %}
    <style>
        .eventlog-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 16px;
        }

        .eventlog-table th,
        .eventlog-table td {
            border: 1px solid #d1d5db;
            padding: 6px 8px;
            text-align: left;
            font-size: 13px;
        }

        .eventlog-table th {
            background: #f3f4f6;
        }

        .pagination {
            display: inline-flex;
            align-items: center;
            gap: 2px;
            background: #2f3439;
            padding: 4px;
            margin-top: 18px;
        }

        .pagination__item {
            display: inline-block;
            min-width: 18px;
            padding: 7px 8px;
            background: #c8ccd0;
            color: #111;
            text-align: center;
            text-decoration: none;
            font-size: 13px;
            line-height: 1;
        }

        .pagination__item--active {
            background: #f07800;
            color: #fff;
            font-weight: bold;
        }

        .pagination__item--dots {
            cursor: default;
        }
    </style>

    <h1>Everlink eventlog</h1>

    <p>
        Összes rekord: {{ totalRecords }} |
        Oldal: {{ page }} / {{ totalPages }} |
        {{ itemsPerPage }} elem oldalanként
    </p>

    {% include 'partials/_pagination.html.twig' with {
        currentPage: page,
        totalPages: totalPages
    } %}

    {% if records is empty %}
        <p>Nincs megjeleníthető rekord.</p>
    {% else %}
        <table class="eventlog-table">
            <thead>
                <tr>
                    {% for column, value in records|first %}
                        <th>{{ column }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for record in records %}
                    <tr>
                        {% for value in record %}
                            <td>{{ value }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% include 'partials/_pagination.html.twig' with {
        currentPage: page,
        totalPages: totalPages
    } %}
{% endblock %}
