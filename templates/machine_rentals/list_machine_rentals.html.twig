<div class="card panel-card w-100 overflow-auto p-2">
    <div class="d-flex justify-content-between align-items-center px-1 pb-2">
        <span class="small text-muted">{{ totalRecords }} kölcsönzés</span>
    </div>

    <div class="table-responsive">
        <table class="table-default w-100">
            <thead>
                <tr>
                    <th class="p-2">Kód</th>
                    <th class="p-2">Partner</th>
                    <th class="p-2">Projekt</th>
                    <th class="p-2">Gép</th>
                    <th class="p-2">Gépkód</th>
                    <th class="p-2">Bérlés kezdete</th>
                    <th class="p-2">Bérlés vége (tervezett)</th>
                    <th class="p-2">Státusz</th>
                    <th class="p-2 text-end">Műveletek</th>
                </tr>
            </thead>
            <tbody>
                {% for record in records %}
                    <tr data-rental-id="{{ record.id }}">
                        <td class="p-2 fw-semibold">{{ record.code|default('-') }}</td>
                        <td class="p-2">
                            {{ record.partner_name|default('-') }}
                            {% if record.partner_code %}<div class="text-muted text-xs">{{ record.partner_code }}</div>{% endif %}
                        </td>
                        <td class="p-2">
                            {{ record.project_name|default('-') }}
                            {% if record.project_code %}<div class="text-muted text-xs">{{ record.project_code }}</div>{% endif %}
                        </td>
                        <td class="p-2">
                            {{ record.machine_title|default('-') }}
                            {% if record.machine_category_title %}<div class="text-muted text-xs">{{ record.machine_category_title }}</div>{% endif %}
                        </td>
                        <td class="p-2">{{ record.machine_code|default('-') }}</td>
                        <td class="p-2">{{ record.datetime_rental_start ? record.datetime_rental_start|date('Y-m-d H:i') : '-' }}</td>
                        <td class="p-2">{{ record.datetime_rental_end ? record.datetime_rental_end|date('Y-m-d H:i') : '-' }}</td>
                        <td class="p-2">
                            {% if record.list_status == '1' %}
                                <span class="badge text-bg-success">Nyitott</span>
                            {% else %}
                                <span class="badge text-bg-secondary">Lezárt</span>
                            {% endif %}
                        </td>
                        <td class="p-2 text-end text-nowrap">
                            <button
                                type="button"
                                class="btn btn-default btn-sm text-warning"
                                title="Átadási munkalap"
                                data-machine-rental-action="worksheet"
                                data-worksheet-id="{{ record.handover_worksheet_id|default('') }}"
                                {{ record.handover_worksheet_id|default(null) ? '' : 'disabled' }}
                            ><i class="bi bi-arrow-left-right"></i></button>
                            <button
                                type="button"
                                class="btn btn-default btn-sm text-warning"
                                title="Visszavételi munkalap"
                                data-machine-rental-action="worksheet"
                                data-worksheet-id="{{ record.return_worksheet_id|default('') }}"
                                {{ record.return_worksheet_id|default(null) ? '' : 'disabled' }}
                            ><i class="bi bi-arrow-return-left"></i></button>
                            <button
                                type="button"
                                class="btn btn-default btn-sm text-warning"
                                title="Módosítás"
                                data-machine-rental-action="edit"
                                data-rental-id="{{ record.id }}"
                            ><i class="bi bi-pencil-square"></i></button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">Nincs megjeleníthető gépkölcsönzés.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'partials/_pagination.html.twig' with {
        currentPage: page,
        totalPages: totalPages,
        routeName: 'list_machine_rentals',
        queryParams: {}
    } %}
</div>
