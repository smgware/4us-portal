<form action="" data-name="machine_rental" novalidate>
    <input type="hidden" name="id" data-name="id" value="{{ item ? item.id : '' }}">

    {% if item %}
        <div class="mb-3">
            <label class="form-label" for="machine-rental-code">Kód</label>
            <input id="machine-rental-code" type="text" class="form-control" value="{{ item.code }}" readonly>
        </div>
    {% endif %}

    <div class="mb-3">
        <label class="form-label" for="machine-rental-partner-search">Partner <span class="text-danger">*</span></label>
        <div class="ajax-combobox" data-machine-rental-combobox="partner">
            <div class="input-group">
                <input
                    id="machine-rental-partner-search"
                    type="text"
                    class="form-control"
                    value="{{ item and item.partner ? item.partner.name : '' }}"
                    placeholder="Partner keresése név, kód vagy adószám alapján..."
                    autocomplete="off"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-controls="machine-rental-partner-results"
                    aria-expanded="false"
                    data-ajax-combobox-search
                >
                <button type="button" class="btn btn-outline-secondary" data-ajax-combobox-clear aria-label="Partner kiválasztásának törlése">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <input type="hidden" name="partner_id" value="{{ item and item.partner ? item.partner.id : '' }}" data-ajax-combobox-value>
            <div id="machine-rental-partner-results" class="ajax-combobox__results list-group shadow-sm d-none" role="listbox" data-ajax-combobox-results></div>
        </div>
        {% if item and item.partner and item.partner.status != '1' %}
            <div class="form-text text-warning"><i class="bi bi-exclamation-triangle"></i> A jelenlegi partner inaktív. Másik értékre cserélhető, újból nem választható ki.</div>
        {% endif %}
    </div>

    <div class="mb-3">
        <label class="form-label" for="machine-rental-machine-search">Gép <span class="text-danger">*</span></label>
        <div class="ajax-combobox" data-machine-rental-combobox="machine">
            <div class="input-group">
                <input
                    id="machine-rental-machine-search"
                    type="text"
                    class="form-control"
                    value="{{ item and item.machine ? item.machine.title : '' }}"
                    placeholder="Gép keresése név, kód vagy kategória alapján..."
                    autocomplete="off"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-controls="machine-rental-machine-results"
                    aria-expanded="false"
                    data-ajax-combobox-search
                >
                <button type="button" class="btn btn-outline-secondary" data-ajax-combobox-clear aria-label="Gép kiválasztásának törlése">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <input type="hidden" name="machine_id" value="{{ item and item.machine ? item.machine.id : '' }}" data-ajax-combobox-value>
            <div id="machine-rental-machine-results" class="ajax-combobox__results list-group shadow-sm d-none" role="listbox" data-ajax-combobox-results></div>
        </div>
        {% if item and item.machine and item.machine.status != '1' %}
            <div class="form-text text-warning"><i class="bi bi-exclamation-triangle"></i> A jelenlegi gép inaktív. Másik értékre cserélhető, újból nem választható ki.</div>
        {% endif %}
    </div>

    <div class="mb-3">
        <label class="form-label" for="machine-rental-project-search">Projekt</label>
        <div class="ajax-combobox" data-machine-rental-combobox="project">
            <div class="input-group">
                <input
                    id="machine-rental-project-search"
                    type="text"
                    class="form-control"
                    value="{{ item and item.project ? item.project.name : '' }}"
                    placeholder="Projekt keresése név vagy kód alapján..."
                    autocomplete="off"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-controls="machine-rental-project-results"
                    aria-expanded="false"
                    data-ajax-combobox-search
                >
                <button type="button" class="btn btn-outline-secondary" data-ajax-combobox-clear aria-label="Projekt kiválasztásának törlése">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <input type="hidden" name="project_id" value="{{ item and item.project ? item.project.id : '' }}" data-ajax-combobox-value>
            <div id="machine-rental-project-results" class="ajax-combobox__results list-group shadow-sm d-none" role="listbox" data-ajax-combobox-results></div>
        </div>
        {% if item and item.project and item.project.status != '1' %}
            <div class="form-text text-warning"><i class="bi bi-exclamation-triangle"></i> A jelenlegi projekt inaktív. Másik értékre cserélhető, újból nem választható ki.</div>
        {% endif %}
    </div>

    <div class="row g-3">
        <div class="col-lg-6 col-12">
            <label class="form-label" for="machine-rental-start">Bérlés kezdete <span class="text-danger">*</span></label>
            <input
                id="machine-rental-start"
                type="datetime-local"
                class="form-control"
                name="datetime_rental_start"
                value="{{ item and item.datetimeRentalStart ? item.datetimeRentalStart|date('Y-m-d\\TH:i') : 'now'|date('Y-m-d\\TH:i') }}"
                required
            >
        </div>
        <div class="col-lg-6 col-12">
            <label class="form-label" for="machine-rental-end">Bérlés vége (tervezett)</label>
            <input
                id="machine-rental-end"
                type="datetime-local"
                class="form-control"
                name="datetime_rental_end"
                value="{{ item and item.datetimeRentalEnd ? item.datetimeRentalEnd|date('Y-m-d\\TH:i') : '' }}"
            >
        </div>
    </div>

    {% if item %}
        <div class="mt-3">
            <label class="form-label" for="machine-rental-status">Állapot</label>
            <select id="machine-rental-status" class="form-select" name="status">
                <option value="1" {{ item.status == '1' ? 'selected' }}>Nyitott</option>
                <option value="0" {{ item.status == '0' ? 'selected' }}>Lezárt</option>
            </select>
        </div>

        <div class="mt-4 d-flex flex-wrap gap-2">
            <button
                type="button"
                class="btn btn-default btn-sm text-warning"
                data-name="btn_inner_show_worksheet"
                data-worksheet-id="{{ worksheetIds.MACHINE_HANDOVER|default('') }}"
                {{ worksheetIds.MACHINE_HANDOVER|default(null) ? '' : 'disabled' }}
            >
                <i class="bi bi-arrow-left-right"></i> Átadási munkalap
            </button>
            <button
                type="button"
                class="btn btn-default btn-sm text-warning"
                data-name="btn_inner_show_worksheet"
                data-worksheet-id="{{ worksheetIds.MACHINE_RETURN|default('') }}"
                {{ worksheetIds.MACHINE_RETURN|default(null) ? '' : 'disabled' }}
            >
                <i class="bi bi-arrow-return-left"></i> Visszavételi munkalap
            </button>
        </div>
    {% endif %}
</form>
