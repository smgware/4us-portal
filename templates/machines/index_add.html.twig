{% set itemData = item and item.data ? item.data : {} %}

<form action="" data-name="machine">
    <input type="hidden" name="id" data-name="id" value="{{ item ? item.id : '' }}">

    <div class="mb-3">
        <label for="" class="form-label">Név</label>
        <input type="text" class="form-control" name="name" data-name="name" value="{{ item ? item.title : '' }}" placeholder="Add meg a gep nevet">
    </div>

    <div class="mb-3">
        <label for="machine-code" class="form-label">Kód</label>
        <input type="text" class="form-control" id="machine-code" name="code" data-name="code" value="{{ item ? item.code : '' }}" placeholder="Add meg a kódot">
    </div>

    <div class="mb-3">
        <label for="machine-serial-number" class="form-label">Gyári szám</label>
        <input
            type="text"
            class="form-control"
            id="machine-serial-number"
            name="data[sku]"
            data-name="sku"
            value="{{ itemData.sku|default('') }}"
            maxlength="255"
            placeholder="Add meg a gyári számot"
        >
    </div>

    <div class="mb-3">
        <label for="machine-year" class="form-label">Évjárat</label>
        <input
            type="text"
            inputmode="numeric"
            class="form-control"
            id="machine-year"
            name="data[year]"
            data-name="year"
            value="{{ itemData.year|default('') }}"
            maxlength="4"
            placeholder="Add meg az évjáratot"
        >
    </div>

    <div class="mb-3">
        <label for="" class="form-label">Gép kategória</label>
        <select class="form-control" name="machine_category_id" data-name="machine_category_id" required>
            <option value="">Válassz kategóriát</option>
            {% for category in categories %}
                <option value="{{ category.id }}" {{ item and item.machineCategory and item.machineCategory.id == category.id ? 'selected' }}>
                    {{ category.title }} ({{ category.code }})
                </option>
            {% endfor %}
        </select>
    </div>

    <div class="mb-3">
        <label for="machine-company-site" class="form-label">Telephely</label>
        <select id="machine-company-site" class="form-control" name="company_site_id" data-name="company_site_id" required>
            <option value="">Válassz telephelyet</option>
            {% for companySite in companySites %}
                <option value="{{ companySite.id }}" {{ item and item.companySite and item.companySite.id == companySite.id ? 'selected' }}>
                    {{ companySite.title }}{% if companySite.code %} ({{ companySite.code }}){% endif %}{% if companySite.status != '1' %} – inaktív{% endif %}
                </option>
            {% endfor %}
        </select>
    </div>

    <div class="mb-3">
        <label for="" class="form-label">Státusz</label>
        <select class="form-control" name="status" data-name="status">
            <option value="1" {{ item is null or item.status == '1' ? 'selected' }}>Aktív</option>
            <option value="0" {{ item and item.status == '0' ? 'selected' }}>Inaktív</option>
        </select>
    </div>
</form>
