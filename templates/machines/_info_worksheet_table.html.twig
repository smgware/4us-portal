<div class="table-responsive">
    <table class="table-default w-100">
        <thead>
            <tr>
                <th class="p-2">Kód</th>
                <th class="p-2">Gépkölcsönzés</th>
                <th class="p-2">Típus</th>
                <th class="p-2">Megnevezés</th>
                <th class="p-2">Partner</th>
                <th class="p-2">Létrehozva</th>
                <th class="p-2">Állapot</th>
            </tr>
        </thead>
        <tbody>
            {% for record in records %}
                <tr>
                    <td>{{ record.code|default('-') }}</td>
                    <td>{{ record.rental_code|default(record.data.machine_rental_code|default('-')) }}</td>
                    <td>{{ record.worksheet_type_title|default('-') }}</td>
                    <td>{{ record.title|default('-') }}</td>
                    <td>{{ record.partner_name|default('-') }}</td>
                    <td>{{ record.datetime_add ? record.datetime_add|date('Y-m-d H:i') : '-' }}</td>
                    <td>
                        {% include 'worksheets/_status_badge.html.twig' with {
                            statusCode: record.worksheet_status_type_code,
                            statusTitle: record.worksheet_status_type_title
                        } only %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center py-3 text-muted">Nincsenek előzmények </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
