{% extends 'base.html.twig' %}
{% block body %}
<div class="page-title"><i class="bi bi-gear"></i> Beállítások</div>

<div class="container-fluid p-0">
    <div class="row">
        <div class="col-12">
            <div class="btn btn-default btn-sm mb-2" data-name="btn_main_settings_users"><i class="bi bi-person"></i> Felhasználók</div>
            <div class="btn btn-default btn-sm mb-2" data-name="btn_main_settings_permissions"><i class="bi bi-person-lock"></i> Jogosultságok</div>
            <div class="btn btn-default btn-sm mb-2" data-name="btn_main_settings_machine_categories"><i class="bi bi-share"></i> Gép kategóriák</div>
            <div class="btn btn-default btn-sm mb-2" data-name="btn_main_settings_company_sites"><i class="bi bi-geo-alt"></i> Telephelyek</div>
            <div class="btn btn-default btn-sm mb-2" data-name="btn_main_settings_worksheet_types"><i class="bi bi-file-earmark-text"></i> Munkalap típusok</div>
            <div class="btn btn-default btn-sm mb-2" data-name="btn_main_settings_worksheet_status_types"><i class="bi bi-file-check"></i> Munkalap státuszok</div>
            <div class="btn btn-default btn-sm mb-2" data-name="btn_main_settings_worksheet_description_templates"><i class="bi bi-card-text"></i> Munkalap megjegyzés sablonok</div>
            <div class="btn btn-default btn-sm mb-2" data-name="btn_main_settings_notification_events"><i class="bi bi-bell"></i> Értesítési események</div>
            <!-- <div class="btn btn-default btn-sm mb-2" data-name="btn_main_settings_partners"><i class="bi bi-people-fill"></i> Partnerek</div> -->
            <div class="btn btn-default btn-sm mb-2" data-name="btn_main_settings_email_logs"><i class="bi bi-envelope"></i> E-mail napló</div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-12" data-name="index_settings_content"></div>
    </div>
</div>

{% endblock %}

{% block scripts %}
    <script>
        function loadSettingsSection(buttonName, route, ajaxName) {
            $(`[data-name='${buttonName}']`).unbind("click").click(function () {
                let formData = new FormData();
                formData.set('filters', '{}');

                new Ajax({
                    url: route,
                    name: ajaxName,
                    type: 'GET',
                    dataType: 'json',
                    formData: formData,
                    target: $("[data-name='index_settings_content']"),
                    function_success: function (result) {
                        this.target.html(result.content);
                    },
                    function_error: function (xhr) {
                        const message = xhr.responseText || 'Nem sikerült betölteni az oldalt.';
                        alertify.error(message);
                    }
                }).send();
            });
        }

        loadSettingsSection('btn_main_settings_users', '{{ path('main_settings_users') }}', 'main_settings_users');
        loadSettingsSection('btn_main_settings_permissions', '{{ path('main_settings_permissions') }}', 'main_settings_permissions');
        loadSettingsSection('btn_main_settings_machine_categories', '{{ path('main_settings_machine_categories') }}', 'main_settings_machine_categories');
        loadSettingsSection('btn_main_settings_company_sites', '{{ path('main_settings_company_sites') }}', 'main_settings_company_sites');
        loadSettingsSection('btn_main_settings_worksheet_types', '{{ path('main_settings_worksheet_types') }}', 'main_settings_worksheet_types');
        loadSettingsSection('btn_main_settings_worksheet_status_types', '{{ path('main_settings_worksheet_status_types') }}', 'main_settings_worksheet_status_types');
        loadSettingsSection('btn_main_settings_worksheet_description_templates', '{{ path('main_settings_worksheet_description_templates') }}', 'main_settings_worksheet_description_templates');
        loadSettingsSection('btn_main_settings_notification_events', '{{ path('main_settings_notification_events') }}', 'main_settings_notification_events');
        loadSettingsSection('btn_main_settings_email_logs', '{{ path('main_settings_email_logs') }}', 'main_settings_email_logs');
        loadSettingsSection('btn_main_settings_partners', '{{ path('main_settings_partners') }}', 'main_settings_partners');
    </script>
{% endblock %}
