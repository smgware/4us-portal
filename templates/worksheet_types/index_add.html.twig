<form action="" data-name="worksheet_type">
    <input type="hidden" name="id" data-name="id" value="{{ item ? item.id : '' }}">

    <div class="mb-3">
        <label for="" class="form-label">Név</label>
        <input type="text" class="form-control" name="name" data-name="name" value="{{ item ? item.title : '' }}" placeholder="Add meg a nevet">
    </div>

    <div class="mb-3">
        <label for="" class="form-label">Kód</label>
        <input type="text" class="form-control" name="code" data-name="code" value="{{ item ? item.code : '' }}" placeholder="Add meg a kódot">
    </div>

    <div class="mb-3">
        <label for="" class="form-label">Státusz</label>
        <select class="form-control" name="status" data-name="status">
            <option value="1" {{ item and item.status == '1' ? 'selected' }}>Aktív</option>
            <option value="0" {{ item and item.status == '0' ? 'selected' }}>Inaktív</option>
        </select>
    </div>
</form>
