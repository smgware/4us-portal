{% extends 'base.html.twig' %}

{% block title %}Áttekintés | Portal{% endblock %}

{% block body %}
    <style>
        .dashboard-overview {
            --dashboard-blue: #4f7cff;
            --dashboard-blue-rgb: 79, 124, 255;
            --dashboard-green: #20b486;
            --dashboard-green-rgb: 32, 180, 134;
            --dashboard-amber: #f59e0b;
            --dashboard-amber-rgb: 245, 158, 11;
            --dashboard-red: #f05252;
            --dashboard-red-rgb: 240, 82, 82;
            --dashboard-gray: #94a3b8;
            --dashboard-track: rgba(148, 163, 184, .18);
            /*max-width: 1600px;*/
            margin: 0 auto;
            padding: 4px 0 30px;
        }

        .dashboard-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 20px;
        }

        .dashboard-heading__eyebrow {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 4px;
            color: var(--dashboard-blue);
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .11em;
            text-transform: uppercase;
        }

        .dashboard-heading__eyebrow::before {
            content: '';
            width: 18px;
            height: 3px;
            border-radius: 99px;
            background: var(--dashboard-blue);
        }

        .dashboard-heading h1 {
            margin: 0;
            color: var(--text);
            font-size: clamp(1.35rem, 2.4vw, 1.8rem);
            font-weight: 750;
            letter-spacing: -.035em;
        }

        .dashboard-updated {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 11px;
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--muted);
            background: var(--card-bg);
            font-size: .72rem;
            white-space: nowrap;
        }

        .dashboard-updated i {
            color: var(--dashboard-blue);
        }

        .dashboard-metrics {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 30px;
        }

        .dashboard-metric {
            --metric-color: var(--dashboard-blue);
            --metric-rgb: var(--dashboard-blue-rgb);
            position: relative;
            min-width: 0;
            overflow: hidden;
            padding: 19px 20px 17px;
            border: 1px solid var(--border);
            border-radius: 18px;
            background:
                linear-gradient(145deg, rgba(var(--metric-rgb), .09), transparent 58%),
                var(--card-bg);
            box-shadow: 0 12px 30px var(--shadow);
        }

        .dashboard-metric::before {
            content: '';
            position: absolute;
            inset: 0 auto 0 0;
            width: 3px;
            background: var(--metric-color);
        }

        .dashboard-metric::after {
            content: '';
            position: absolute;
            top: -38px;
            right: -34px;
            width: 105px;
            height: 105px;
            border: 18px solid rgba(var(--metric-rgb), .07);
            border-radius: 50%;
            pointer-events: none;
        }

        .dashboard-metric--free {
            --metric-color: var(--dashboard-green);
            --metric-rgb: var(--dashboard-green-rgb);
        }

        .dashboard-metric--rented {
            --metric-color: var(--dashboard-amber);
            --metric-rgb: var(--dashboard-amber-rgb);
        }

        .dashboard-metric--repair {
            --metric-color: var(--dashboard-red);
            --metric-rgb: var(--dashboard-red-rgb);
        }

        .dashboard-metric__top {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .dashboard-metric__icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            border-radius: 12px;
            color: var(--metric-color);
            background: rgba(var(--metric-rgb), .13);
            font-size: 1.15rem;
        }

        .dashboard-metric__share {
            padding: 5px 8px;
            border-radius: 999px;
            color: var(--metric-color);
            background: rgba(var(--metric-rgb), .1);
            font-size: .67rem;
            font-weight: 750;
        }

        .dashboard-metric__value {
            position: relative;
            z-index: 1;
            margin-top: 17px;
            color: var(--text);
            font-size: clamp(1.65rem, 3vw, 2rem);
            line-height: 1;
            font-weight: 780;
            letter-spacing: -.04em;
        }

        .dashboard-metric__label {
            position: relative;
            z-index: 1;
            margin-top: 7px;
            color: var(--muted);
            font-size: .75rem;
        }

        .dashboard-metric__bar {
            position: relative;
            z-index: 1;
            height: 4px;
            overflow: hidden;
            margin-top: 14px;
            border-radius: 99px;
            background: var(--dashboard-track);
        }

        .dashboard-metric__bar span {
            display: block;
            width: var(--metric-width, 100%);
            height: 100%;
            border-radius: inherit;
            background: var(--metric-color);
        }

        .dashboard-section-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 15px;
        }

        .dashboard-section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            color: var(--text);
            font-size: 1rem;
            font-weight: 750;
        }

        .dashboard-section-title i {
            color: var(--dashboard-blue);
        }

        .dashboard-section-copy {
            margin-top: 5px;
            color: var(--muted);
            font-size: .72rem;
        }

        .dashboard-legend {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 7px;
        }

        .dashboard-legend__item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 9px;
            border: 1px solid var(--border);
            border-radius: 9px;
            color: var(--muted);
            background: var(--card-bg);
            font-size: .66rem;
            font-weight: 600;
        }

        .dashboard-legend__dot {
            width: 7px;
            height: 7px;
            border-radius: 2px;
        }

        .dashboard-sites {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 15px;
        }

        .dashboard-site-card {
            position: relative;
            min-width: 0;
            overflow: hidden;
            padding: 20px;
            border: 1px solid var(--border);
            border-radius: 20px;
            background: var(--card-bg);
            box-shadow: 0 12px 30px var(--shadow);
            transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
        }

        .dashboard-site-card::before {
            content: '';
            position: absolute;
            inset: 0 0 auto 0;
            height: 3px;
            background: linear-gradient(90deg, var(--dashboard-blue), var(--dashboard-green));
            opacity: .85;
        }

        .dashboard-site-card:hover {
            transform: translateY(-3px);
            border-color: rgba(var(--dashboard-blue-rgb), .42);
            box-shadow: 0 18px 38px var(--shadow);
        }

        .dashboard-site-card__header {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dashboard-site-card__icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            border-radius: 13px;
            color: var(--dashboard-blue);
            background: rgba(var(--dashboard-blue-rgb), .12);
            font-size: 1.1rem;
        }

        .dashboard-site-card__identity {
            min-width: 0;
            flex: 1;
        }

        .dashboard-site-card__title {
            overflow: hidden;
            margin: 0;
            color: var(--text);
            font-size: .96rem;
            font-weight: 750;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .dashboard-site-card__code {
            overflow: hidden;
            margin-top: 3px;
            color: var(--muted);
            font-size: .65rem;
            letter-spacing: .04em;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .dashboard-site-card__total {
            flex: 0 0 auto;
            text-align: right;
        }

        .dashboard-site-card__total strong {
            display: block;
            color: var(--text);
            font-size: 1.25rem;
            line-height: 1;
            font-weight: 780;
            letter-spacing: -.03em;
        }

        .dashboard-site-card__total span {
            display: block;
            margin-top: 4px;
            color: var(--muted);
            font-size: .58rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .dashboard-availability {
            display: flex;
            align-items: center;
            gap: 15px;
            margin: 19px 0 17px;
            padding: 14px;
            border: 1px solid var(--border);
            border-radius: 16px;
            background: var(--bg-main);
        }

        .dashboard-ring {
            position: relative;
            width: 72px;
            height: 72px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border-radius: 50%;
            background: conic-gradient(
                var(--dashboard-green) calc(var(--percentage) * 1%),
                var(--dashboard-track) 0
            );
        }

        .dashboard-ring::after {
            content: '';
            position: absolute;
            inset: 7px;
            border-radius: 50%;
            background: var(--bg-main);
        }

        .dashboard-ring__value {
            position: relative;
            z-index: 1;
            color: var(--text);
            font-size: .88rem;
            font-weight: 800;
            letter-spacing: -.03em;
        }

        .dashboard-availability__copy {
            min-width: 0;
        }

        .dashboard-availability__label {
            color: var(--muted);
            font-size: .65rem;
            font-weight: 650;
        }

        .dashboard-availability__value {
            margin-top: 2px;
            color: var(--text);
            font-size: 1rem;
            font-weight: 750;
        }

        .dashboard-availability__meta {
            margin-top: 3px;
            color: var(--muted);
            font-size: .64rem;
            line-height: 1.35;
        }

        .dashboard-capacity {
            height: 7px;
            display: flex;
            overflow: hidden;
            border-radius: 99px;
            background: var(--dashboard-track);
        }

        .dashboard-capacity__segment {
            min-width: 0;
            height: 100%;
        }

        .dashboard-capacity__segment--free { background: var(--dashboard-green); }
        .dashboard-capacity__segment--rented { background: var(--dashboard-amber); }
        .dashboard-capacity__segment--repair { background: var(--dashboard-red); }
        .dashboard-capacity__segment--inactive { background: var(--dashboard-gray); }

        .dashboard-site-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            margin-top: 13px;
        }

        .dashboard-site-stat {
            --stat-color: var(--dashboard-green);
            --stat-rgb: var(--dashboard-green-rgb);
            min-width: 0;
            padding: 10px;
            border-radius: 12px;
            background: rgba(var(--stat-rgb), .08);
        }

        .dashboard-site-stat--rented {
            --stat-color: var(--dashboard-amber);
            --stat-rgb: var(--dashboard-amber-rgb);
        }

        .dashboard-site-stat--repair {
            --stat-color: var(--dashboard-red);
            --stat-rgb: var(--dashboard-red-rgb);
        }

        .dashboard-site-stat__label {
            display: flex;
            align-items: center;
            gap: 5px;
            overflow: hidden;
            color: var(--muted);
            font-size: .61rem;
            font-weight: 650;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .dashboard-site-stat__label i {
            color: var(--stat-color);
        }

        .dashboard-site-stat__value {
            margin-top: 5px;
            color: var(--text);
            font-size: 1rem;
            font-weight: 780;
        }

        .dashboard-site-card__footnote {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 12px;
            color: var(--muted);
            font-size: .64rem;
        }

        .dashboard-empty {
            padding: 50px 20px;
            border: 1px dashed var(--border);
            border-radius: 20px;
            color: var(--muted);
            background: var(--card-bg);
            text-align: center;
        }

        body.light-mode .dashboard-metric,
        body.light-mode .dashboard-site-card {
            box-shadow: 0 12px 30px rgba(31, 41, 55, .07);
        }

        body.light-mode .dashboard-availability {
            background: #f7f9fc;
        }

        body.light-mode .dashboard-ring::after {
            background: #f7f9fc;
        }

        @media (max-width: 1199.98px) {
            .dashboard-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .dashboard-sites { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }

        @media (max-width: 767.98px) {
            .dashboard-heading {
                align-items: flex-start;
                flex-direction: column;
                gap: 11px;
            }

            .dashboard-section-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .dashboard-legend { justify-content: flex-start; }
            .dashboard-sites { grid-template-columns: 1fr; }
        }

        @media (max-width: 479.98px) {
            .dashboard-overview { padding-top: 0; }
            .dashboard-metrics { grid-template-columns: 1fr; gap: 10px; }
            .dashboard-metric { padding: 16px 17px 15px; }
            .dashboard-site-card { padding: 17px; }
            .dashboard-site-stats { gap: 6px; }
            .dashboard-site-stat { padding: 9px 8px; }
        }

        @media (prefers-reduced-motion: reduce) {
            .dashboard-site-card { transition: none; }
        }
    </style>

    {% set machineTotal = summary.total_machines > 0 ? summary.total_machines : 1 %}
    {% set freeShare = (summary.free_machines / machineTotal * 100)|round(1) %}
    {% set rentedShare = (summary.rented_machines / machineTotal * 100)|round(1) %}
    {% set repairShare = (summary.repair_machines / machineTotal * 100)|round(1) %}

    <div class="dashboard-overview">
        <div class="page-title"><i class="bi bi-microsoft"></i> Áttekintés</div>

        <div class="container-fluid p-0 mt-3">
            <div class="card panel-card p-3">
                <div class="row">
                    <div class="col col-lg-12 col-12 mb-3">
                        <div class="row">
                            <div class="col-12"><strong><i class="bi bi-search"></i> Gép keresése</strong></div>
                        </div>
                        <div class="row mt-1">
                            <div class="col-10"><input type="text" class="form-control"></div>
                            <div class="col-2"><div class="btn btn-default" data-name="btnDashboardMachineQuickSearch"> <i class="bi bi-search"></i> <span class="d-none d-lg-inline-block">Keresés</span></div></div>
                        </div>
                    </div>

                    <!--
                    <div class="col col-lg-6 col-12 mb-5">
                        <div class="row">
                            <div class="col-12"><strong><i class="bi bi-search"></i> Munkalap keresése</strong></div>
                        </div>
                        <div class="row">
                            <div class="col-10"><input type="text" class="form-control"></div>
                            <div class="col-2"><div class="btn btn-default"> <i class="bi bi-search"></i> <span class="d-none d-lg-inline-block">Keresés</span></div></div>
                        </div>
                    </div>
                    -->
                </div>

                <div class="row">
                    <div class="col-12" data-name="ajax-content" data-key="index_dashboard_quicksearch_result"></div>
            </div>
        </div>


        <section class="dashboard-metrics mt-4" aria-label="Összesített gépállapotok">
            <article class="dashboard-metric dashboard-metric--total" data-summary="total" data-value="{{ summary.total_machines }}">
                <div class="dashboard-metric__top">
                    <div class="dashboard-metric__icon"><i class="bi bi-gear-wide-connected"></i></div>
                    <div class="dashboard-metric__share">{{ summary.site_count }} telephely</div>
                </div>
                <div class="dashboard-metric__value">{{ summary.total_machines|number_format(0, ',', ' ') }}</div>
                <div class="dashboard-metric__label">Összes nyilvántartott gép</div>
                <div class="dashboard-metric__bar" style="--metric-width:100%;"><span></span></div>
            </article>

            <article class="dashboard-metric dashboard-metric--free" data-summary="free" data-value="{{ summary.free_machines }}">
                <div class="dashboard-metric__top">
                    <div class="dashboard-metric__icon"><i class="bi bi-check2-circle"></i></div>
                    <div class="dashboard-metric__share">{{ freeShare|number_format(1, ',', ' ') }}%</div>
                </div>
                <div class="dashboard-metric__value">{{ summary.free_machines|number_format(0, ',', ' ') }}</div>
                <div class="dashboard-metric__label">Azonnal elérhető gép</div>
                <div class="dashboard-metric__bar" style="--metric-width:{{ freeShare }}%;"><span></span></div>
            </article>

            <article class="dashboard-metric dashboard-metric--rented" data-summary="rented" data-value="{{ summary.rented_machines }}">
                <div class="dashboard-metric__top">
                    <div class="dashboard-metric__icon"><i class="bi bi-truck"></i></div>
                    <div class="dashboard-metric__share">{{ rentedShare|number_format(1, ',', ' ') }}%</div>
                </div>
                <div class="dashboard-metric__value">{{ summary.rented_machines|number_format(0, ',', ' ') }}</div>
                <div class="dashboard-metric__label">Jelenleg kölcsönzésben</div>
                <div class="dashboard-metric__bar" style="--metric-width:{{ rentedShare }}%;"><span></span></div>
            </article>

            <article class="dashboard-metric dashboard-metric--repair" data-summary="repair" data-value="{{ summary.repair_machines }}">
                <div class="dashboard-metric__top">
                    <div class="dashboard-metric__icon"><i class="bi bi-wrench-adjustable"></i></div>
                    <div class="dashboard-metric__share">{{ repairShare|number_format(1, ',', ' ') }}%</div>
                </div>
                <div class="dashboard-metric__value">{{ summary.repair_machines|number_format(0, ',', ' ') }}</div>
                <div class="dashboard-metric__label">Javításra vár vagy javítás alatt</div>
                <div class="dashboard-metric__bar" style="--metric-width:{{ repairShare }}%;"><span></span></div>
            </article>
        </section>

        <section aria-labelledby="dashboard-sites-title">
            <div class="dashboard-section-head">
                <div>
                    <h2 class="dashboard-section-title" id="dashboard-sites-title">
                        <i class="bi bi-buildings"></i>
                        Telephelyi kapacitások
                    </h2>
                    <div class="dashboard-section-copy">Élő állapot a nyitott munkalapok és kölcsönzések alapján.</div>
                </div>
                <div class="dashboard-legend" aria-label="Jelmagyarázat">
                    <span class="dashboard-legend__item"><span class="dashboard-legend__dot" style="background:var(--dashboard-green);"></span>Szabad</span>
                    <span class="dashboard-legend__item"><span class="dashboard-legend__dot" style="background:var(--dashboard-amber);"></span>Kölcsönzésben</span>
                    <span class="dashboard-legend__item"><span class="dashboard-legend__dot" style="background:var(--dashboard-red);"></span>Javítás alatt</span>
                    {% if summary.inactive_machines > 0 %}
                        <span class="dashboard-legend__item"><span class="dashboard-legend__dot" style="background:var(--dashboard-gray);"></span>Inaktív</span>
                    {% endif %}
                </div>
            </div>

            {% if companySites %}
                <div class="dashboard-sites">
                    {% for site in companySites %}
                        <article
                            class="dashboard-site-card"
                            data-site-id="{{ site.id }}"
                            data-total="{{ site.total_machines }}"
                            data-free="{{ site.free_machines }}"
                            data-rented="{{ site.rented_machines }}"
                            data-repair="{{ site.repair_machines }}"
                            data-inactive="{{ site.inactive_machines }}"
                        >
                            <div class="dashboard-site-card__header">
                                <div class="dashboard-site-card__icon"><i class="bi bi-building"></i></div>
                                <div class="dashboard-site-card__identity">
                                    <h3 class="dashboard-site-card__title" title="{{ site.title }}">{{ site.title }}</h3>
                                    <div class="dashboard-site-card__code">
                                        {% if site.code and site.code != '-' %}
                                            {{ site.code }}
                                        {% else %}
                                            Telephely #{{ site.id }}
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="dashboard-site-card__total">
                                    <strong>{{ site.total_machines }}</strong>
                                    <span>összes gép</span>
                                </div>
                            </div>

                            <div class="dashboard-availability">
                                <div class="dashboard-ring" style="--percentage:{{ site.free_percent }};" aria-hidden="true">
                                    <span class="dashboard-ring__value">{{ site.free_percent|number_format(0, ',', ' ') }}%</span>
                                </div>
                                <div class="dashboard-availability__copy">
                                    <div class="dashboard-availability__label">Szabad kapacitás</div>
                                    <div class="dashboard-availability__value">{{ site.free_machines }} gép elérhető</div>
                                    <div class="dashboard-availability__meta">{{ site.active_machines }} aktív gépből, valós idejű állapot szerint</div>
                                </div>
                            </div>

                            <div
                                class="dashboard-capacity"
                                role="img"
                                aria-label="{{ site.title }} gépállapotai: {{ site.free_machines }} szabad, {{ site.rented_machines }} kölcsönzésben, {{ site.repair_machines }} javítás alatt, {{ site.inactive_machines }} inaktív"
                            >
                                <span class="dashboard-capacity__segment dashboard-capacity__segment--free" style="width:{{ site.free_percent }}%;"></span>
                                <span class="dashboard-capacity__segment dashboard-capacity__segment--rented" style="width:{{ site.rented_percent }}%;"></span>
                                <span class="dashboard-capacity__segment dashboard-capacity__segment--repair" style="width:{{ site.repair_percent }}%;"></span>
                                <span class="dashboard-capacity__segment dashboard-capacity__segment--inactive" style="width:{{ site.inactive_percent }}%;"></span>
                            </div>

                            <div class="dashboard-site-stats">
                                <div class="dashboard-site-stat">
                                    <div class="dashboard-site-stat__label"><i class="bi bi-check-circle-fill"></i> Szabad</div>
                                    <div class="dashboard-site-stat__value">{{ site.free_machines }}</div>
                                </div>
                                <div class="dashboard-site-stat dashboard-site-stat--rented">
                                    <div class="dashboard-site-stat__label"><i class="bi bi-truck"></i> Kiadva</div>
                                    <div class="dashboard-site-stat__value">{{ site.rented_machines }}</div>
                                </div>
                                <div class="dashboard-site-stat dashboard-site-stat--repair">
                                    <div class="dashboard-site-stat__label"><i class="bi bi-tools"></i> Javítás</div>
                                    <div class="dashboard-site-stat__value">{{ site.repair_machines }}</div>
                                </div>
                            </div>

                            {% if site.inactive_machines > 0 %}
                                <div class="dashboard-site-card__footnote">
                                    <i class="bi bi-pause-circle"></i>
                                    {{ site.inactive_machines }} inaktív gép nem számít az elérhető kapacitásba
                                </div>
                            {% elseif site.total_machines == 0 %}
                                <div class="dashboard-site-card__footnote">
                                    <i class="bi bi-info-circle"></i>
                                    Nincs nyilvántartott gép ezen a telephelyen
                                </div>
                            {% endif %}
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="dashboard-empty">
                    <i class="bi bi-buildings fs-2 d-block mb-2"></i>
                    Nincs megjeleníthető telephely.
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}

{% block scripts %}

<script>


    $("[data-name='btnDashboardMachineQuickSearch']").unbind("click").click(function () {
        var formData = new FormData();

        new Ajax({
            url: '{{ path('index_dashboard_machine_quick_search') }}',
            name: 'index_dashboard_machine_quick_search',
            type: 'POST',
            dataType: 'json',
            formData: formData,
            target: $("[data-key='index_dashboard_quicksearch_result']"),
            function_success: function (result) {
                if(result.success){
                    this.target.html(result.content);
                }
            },
            function_error: function (xhr) {
                const message = xhr.responseText || 'Nem sikerült menteni az adatot.';
                alertify.error(message);
            }
        }).send();
    });
</script>
{% endblock %}
