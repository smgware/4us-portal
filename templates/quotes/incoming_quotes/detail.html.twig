<div class="container-fluid p-0">
    {% set name = quoteData['Név']|default(quoteData['NĂ©v']|default('-')) %}
    {% set company = quoteData['Cégnév']|default(quoteData['CĂ©gnĂ©v']|default('-')) %}
    {% set phone = quoteData['Telefonszám']|default(quoteData['TelefonszĂˇm']|default('-')) %}
    {% set machinePair = quoteData['Kiválasztott modell-pár']|default(quoteData['KivĂˇlasztott modell-pĂˇr']|default('-')) %}
    {% set months = quoteData['Munkaidő hónapban']|default(null) %}
    {% set message = quoteData['Üzenet']|default(quoteData['Ăśzenet']|default('-')) %}

    <div class="row g-3">
        <div class="col-12">
            <div class="card panel-card p-3">
                <div class="row">
                    <div class="col-md-6">
                        <div class="text-muted small">Kód</div>
                        <div class="fw-bold">{{ quote.code }}</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Cím</div>
                        <div class="fw-bold">{{ quote.title }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card panel-card p-3 h-100">
                <div class="text-muted small">Név</div>
                <div class="fw-bold">{{ name }}</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card panel-card p-3 h-100">
                <div class="text-muted small">Cégnév</div>
                <div class="fw-bold">{{ company }}</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card panel-card p-3 h-100">
                <div class="text-muted small">E-mail</div>
                <div class="fw-bold">{{ quoteData['E-mail']|default('-') }}</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card panel-card p-3 h-100">
                <div class="text-muted small">Telefonszám</div>
                <div class="fw-bold">{{ phone }}</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card panel-card p-3 h-100">
                <div class="text-muted small">Kiválasztott modell-pár</div>
                <div class="fw-bold">{{ machinePair }}</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card panel-card p-3 h-100">
                <div class="text-muted small">Munkaidő hónapban</div>
                <div class="fw-bold">{{ months is not empty ? months ~ ' hónap' : '-' }}</div>
            </div>
        </div>
        <div class="col-12">
            <div class="card panel-card p-3">
                <div class="text-muted small">Üzenet</div>
                <div class="fw-bold" style="white-space: pre-wrap;">{{ message }}</div>
            </div>
        </div>
    </div>
</div>
