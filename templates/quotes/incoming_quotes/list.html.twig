<div class="table-responsive w-100 overflow-auto">
    <table class="table-default w-100">
        <thead>
            <tr class="pt-2 pb-2">
                <th class="p-2">Kód</th>
                <th class="p-2">Név</th>
                <th class="p-2">Cégnév</th>
                <th class="p-2">E-mail</th>
                <th class="p-2">Telefonszám</th>
                <th class="p-2">Modell-pár</th>
                <th class="p-2">Munkaidő</th>
                <th class="p-2">#</th>
            </tr>
        </thead>
        <tbody>
            {% for record in records %}
                {% set recordData = record.data|default({}) %}
                {% set name = recordData['Név']|default(recordData['NĂ©v']|default('-')) %}
                {% set company = recordData['Cégnév']|default(recordData['CĂ©gnĂ©v']|default('-')) %}
                {% set phone = recordData['Telefonszám']|default(recordData['TelefonszĂˇm']|default('-')) %}
                {% set machinePair = recordData['Kiválasztott modell-pár']|default(recordData['KivĂˇlasztott modell-pĂˇr']|default('-')) %}
                {% set months = recordData['Munkaidő hónapban']|default(null) %}
                <tr data-name="list_item" data-key="{{ record.id }}">
                    <td>{{ record.code }}</td>
                    <td>{{ name }}</td>
                    <td>{{ company }}</td>
                    <td>{{ recordData['E-mail']|default('-') }}</td>
                    <td>{{ phone }}</td>
                    <td>{{ machinePair }}</td>
                    <td>{{ months is not empty ? months ~ ' hónap' : '-' }}</td>
                    <td>
                        <div class="btn btn-default btn-sm" data-name="quote_view_btn" title="Megtekint">
                            <i class="bi bi-eye"></i> Megtekint
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center py-4">Nincs megjeleníthető ajánlatkérés.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% include 'partials/_pagination.html.twig' with {
    currentPage: page,
    totalPages: totalPages,
    routeName: 'list_incoming_quotes',
    queryParams: app.request.query.all
} %}
