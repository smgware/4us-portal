<div class="container-fluid" data-name="addForm">
    <div class="row">

        <!--left side-->
        <div class="col col-lg-8 col-12">

            <div class="card panel-card p-2">
                <div class="row">
                    <div class="col-12"><strong>Alapadatok</strong></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function() {

        var footer = `
            <div class="container-fluid p-0" data-box="quoteAdd">
                <div class="row">
                    <div class="col-12 text-end">
                        <button type="button" class="btn btn-default btn-sm btn-success" data-name="btnSave">
                            <i class="bi bi-floppy2-fill"></i> Mentés
                        </button>

                        <button type="button" class="btn btn-default btn-sm btn-secondary" data-name="btnCancel">
                            <i class="bi bi-x-circle"></i> Bezárás
                        </button>
                    </div>
                </div>
         </div>`;

        alertify.add("Hozzáadás", $("[data-name='quoteAddForm']").html())
            .set('movable', false)
            .set('resizable', false)
            .set('closable', false)
            .set('closableByEscape', false)
            .maximize()
            .set({transition: 'zoom'})
            .setFooter(footer);

        $("[data-box='quoteAdd'] [data-name='btnSave']").unbind("click").click(function () {
            alertify.confirm("Megerősítés","Mented az adatokat?", ()=>{
                alertify.add().close();
            }, ()=>{});
        });

        $("[data-box='quoteAdd'] [data-name='btnCancel']").unbind("click").click(function () {
            alertify.confirm("Megerősítés","Bezárod az ablakot?", ()=>{
                alertify.add().close();
            }, ()=>{});
        });
    });

</script>
