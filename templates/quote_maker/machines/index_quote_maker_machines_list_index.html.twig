<div class="container-fluid p-0">


    <div class="row mt-2">
        <div class="col-12">

            <div class="card panel-card p-2">
                <div class="row">
                    <div class="col-5">
                        <input type="text" class="form-control" placeholder="Keresés..." data-name="searchQuoteMakerMachines">
                    </div>
                    <div class="col-7 text-end">
                        <button type="button" class="btn btn-default" data-name="btnQuoteMakerMachinesSearch">
                            <i class="bi bi-search"></i> Keresés
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>


    <div class="row mt-2">
        <div class="col-12">
            <div class="card panel-card p-2">
                <div class="row">
                    <div class="col-12" data-name="ajax-content" data-key="index_quote_maker_machines_list"></div>
                </div>
            </div>
        </div>
    </div>

</div>


<script>

    (() => {
    var formData = new FormData();
    formData.set('filters', '{}');
    formData.set('page', '1');

    new Ajax({
        url: '{{ path('index_quote_maker_machines_list') }}',
        name: 'index_quote_maker_machines_list',
        type: 'POST',
        dataType: 'json',
        formData: formData,
        target: $("[data-key='index_quote_maker_machines_list']"),
        function_success: function (result) {
            if (!result.success) {
                alertify.error(result.data?.error || 'Nem sikerült betölteni a gépeket.');
                return;
            }
            this.target.html(result.content);
        }
    }).send();

    function refreshMachineList() {
        var filters = JSON.parse(ajaxquery['index_quote_maker_machines_list'].formData.get('filters') || '{}');
        filters.search = $("[data-name='searchQuoteMakerMachines']").val() || '';
        ajaxquery['index_quote_maker_machines_list'].formData.set('filters', JSON.stringify(filters));
        ajaxquery['index_quote_maker_machines_list'].formData.set('page', '1');
        ajaxquery['index_quote_maker_machines_list'].url = '{{ path('index_quote_maker_machines_list') }}';
        ajaxquery['index_quote_maker_machines_list'].send();
    }

    $("[data-name='btnQuoteMakerMachinesSearch']").unbind('click').click(refreshMachineList);
    $("[data-name='searchQuoteMakerMachines']").unbind('keyup').keyup(function (event) {
        if (event.key === 'Enter') {
            refreshMachineList();
        }
    });
    })();

</script>
