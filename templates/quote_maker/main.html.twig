<div class="container-fluid p-0">
    <div class="row">
        <div class="col-12">
            <div class="page-title"><i class="bi bi-file-check-fill"></i> Árajánlat készítés</div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">

            <div class="card panel-card p-2">
                <div class="row">

                    <div class="col-12 text-start">
                        <button type="button" class="btn btn-default btn-sm" data-name="btnQuoteMakerQuotes">
                            <i class="bi bi-file-check-fill"></i> Árajánlatok
                        </button>

                        <button type="button" class="btn btn-default btn-sm" data-name="btnQuoteMakerMachines">
                            <i class="bi bi-gear-wide-connected"></i> Gépek kezelése
                        </button>


                    </div>
                </div>
            </div>

        </div>
    </div>


    <div class="row mt-2">
        <div class="col-12" data-name="ajax-content" data-key="index_quote_maker_content"></div>
    </div>

</div>

<script>


    $("[data-name='btnQuoteMakerQuotes']").unbind("click").click(function () {

        var formData = new FormData();
        new Ajax({
            url: '{{ path('index_quote_maker_quotes') }}',
            name: 'index_quote_maker_quotes',
            type: 'POST',
            dataType: 'json',
            formData: formData,
            target: $("[data-key='index_quote_maker_content']"),
            function_success: function (result) {
                if (!result.success) {
                    alertify.error(result.data?.error || 'Nem sikerült betölteni a projekteket.');
                    return;
                }
                this.target.html(result.content);
            }
        }).send();

    });


    $("[data-name='btnQuoteMakerMachines']").unbind("click").click(function () {
        var formData = new FormData();
        new Ajax({
            url: '{{ path('index_quote_maker_machines') }}',
            name: 'index_quote_maker_machines',
            type: 'POST',
            dataType: 'json',
            formData: formData,
            target: $("[data-key='index_quote_maker_content']"),
            function_success: function (result) {
                if (!result.success) {
                    alertify.error(result.data?.error || 'Nem sikerült betölteni a projekteket.');
                    return;
                }
                this.target.html(result.content);
            }
        }).send();

    });

    $("[data-name='btnQuoteMakerQuotes']").trigger("click");

</script>
