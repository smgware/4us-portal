<div class="container-fluid p-0">

    <div class="row mt-2">
        <div class="col-12">

            <div class="card panel-card p-2">
                <div class="row">
                    <div class="col-5">
                        <input type="text" class="form-control" placeholder="Keresés..." data-name="search_projects_list">
                    </div>
                    <div class="col-7 text-end">
                            <button type="button" class="btn btn-default" data-name="btnQuoteMakerQuotesSearch">
                                <i class="bi bi-search"></i> Keresés
                            </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-12">
            <div class="card panel-card p-2">
                <div class="row">
                    <div class="col-12" data-name="ajax-content" data-key="index_quote_maker_quotes_list"></div>
                </div>
            </div>
        </div>
    </div>

</div>


<script>

    var formData = new FormData();
    new Ajax({
        url: '{{ path('index_quote_maker_quotes_list') }}',
        name: 'index_quote_maker_quotes_list',
        type: 'POST',
        dataType: 'json',
        formData: formData,
        target: $("[data-key='index_quote_maker_quotes_list']"),
        function_success: function (result) {
            if (!result.success) {
                alertify.error(result.data?.error || 'Nem sikerült betölteni a projekteket.');
                return;
            }
            this.target.html(result.content);
        }
    }).send();

</script>
