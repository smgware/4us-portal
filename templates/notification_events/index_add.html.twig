<form action="" data-name="notification_event">
    <input type="hidden" name="id" data-name="id" value="{{ item ? item.id : '' }}">

    <div class="mb-3">
        <label class="form-label">Név</label>
        <input
            type="text"
            class="form-control"
            name="name"
            data-name="name"
            value="{{ item ? item.name : '' }}"
            maxlength="255"
            placeholder="Add meg az esemény nevét"
            required
        >
    </div>

    <div class="mb-3">
        <label class="form-label">Kód</label>
        <input
            type="text"
            class="form-control"
            name="code"
            data-name="code"
            value="{{ item ? item.code : '' }}"
            maxlength="100"
            placeholder="Például: WORKSHEET_SAVED"
            required
        >
    </div>

    <div class="mb-3">
        <label class="form-label">Státusz</label>
        <select class="form-control" name="status" data-name="status">
            <option value="1" {{ item is null or item.status == '1' ? 'selected' }}>Aktív</option>
            <option value="0" {{ item and item.status == '0' ? 'selected' }}>Inaktív</option>
        </select>
    </div>
</form>
