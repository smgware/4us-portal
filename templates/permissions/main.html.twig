<div class="page-title"><i class="bi bi-person-lock"></i> Jogosultságok</div>

<div class="card panel-card p-2">
    <div class="row">
        <div class="col-5"><input type="text" class="form-control" placeholder="Keresés..." data-name="search_permissions_list"/></div>
        <div class="col-7">
            <div class="row">
                <div class="col-12 text-end">
                    <div class="btn btn-default btn-sm" data-name="btn_index_permissions_list_filters"><i class="bi bi-filter-circle-fill"></i> Szűrők</div>
                    <div class="btn btn-default btn-sm" data-name="btn_index_permissions_add"><i class="bi bi-plus-circle-fill"></i> Uj hozzáadasa</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card panel-card p-2 mt-2">
    <div class="row">
        <div class="col-12" data-name="ajax-content" data-key="list_permissions"></div>
    </div>
</div>

<script>
    var formData = new FormData();
    formData.set('filters', '{}');

    new Ajax({
        url: '{{ path('list_permissions') }}',
        name: 'list_permissions',
        type: 'POST',
        dataType: 'json',
        formData: formData,
        target: $("[data-key='list_permissions']"),
        function_success: function (result) {
            if(result.success){
                this.target.html(result.content);

                this.target.find("[data-name='list_item_btn']").unbind("click").click(function(){
                    mode = $(this).attr("data-mode");
                    key = $(this).closest("[data-name='list_item']").attr("data-key");

                    if(mode == "edit"){
                        ajaxquery['index_permissions_add'].formData.set("id", key);
                        ajaxquery['index_permissions_add'].send();
                    }

                    if(mode == "delete"){
                        alertify.confirm("Megerosites","Torolni szeretned az adatot?", ()=> {
                            var formData = new FormData();
                            formData.set('id', key);

                            new Ajax({
                                url: '{{ path('delete_permissions') }}',
                                type: 'DELETE',
                                dataType: 'json',
                                formData: formData,
                                function_success: function (result) {
                                    if (result.success) {
                                        alertify.message("Sikeres torles");
                                        ajaxquery['list_permissions'].send();
                                    }
                                }
                            }).send();
                        },()=>{});
                    }
                });
            }
        }
    }).send();

    var formData = new FormData();
    formData.set('filters', '{}');

    new Ajax({
        url: '{{ path('index_permissions_add') }}',
        name: 'index_permissions_add',
        type: 'GET',
        dataType: 'json',
        formData: formData,
        target: null,
        function_success: function (result) {
            html_footer = `<div class="container-fluid p-0" data-box="${this.name}"><div class="row"><div class="col-12 text-end"><div class="btn btn-default btn-sm btn-success" data-name="alertify-save">Mentes</div> <div class="btn btn-default btn-sm btn-secondary" data-name="alertify-cancel">Megse</div> </div></div></div>`;

            alertify.add("Hozzaadas", result.content).
            set("movable",false).
            set("resizable",false).
            set("closable",false).
            set('closableByEscape', false).
            resizeTo("50%", "70%").
            set({transition:'zoom'}).
            setFooter(html_footer);

            $(`div[data-box="${this.name}"] .btn[data-name='alertify-cancel']`).unbind("click").click(function(){
                alertify.confirm("Megerosites","Bezarod az ablakot?", ()=>{
                    alertify.add().close();
                },()=>{});
            });

            $(`div[data-box="${this.name}"] .btn[data-name='alertify-save']`).unbind("click").click(function(){
                alertify.confirm("Megerosites","Mented az adatokat?", ()=>{
                    const form = $("form[data-name='permission']")[0];
                    var formData = new FormData(form);

                    for (const [key, value] of formData.entries()) {
                        console.log(key, value);
                    }

                    formData.set('id', $("form[data-name='permission'] [data-name='id']").val());
                    formData.set('name', $("form[data-name='permission'] [data-name='name']").val());
                    formData.set('code', $("form[data-name='permission'] [data-name='code']").val());
                    formData.set('parent_id', $("form[data-name='permission'] [data-name='parent_id']").val());
                    formData.set('status', $("form[data-name='permission'] [data-name='status']").val());

                    new Ajax({
                        url: '{{ path('save_permissions') }}',
                        name: 'save_permissions',
                        type: 'POST',
                        dataType: 'json',
                        formData: formData,
                        target: $("[data-name='index_settings_content']"),
                        function_success: function (result) {
                            if(result.success){
                                alertify.add().close();
                                alertify.success("Sikeres mentes");
                                ajaxquery['list_permissions'].send();
                            }
                        }
                    }).send();
                },()=>{});
            });
        },
        function_error: function (xhr) {
            const message = xhr.responseText || 'Nem sikerult betolteni az oldalt.';
            alertify.error(message);
        }
    });

    $("[data-name='btn_index_permissions_add']").unbind("click").click(function () {
        ajaxquery['index_permissions_add'].formData.set("id", null);
        ajaxquery['index_permissions_add'].send();
    });

    $("[data-name='search_permissions_list']").unbind("keyup").keyup(function (e) {
        if(e.keyCode == 13){
            var filters = JSON.parse(ajaxquery['list_permissions'].formData.get("filters"));
            filters.search = $(this).val();
            ajaxquery['list_permissions'].formData.set("filters", JSON.stringify(filters));
            ajaxquery['list_permissions'].send();
        }
    });
</script>
