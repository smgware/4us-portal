<form action="" data-name="permission">
    <input type="hidden" name="id" data-name="id" value="{{ item ? item.id : '' }}">

    <div class="mb-3">
        <label for="" class="form-label">Nev</label>
        <input type="text" class="form-control" name="name" data-name="name" value="{{ item ? item.title : '' }}" placeholder="Add meg a nevet">
    </div>

    <div class="mb-3">
        <label for="" class="form-label">Kod</label>
        <input type="text" class="form-control" name="code" data-name="code" value="{{ item ? item.code : '' }}" placeholder="Add meg a kodot">
    </div>

    <!--
    <div class="mb-3">
        <label for="" class="form-label">Szulo jogosultsag</label>
        <select class="form-control" name="parent_id" data-name="parent_id">
            <option value="">Nincs szulo</option>
            {% for parent in parents %}
                <option value="{{ parent.id }}" {{ item and item.parentId == parent.id ? 'selected' }}>
                    {{ parent.title }} ({{ parent.code }})
                </option>
            {% endfor %}
        </select>
    </div>
    -->
    <div class="mb-3">
        <label for="" class="form-label">Statusz</label>
        <select class="form-control" name="status" data-name="status">
            <option value="1" {{ item and item.status == '1' ? 'selected' }}>Aktiv</option>
            <option value="0" {{ item and item.status == '0' ? 'selected' }}>Inaktiv</option>
        </select>
    </div>
</form>
