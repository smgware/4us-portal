<script>
    $(function () {
        const proconsByType = {{ {'tower': procons.td, 'mobile': procons.mtd}|json_encode|raw }};
        const machineTypeNames = {
            tower: 'toronydaru',
            mobile: 'mobil toronydaru'
        };
        let latestCalculation = null;

        function scrollToSection(target) {
            const $target = $(target);

            if (!$target.length) {
                return;
            }

            $('html, body').stop().animate({
                scrollTop: Math.max($target.offset().top - 24, 0)
            }, 800);
        }

        $('.btn-calculate').on('click', function () {
            scrollToSection('.data-informations');
        });

        $('.btn-offer').on('click', function () {
            scrollToSection('#offer-form');
        });

        $('.machine-option').on('click', function () {
            var idx = $(this).attr("data-pair-id");

            $('.machine-option').removeClass('active');
            $(this).addClass('active');
            calculateCosts(true);

            $("[data-name='technical-specification-items-pairs']").css("display","none");
            $("[data-name='technical-specification-items-pairs'][data-pair-id='"+idx+"']").fadeIn(100);

        });

        let calculateTimer = null;

        function selectedPairId() {
            return $('.machine-option.active').data('pair-id') || 'pair-1';
        }

        function currentMonths() {
            return parseInt($('#work-duration-range').val(), 10) || 1;
        }

        function setCostDetails(selector, item) {
            $(selector).html(item.oneTimeFormatted + ' egyszeri költség<br>+ ' + item.monthlyFormatted + '/hó');
        }

        function formatNumber(value, decimals) {
            return value
                .toLocaleString('hu-HU', {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: decimals
                })
                .replace(/\u00a0/g, ' ');
        }

        function formatMoney(value) {
            const amount = Number(value || 0);

            if (amount >= 1000000) {
                return formatNumber(amount / 1000000, 2) + ' M Ft';
            }

            return formatNumber(amount, 0) + ' Ft';
        }

        function animateCostPrice(selector, targetValue, fallbackText) {
            const $price = $(selector);
            const target = Number(targetValue || 0);
            const start = Number($price.data('raw-value'));

            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !Number.isFinite(start)) {
                $price.text(fallbackText || formatMoney(target)).data('raw-value', target);
                return;
            }

            $price.stop(true, true);

            $({value: start}).animate({value: target}, {
                duration: 450,
                easing: 'swing',
                step: function (now) {
                    $price.text(formatMoney(now));
                },
                complete: function () {
                    $price.text(fallbackText || formatMoney(target)).data('raw-value', target);
                }
            });
        }

        function updateValueDirection(data) {
            const towerTotal = Number(data.tower?.total || 0);
            const mobileTotal = Number(data.mobile?.total || 0);
            const directionClass = mobileTotal === towerTotal
                ? 'bi-dash-lg'
                : (mobileTotal > towerTotal ? 'bi-chevron-left' : 'bi-chevron-right');

            $('[data-name="value-direction"]')
                .removeClass('bi-chevron-left bi-chevron-right bi-dash-lg')
                .addClass(directionClass);
        }

        function renderProconsList(selector, items, iconClasses) {
            const listItems = Array.isArray(items) ? items : [];
            const $list = $(selector).empty();

            $.each(listItems, function (index, item) {
                $('<li>')
                    .toggleClass('mb-2', index < listItems.length - 1)
                    .append($('<i>').addClass(iconClasses + ' me-2'))
                    .append(document.createTextNode(item))
                    .appendTo($list);
            });
        }

        function updateProcons(data) {
            const recommendedType = data.recommendedType === 'tower' ? 'tower' : 'mobile';
            const alternativeType = recommendedType === 'tower' ? 'mobile' : 'tower';
            const primaryProcons = proconsByType[recommendedType] || {pro: [], cons: []};
            const alternativeProcons = proconsByType[alternativeType] || {pro: [], cons: []};

            $('#alternative-recommend-title').text('Ha a másikat választanád: ' + machineTypeNames[alternativeType]);

            renderProconsList('#primary-pro-list', primaryProcons.pro, 'bi bi-check-circle-fill text-success');
            renderProconsList('#primary-cons-list', primaryProcons.cons, 'bi bi-exclamation-circle-fill text-warning');
            renderProconsList('#alternative-pro-list', alternativeProcons.pro, 'bi bi-check-circle-fill text-success');
            renderProconsList('#alternative-cons-list', alternativeProcons.cons, 'bi bi-exclamation-circle-fill text-warning');
        }

        function setSelectedMachine(machineName) {
            if (!machineName) {
                return;
            }

            $('#compare-machines-quote-form [name="machine_pair"]').val(machineName);
        }

        function selectOfferMachine(choice) {
            if (!latestCalculation) {
                return;
            }

            setSelectedMachine(choice === 'alternative'
                ? latestCalculation.alternativeMachineName
                : latestCalculation.recommendedMachineName);
        }

        function updateCalculation(data) {
            latestCalculation = data;
            $('#work-duration-range').val(data.months);
            $('#work-duration-value').text(data.months);
            $('[data-name="month-equal"]').text(data.closestMonth);
            $('#compare-machines-quote-form [name="pair_id"]').val(data.pairId);
            $('#recommendation-title').text(data.recommendationTitle);
            $('#recommendation-summary').text(data.recommendationSummary);

            animateCostPrice('#tower-cost-price', data.tower.total, data.tower.totalFormatted);
            animateCostPrice('#mobile-cost-price', data.mobile.total, data.mobile.totalFormatted);
            setCostDetails('#tower-cost-details', data.tower);
            setCostDetails('#mobile-cost-details', data.mobile);
            updateValueDirection(data);

            $('#primary-recommend-title').text(data.primaryTitle);
            $('#primary-recommend-summary').text(data.primarySummary);
            $('#alternative-summary').text(data.alternativeSummary);
            updateProcons(data);

            const recommended = data.recommendedType === 'tower' ? data.tower : data.mobile;
            const alternative = data.recommendedType === 'tower' ? data.mobile : data.tower;
            $('#primary-total-cost').text(recommended.totalFormatted);
            $('#primary-saving').text(data.saving.formatted);
            $('#alternative-total-cost').text(alternative.totalFormatted);
            setSelectedMachine(data.recommendedMachineName);
        }

        function calculateCosts(useClosestMonth = false) {
            const $range = $('#work-duration-range');
            const url = $range.data('calculate-url');
            const months = currentMonths();
            const payload = {
                pairId: selectedPairId()
            };

            if (!useClosestMonth) {
                payload.months = months;
                $('#work-duration-value').text(months);
            }

            if (!url) {
                return;
            }

            $.ajax({
                url: url,
                method: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response && response.success) {
                        updateCalculation(response);
                    }
                }
            });
        }

        $('#work-duration-range').on('input change', function () {
            clearTimeout(calculateTimer);
            $('#work-duration-value').text(currentMonths());
            calculateTimer = setTimeout(calculateCosts, 180);
        });

        $('.offer-choice').on('click', function (event) {
            event.preventDefault();
            selectOfferMachine($(this).data('offer-choice'));
            scrollToSection('#offer-form');
        });

        function quoteFormValue(name) {
            return String($('#compare-machines-quote-form [name="' + name + '"]').val() || '').trim();
        }

        function validateQuoteForm() {
            const errors = [];

            if (quoteFormValue('name') === '') {
                errors.push('Név megadása kötelező.');
            }
            if (quoteFormValue('company') === '') {
                errors.push('Cégnév megadása kötelező.');
            }
            if (quoteFormValue('email') === '') {
                errors.push('E-mail megadása kötelező.');
            } else if (!document.querySelector('#compare-machines-quote-form [name="email"]').checkValidity()) {
                errors.push('Érvényes e-mail címet adj meg.');
            }
            if (quoteFormValue('phone') === '') {
                errors.push('Telefonszám megadása kötelező.');
            }
            if (quoteFormValue('machine_pair') === '') {
                errors.push('Kiválasztott modell megadása kötelező.');
            }
            if (quoteFormValue('message') === '') {
                errors.push('Üzenet megadása kötelező.');
            }
            if (!$('#privacy-policy-consent').is(':checked')) {
                errors.push('Az Adatkezelési nyilatkozat elfogadása kötelező.');
            }

            return errors;
        }

        $('#compare-machines-quote-form').on('submit', function (event) {
            event.preventDefault();
            const errors = validateQuoteForm();

            if (errors.length > 0) {
                alertify.alert('Hiba','Kérem javítsa az alábbi adatokat:<br>' + errors.join('<br>'));
                return;
            }

            const $form = $(this);
            const formData = new FormData($form[0]);
            formData.set('months', String(currentMonths()));
            formData.set('pair_id', selectedPairId());
            formData.set('selected_machine', quoteFormValue('machine_pair'));
            const $button = $('#compare-machines-quote-submit');

            new AJAX({
                url: $form.data('save-url'),
                type: 'POST',
                formData: formData,
                function_prepare: function () {
                    $button.prop('disabled', true);
                },
                function_success: function (response) {
                    if (response && response.success) {
                        alertify.alert('Sikeres küldés', response.message);
                        $form[0].reset();
                        $form.find('[name="pair_id"]').val(selectedPairId());
                        if (latestCalculation) {
                            setSelectedMachine(latestCalculation.recommendedMachineName);
                        }
                        return;
                    }

                    alertify.alert('Hiba', response?.message || 'Az ajánlatkérés elküldése nem sikerült.');
                },
                function_error: function (xhr) {
                    const response = xhr.responseJSON || {};
                    const message = response.message || 'Az ajánlatkérés elküldése nem sikerült.';
                    alertify.alert('Hiba', message);
                },
                function_complete: function () {
                    $button.prop('disabled', false);
                }
            }).send();
        });

        $('.machine-option').eq(0).trigger('click');



        $("[data-name='btnDownloadTechnicalSpec']").on('click', function () {
            let formData = new FormData();
            formData.append("name", $(this).attr("data-key"));
            new AJAX({
                url: '{{ path('download_technical_specification') }}',
                formData: formData,
                method: 'POST',
                function_success: function (response) {
                    if (response.success && response.data && response.data.code) {
                        const downloadUrl = "{{ path('download_technical_specification') }}"
                            + "?code=" + encodeURIComponent(response.data.code);
                        window.open(downloadUrl, '_blank');
                    }else{
                        alertify.alert("Hiba!","A dokumentum nem található");
                    }

                },
                function_error: function (xhr) {
                    alertify.error("Hiba");
                },
                function_complete: function () {

                }
            }).send();

        });
    });
</script>
</body>
</html>
