<h2 class="login-title mb-1">Új jelszó beállítása</h2>
<p class="login-subtitle">Add meg az új jelszavadat. Minimum 5 karakter szükséges.</p>
<div id="passwordResetAlert" class="alert d-none"></div>

<form id="passwordResetNewPasswordForm" novalidate>
    <input type="hidden" id="resetToken" name="token" value="{{ token }}">

    <div class="mb-4">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control" id="newPassword" name="password" placeholder="Új jelszó" minlength="5" required>
        </div>
    </div>

    <div class="mb-4">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
            <input type="password" class="form-control" id="newPasswordConfirm" name="password_confirm" placeholder="Új jelszó mégegyszer" minlength="5" required>
        </div>
    </div>

    <button type="submit" class="btn btn-login w-100" id="passwordResetSaveBtn">Jelszó mentése</button>
</form>

<div class="divider"></div>
<a href="#" class="forgot-link" data-auth-page="login">Vissza a bejelentkezéshez</a>
