<h2 class="login-title mb-1">Jelszó visszaállítás</h2>
<p class="login-subtitle">Add meg az e-mail címedet, és küldünk egy visszaállító linket.</p>
<div id="passwordResetAlert" class="alert d-none"></div>

<form id="passwordResetRequestForm" novalidate>
    <div class="mb-4">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control" id="resetEmail" name="email" placeholder="E-mail cím" required>
        </div>
    </div>

    <button type="submit" class="btn btn-login w-100" id="passwordResetRequestBtn">Visszaállító link küldése</button>
</form>

<div class="divider"></div>
<a href="#" class="forgot-link" data-auth-page="login">Vissza a bejelentkezéshez</a>
