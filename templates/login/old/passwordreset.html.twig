<div class="login-box">
    <h1>Új jelszó megadása</h1>

    {% if not token_is_valid %}
        <div class="error">Érvénytelen vagy lejárt visszaállító link.</div>
        <button type="button" data-load-password-recovery>Új link kérése</button>
    {% else %}
        <form id="password-reset-form">
            <div data-message hidden></div>

            <label>Új jelszó</label>
            <input type="password" name="password" autocomplete="new-password" minlength="8" required autofocus>

            <label>Új jelszó újra</label>
            <input type="password" name="password_again" autocomplete="new-password" minlength="8" required>

            <input type="hidden" name="token" value="{{ token }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset') }}">

            <button type="submit">Jelszó frissítése</button>
        </form>
    {% endif %}
</div>
