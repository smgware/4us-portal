<div class="login-box">
    <h1>Elfelejtett jelszó</h1>
    <p>Add meg az email címedet, és elküldjük a jelszó-visszaállító linket.</p>

    <form id="password-recovery-form">
        <div data-message hidden></div>

        <label>Email cím</label>
        <input type="email" name="email" autocomplete="email" required autofocus>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_recovery') }}">

        <button type="submit">Küldés</button>
        <button type="button" data-load-login>Vissza a belépéshez</button>
    </form>
</div>
