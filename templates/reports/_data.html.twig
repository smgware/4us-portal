<div class="row g-2 mt-2">

    <div class="col-xl-4 col-md-6 col-12">
        <div class="card panel-card report-kpi p-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="label">Hibabejelentések</div>
                    <div class="value mt-2">{{ report.kpi.errorReports }}</div>
                </div>
                <div class="report-icon"><i class="bi bi-tools"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 col-12">
        <div class="card panel-card report-kpi p-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="label">Érintett gépek</div>
                    <div class="value mt-2">{{ report.kpi.affectedMachines }}</div>
                </div>
                <div class="report-icon"><i class="bi bi-cpu"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 col-12">
        <div class="card panel-card report-kpi p-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="label">Átlagos átfutás</div>
                    <div class="value mt-2">{{ report.kpi.avgTurnaroundHours|number_format(1, ',', ' ') }} óra</div>
                </div>
                <div class="report-icon"><i class="bi bi-stopwatch"></i></div>
            </div>
        </div>
    </div>

