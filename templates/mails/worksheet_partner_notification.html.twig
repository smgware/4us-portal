<!doctype html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <title>Munkalap értesítés</title>
</head>
<body style="margin:0;padding:24px;background:#f5f5f5;font-family:Arial,sans-serif;color:#222;">
    <div style="max-width:640px;margin:0 auto;padding:24px;background:#fff;border:1px solid #ddd;border-radius:8px;">
        <p style="margin:0 0 16px;line-height:1.5;">
            <strong>{{ companyName }}</strong> cég nevére és <strong>{{ machineName }}</strong> gépre munkalap {{ action }}.
        </p>
        <p style="margin:0;line-height:1.5;">
            Státusz: <strong>{{ statusName }}</strong>
        </p>
    </div>
</body>
</html>
