<form action="" data-name="project">
    <input type="hidden" name="id" value="{{ item ? item.id : '' }}">

    <div class="row">
        <div class="col-12 mb-3">
            <label class="form-label" for="project-name">Név</label>
            <input
                type="text"
                class="form-control"
                id="project-name"
                name="name"
                value="{{ item ? item.name : '' }}"
                maxlength="255"
                required
            >
        </div>

        <div class="col-12 mb-3">
            <label class="form-label" for="project-description">Megjegyzés</label>
            <textarea
                class="form-control"
                id="project-description"
                name="description"
                rows="5"
            >{{ item ? item.description : '' }}</textarea>
        </div>

        <div class="col-12 mb-3">
            <label class="form-label">Státusz</label>
            <select class="form-control" name="status" data-name="status">
                <option value="1" {{ item and item.status == '1' ? 'selected' }}>Aktív</option>
                <option value="0" {{ item and item.status == '0' ? 'selected' }}>Inaktív</option>
            </select>
        </div>

    </div>
</form>
